#!/bin/bash
# Add a "time left in this session" badge to Freebuff Desktop 0.0.18x.
#
# The packaged app resolves its interface as resources/orchestrator/ui next to
# the running binary and passes that to the orchestrator unconditionally, so
# FREEBUFF_UI_DIR cannot override it and the AppImage's squashfs is read-only.
# The way in is therefore a runnable tree: the AppImage is extracted once into
# a user-owned directory, the interface inside that tree is patched, and the
# launcher runs <tree>/AppRun instead of the image.
#
# Only the extracted tree is written. The AppImage, the profile, its state.json
# and every desktop-v2.db are left alone, so nothing the app stores can be lost
# by re-running this: a changed AppImage only triggers a fresh extraction.
#
# Where the numbers come from: the page has window.freebuffDesktop.apiToken(),
# and the orchestrator proxies /api/web/freebuff-session to the account's
# session state. desktopPurchases[].expiresAt are the running sessions' expiry
# times, so "time left" is the nearest of those.
#
# Usage: freebuff-0188-session-time-ui <appimage> <tree-dir>
# Prints the AppRun path and exits 0 when <tree-dir> is ready to run.
set -u

app=${1:-}
tree=${2:-}
if [ -z "$app" ] || [ -z "$tree" ]; then
    echo "usage: $(basename "$0") <appimage> <tree-dir>" >&2
    exit 2
fi
if [ ! -x "$app" ]; then
    echo "session-time-ui: $app is not executable" >&2
    exit 1
fi

# Never move a tree that is still executing: the running app would keep deleted
# inodes, hold its single-instance lock, and silently swallow the next launch.
tree_in_use() {
    python3 - "$tree" <<'PY'
import glob, os, sys
root = os.path.realpath(sys.argv[1])
for entry in glob.glob("/proc/[0-9]*"):
    try:
        exe = os.readlink(entry + "/exe")
    except OSError:
        continue
    exe = exe.split(" (deleted)")[0]
    if exe == root or exe.startswith(root + "/"):
        raise SystemExit(0)
raise SystemExit(1)
PY
}

if [ -d "$tree" ] && tree_in_use; then
    echo "session-time-ui: $tree is in use by a running Freebuff; close it first" >&2
    printf '%s\n' "$tree/AppRun"
    exit 0
fi

stamp="$tree/.source-stamp"
current=$(stat -c '%s-%Y' "$app" 2>/dev/null || echo unknown)
if [ -f "$stamp" ] && [ "$(cat "$stamp" 2>/dev/null)" = "$current" ] && [ -x "$tree/AppRun" ]; then
    printf '%s\n' "$tree/AppRun"
    exit 0
fi

mkdir -p "$(dirname "$tree")" || exit 1
staging="$tree.new.$$"
rm -rf "$staging"
mkdir -p "$staging" || exit 1

# Extract the whole image: the binary, resources/app.asar, the bundled bun and
# the Electron libs all have to sit where the app expects them.
if ! ( cd "$staging" && "$app" --appimage-extract >/dev/null 2>&1 ); then
    echo "session-time-ui: could not extract $app" >&2
    rm -rf "$staging"
    exit 1
fi
if [ ! -d "$staging/squashfs-root/resources/orchestrator/ui" ]; then
    echo "session-time-ui: the extracted image has no interface to patch" >&2
    rm -rf "$staging"
    exit 1
fi

mv "$staging/squashfs-root" "$tree.stage.$$" || { rm -rf "$staging"; exit 1; }
rmdir "$staging" 2>/dev/null
payload="$tree.stage.$$"
ui="$payload/resources/orchestrator/ui"

cat >"$ui/session-time.js" <<'JS'
// Session countdown for the Freebuff Desktop interface.
//
// Reads /session-time.json, written next to this file by
// freebuff-0188-session-time-refresh, and renders the nearest session expiry.
// Everything here is presentation: no request mutates anything.
(() => {
  const POLL_MS = 15000;
  const RETRY_MS = 8000;
  let expiresAt = 0;
  let live = [];
  let timer = null;
  let poll = null;
  let baseTitle = "";
  // "loading" until the first answer, so a broken fetch is never mistaken for
  // "no session".
  let phase = "loading";
  let lastError = "";

  // The window title is the one surface that is visible even when the notice
  // pill is covered by other UI, and it doubles as proof the counter is live.
  function setTitle(text) {
    // At first paint the document can still have no title, and "· 42:13 left"
    // with nothing in front of it reads as a bug.
    if (!baseTitle) baseTitle = document.title || "Freebuff";
    if (document.title !== text) document.title = text;
  }

  const pad = (n) => String(n).padStart(2, "0");
  function clock(ms) {
    const total = Math.max(0, Math.floor(ms / 1000));
    const h = Math.floor(total / 3600);
    const m = Math.floor((total % 3600) / 60);
    const s = total % 60;
    return h > 0 ? `${h}:${pad(m)}:${pad(s)}` : `${m}:${pad(s)}`;
  }

  function badge() {
    let el = document.getElementById("session-time-badge");
    if (el) return el;
    el = document.createElement("div");
    el.id = "session-time-badge";
    el.setAttribute("role", "status");
    el.style.cssText = [
      "position:fixed",
      "bottom:10px",
      "left:14px",
      "z-index:2147483000",
      "padding:3px 9px",
      "border-radius:999px",
      "font:500 11.5px/1.5 ui-monospace,SFMono-Regular,Menlo,monospace",
      "letter-spacing:.02em",
      "color:#dedfdd",
      "background:rgba(34,36,35,.86)",
      "border:1px solid #2f322f",
      "box-shadow:0 1px 4px rgba(0,0,0,.35)",
      "pointer-events:none",
      "user-select:none",
      "display:none",
      "white-space:nowrap",
    ].join(";");
    document.body.appendChild(el);
    return el;
  }

  function render() {
    const el = badge();
    el.style.display = "block";
    if (!expiresAt || expiresAt <= Date.now()) {
      // Always visible: an absent badge is indistinguishable from a broken one.
      el.style.opacity = "0.55";
      const text =
        phase === "ok"
          ? "no active session"
          : phase === "error"
            ? `session time unavailable${lastError ? ` (${lastError})` : ""}`
            : "checking session…";
      el.textContent = text;
      el.title =
        phase === "ok"
          ? "Freebuff: no session is running, so no time to count down"
          : phase === "error"
            ? "Freebuff: the session endpoint did not answer"
            : "Freebuff: asking for the session state";
      setTitle(`${baseTitle} · ${phase === "ok" ? "no session" : text}`);
      return;
    }
    el.style.opacity = "0.92";
    const label = live.length > 1 ? `${live.length} sessions · ` : "session ";
    const remaining = clock(expiresAt - Date.now());
    el.textContent = `${label}${remaining} left`;
    setTitle(`${baseTitle} · ${remaining} left`);
    el.title = [
      `Time left in the running Freebuff session${live.length > 1 ? "s" : ""}`,
      ...live.map((p) => `${p.model} until ${new Date(p.expiresAt).toLocaleTimeString()}`),
    ].join("\n");
  }

  function apply(payload) {
    const data = payload && typeof payload === "object" ? payload : {};
    const now = Date.now();
    live = (Array.isArray(data.sessions) ? data.sessions : [])
      .filter((p) => p && Date.parse(p.expiresAt) > now)
      .sort((a, b) => Date.parse(a.expiresAt) - Date.parse(b.expiresAt));
    const next = Date.parse(data.expiresAt || "");
    // The session that ends soonest is the one worth warning about.
    expiresAt = live.length
      ? Date.parse(live[0].expiresAt)
      : Number.isFinite(next) && next > now
        ? next
        : 0;
    render();
  }

  // The page cannot ask the account itself: the app's proxy drops the header
  // that makes the server list the running hours. A small companion process
  // makes that call and leaves the answer in /session-time.json, which is
  // same-origin and therefore readable here.
  async function refresh() {
    clearTimeout(poll);
    try {
      const res = await fetch(`/session-time.json?t=${Date.now()}`, { cache: "no-store" });
      if (!res.ok) throw new Error(String(res.status));
      const payload = await res.json();
      if (payload && payload.ok === false) throw new Error(payload.error || "unavailable");
      apply(payload);
      phase = "ok";
      lastError = "";
      poll = setTimeout(refresh, POLL_MS);
    } catch (error) {
      phase = "error";
      lastError = String(error?.message ?? error).slice(0, 44);
      poll = setTimeout(refresh, RETRY_MS);
    }
    render();
  }

  function start() {
    if (!document.body) {
      document.addEventListener("DOMContentLoaded", start, { once: true });
      return;
    }
    if (timer) return;
    console.info("[session-time] counter installed");
    timer = setInterval(render, 1000);
    render();
    document.addEventListener("visibilitychange", () => {
      if (!document.hidden) refresh();
    });
    refresh();
  }

  start();
})();
JS

# One override script line, after the app's own module entry so nothing waits on
# it. Idempotent: a second run must not add a second copy.
python3 - "$ui/index.html" <<'PY' || { echo "session-time-ui: could not patch index.html" >&2; rm -rf "$payload"; exit 1; }
import sys

path = sys.argv[1]
tag = '<script src="/session-time.js" defer></script>'
html = open(path, encoding="utf8").read()
if tag in html:
    sys.exit(0)
anchor = '<script type="module" crossorigin src="/assets/'
index = html.find(anchor)
if index == -1:
    close = html.find("</head>")
    if close == -1:
        raise SystemExit("no </head> to inject into")
    html = html[:close] + tag + "\n" + html[close:]
else:
    end = html.find("</script>", index)
    if end == -1:
        raise SystemExit("unterminated module script")
    end += len("</script>")
    html = html[:end] + "\n    " + tag + html[end:]
open(path, "w", encoding="utf8").write(html)
PY

# Swap the finished tree in, keeping the old one until the move succeeded.
old="$tree.old.$$"
if [ -e "$tree" ]; then
    mv "$tree" "$old" || { rm -rf "$payload"; echo "session-time-ui: could not move $tree aside" >&2; exit 1; }
fi
if ! mv "$payload" "$tree"; then
    [ -e "$old" ] && mv "$old" "$tree"
    echo "session-time-ui: could not install $tree" >&2
    exit 1
fi
rm -rf "$old"
printf '%s\n' "$current" >"$stamp"
printf '%s\n' "$tree/AppRun"
exit 0
