#!/usr/bin/env python3
"""Groq transcription behind whisper.cpp's own HTTP API.

WHY THIS EXISTS: everything on this desktop that dictates -- the SUPER-hold
daemon in custom/scripts/dictate.sh and the WhisperFlow app -- talks to one
thing: a whisper.cpp server on a loopback port, speaking whisper.cpp's small
API (`POST /inference`, multipart, a JSON reply with `text`). Nothing above that
API knows or cares where the words come from.

So cloud transcription is one hop away. This process answers the same API on its
own port (8918) and forwards the audio to Groq's OpenAI-compatible transcription
endpoint with whisper-large-v3-turbo -- the same model family the local engine
runs, on someone else's GPU -- then replies in whisper.cpp's shape so both
clients keep working untouched.

THE LOCAL ENGINE STAYS AS THE SAFETY NET. It keeps running on its own port
(8917). If the key is missing, the free tier is spent for the hour/day, the
network is down or Groq answers anything but 2xx, the SAME request is replayed
against the local server and its answer is returned. Dictation never stops
because a quota ran out; it gets slower and private again, which is the right
failure mode for typing by voice.

FREE TIER, as documented by Groq on 2026-11-17 (console.groq.com/docs/rate-limits,
and docs/speech-to-text): whisper-large-v3-turbo, 20 requests/min, 2,000/day,
7,200 audio seconds/hour, 28,800 audio seconds/day (8 hours), no credit card.
Two consequences worth knowing: the minimum billed length is 10 s per request,
so live chunked dictation spends quota per chunk rather than per word; and
`$0.04` per audio hour is the paid price if the free tier ever becomes tight.

Stdlib only, on purpose: this runs from a systemd user unit under the system
python, with no venv and no install step.

Environment
  GROQ_API_KEY            required for the cloud path; without it every
                          request takes the fallback
  GROQ_WHISPER_MODEL      default whisper-large-v3-turbo
  GROQ_API_BASE           default https://api.groq.com/openai/v1
  BRIDGE_HOST/BRIDGE_PORT default 127.0.0.1:8918
  FALLBACK_URL            default http://127.0.0.1:8917 (whisper.cpp)
"""

import json
import os
import sys
import uuid
from email import message_from_bytes
from email.policy import default as email_policy
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from urllib.error import HTTPError, URLError
from urllib.request import Request, urlopen

HOST = os.environ.get("BRIDGE_HOST", "127.0.0.1")
PORT = int(os.environ.get("BRIDGE_PORT", "8918"))
GROQ_BASE = os.environ.get("GROQ_API_BASE", "https://api.groq.com/openai/v1").rstrip("/")
GROQ_MODEL = os.environ.get("GROQ_WHISPER_MODEL", "whisper-large-v3-turbo")
FALLBACK = os.environ.get("FALLBACK_URL", "http://127.0.0.1:8917").rstrip("/")

UPSTREAM_TIMEOUT = 60.0
FALLBACK_TIMEOUT = 300.0

# Groq answers verbose_json's `language` either as a code or as a name,
# whisper.cpp answers `detected_language` as a NAME. dictate.sh maps names to the
# two-letter tag the bar shows, so names are what this hands back.
LANG_NAMES = {
    "en": "english", "de": "german", "fr": "french", "es": "spanish",
    "it": "italian", "pt": "portuguese", "nl": "dutch", "pl": "polish",
    "ru": "russian", "uk": "ukrainian", "tr": "turkish", "sv": "swedish",
    "da": "danish", "no": "norwegian", "fi": "finnish", "cs": "czech",
    "el": "greek", "hu": "hungarian", "ro": "romanian", "bg": "bulgarian",
    "hr": "croatian", "sk": "slovak", "sl": "slovenian", "et": "estonian",
    "lv": "latvian", "lt": "lithuanian", "ar": "arabic", "he": "hebrew",
    "hi": "hindi", "ta": "tamil", "te": "telugu", "th": "thai",
    "vi": "vietnamese", "id": "indonesian", "ms": "malay", "ja": "japanese",
    "ko": "korean", "zh": "chinese", "fa": "persian", "ur": "urdu",
}


def api_key():
    return (os.environ.get("GROQ_API_KEY") or "").strip()


def log(message):
    """One line on the journal; never a key, never audio."""
    print("groq-whisper-bridge: " + message, flush=True)


def parse_multipart(content_type, body):
    """(fields, (filename, content_type, bytes)) out of a form-data body."""
    raw = (b"Content-Type: " + content_type.encode("latin-1")
           + b"\r\nMIME-Version: 1.0\r\n\r\n" + body)
    message = message_from_bytes(raw, policy=email_policy)
    if not message.is_multipart():
        raise ValueError("not multipart/form-data")
    fields = {}
    audio = None
    for part in message.iter_parts():
        name = part.get_param("name", header="content-disposition")
        payload = part.get_payload(decode=True) or b""
        if name == "file":
            filename = part.get_filename() or "audio.wav"
            audio = (filename, part.get_content_type() or "audio/wav", payload)
        elif name:
            fields[name] = payload.decode("utf-8", "replace")
    if audio is None or not audio[2]:
        raise ValueError("no file field in the request")
    return fields, audio


def language_name(value):
    value = (value or "").strip().lower()
    if not value:
        return ""
    return LANG_NAMES.get(value, value)


def build_multipart(fields, audio):
    """The form Groq wants: model + the whisper.cpp knobs it also understands."""
    boundary = "----groqbridge" + uuid.uuid4().hex
    body = bytearray()

    def add_field(name, value):
        body.extend(("--%s\r\nContent-Disposition: form-data; name=\"%s\"\r\n\r\n%s\r\n"
                     % (boundary, name, value)).encode("utf-8"))

    add_field("model", GROQ_MODEL)
    add_field("response_format", "verbose_json")
    language = (fields.get("language") or "").strip().lower()
    if language and language != "auto":
        add_field("language", language)
    prompt = (fields.get("prompt") or "").strip()
    if prompt:
        add_field("prompt", prompt)
    try:
        temperature = float(fields.get("temperature", ""))
        if 0.0 <= temperature <= 1.0:
            add_field("temperature", str(temperature))
    except (TypeError, ValueError):
        pass

    filename, content_type, payload = audio
    body.extend(("--%s\r\nContent-Disposition: form-data; name=\"file\"; filename=\"%s\"\r\n"
                 "Content-Type: %s\r\n\r\n" % (boundary, filename, content_type)).encode("utf-8"))
    body.extend(payload)
    body.extend(b"\r\n")
    body.extend(("--%s--\r\n" % boundary).encode("utf-8"))
    return boundary, bytes(body)


def call_groq(fields, audio):
    """Groq's verbose_json, or an exception the caller turns into a fallback."""
    boundary, body = build_multipart(fields, audio)
    request = Request(
        GROQ_BASE + "/audio/transcriptions",
        data=body,
        headers={
            "Authorization": "Bearer " + api_key(),
            "Content-Type": "multipart/form-data; boundary=" + boundary,
            "Accept": "application/json",
        },
        method="POST",
    )
    with urlopen(request, timeout=UPSTREAM_TIMEOUT) as response:
        return json.loads(response.read().decode("utf-8", "replace"))


def reply_payload(result, wanted):
    """whisper.cpp's reply shape, from Groq's answer."""
    text = (result.get("text") or "").strip()
    language = language_name(result.get("language"))
    if wanted == "verbose_json":
        payload = {
            "text": text,
            "task": "transcribe",
            "detected_language": language,
            "language": language,
            "segments": result.get("segments") or [],
        }
        if isinstance(result.get("duration"), (int, float)):
            payload["duration"] = result["duration"]
        return payload
    payload = {"text": text}
    if language:
        payload["detected_language"] = language
    return payload


class Handler(BaseHTTPRequestHandler):
    server_version = "groq-whisper-bridge/1.0"
    protocol_version = "HTTP/1.1"

    def log_message(self, fmt, *args):  # keep the journal to our own lines
        pass

    # ── what both clients probe before they trust a server ───────────────
    def do_GET(self):
        if self.path in ("/health", "/"):
            body = json.dumps({"status": "ok", "cloud": bool(api_key()),
                               "model": GROQ_MODEL}).encode()
            self.send_response(200)
            self.send_header("Content-Type", "application/json")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)
            return
        self.send_error(404)

    # ── the one endpoint that matters ───────────────────────────────────
    def do_POST(self):
        if not self.path.split("?")[0].endswith("/inference"):
            self.send_error(404)
            return
        length = int(self.headers.get("Content-Length") or 0)
        body = self.rfile.read(length) if length else b""
        content_type = self.headers.get("Content-Type") or ""

        wanted = "json"
        fields, audio = {}, None
        try:
            fields, audio = parse_multipart(content_type, body)
            wanted = (fields.get("response_format") or "json").strip().lower()
        except Exception as error:
            log("could not read the request (%s); replaying it locally" % error)
            return self.replay_locally(content_type, body)

        if not api_key():
            return self.replay_locally(content_type, body, why="no GROQ_API_KEY set")

        try:
            result = call_groq(fields, audio)
        except HTTPError as error:
            detail = ""
            try:
                detail = error.read().decode("utf-8", "replace")[:200]
            except Exception:
                pass
            return self.replay_locally(
                content_type, body,
                why="Groq said %s %s" % (error.code, detail.strip()))
        except (URLError, TimeoutError, ValueError) as error:
            return self.replay_locally(content_type, body, why="Groq unreachable (%s)" % error)

        text = (result.get("text") or "").strip()
        log("cloud: %.1f kB of audio -> %d chars" % (len(audio[2]) / 1024.0, len(text)))
        if wanted == "text":
            payload = text.encode("utf-8")
            self.send_response(200)
            self.send_header("Content-Type", "text/plain; charset=utf-8")
            self.send_header("Content-Length", str(len(payload)))
            self.end_headers()
            self.wfile.write(payload)
            return
        payload = json.dumps(reply_payload(result, wanted)).encode("utf-8")
        self.send_response(200)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(payload)))
        self.end_headers()
        self.wfile.write(payload)

    # ── the safety net: the same request, the local engine ──────────────
    def replay_locally(self, content_type, body, why=""):
        if why:
            log(why + " -- using the local engine for this one")
        request = Request(
            FALLBACK + self.path,
            data=body,
            headers={"Content-Type": content_type},
            method="POST",
        )
        try:
            with urlopen(request, timeout=FALLBACK_TIMEOUT) as response:
                payload = response.read()
                status = response.status
                reply_type = response.headers.get("Content-Type", "application/json")
        except HTTPError as error:
            payload = error.read() or b""
            status = error.code
            reply_type = error.headers.get("Content-Type", "application/json") if error.headers else "application/json"
        except (URLError, TimeoutError, OSError) as error:
            log("the local engine is not answering either (%s)" % error)
            payload = json.dumps({"error": "no transcription engine available"}).encode()
            status = 503
            reply_type = "application/json"
        self.send_response(status)
        self.send_header("Content-Type", reply_type or "application/json")
        self.send_header("Content-Length", str(len(payload)))
        self.end_headers()
        self.wfile.write(payload)


def main():
    if not api_key():
        log("no GROQ_API_KEY in the environment: every request will be served by "
            "the local engine on " + FALLBACK)
    else:
        log("cloud transcription via " + GROQ_MODEL + " at " + GROQ_BASE
            + ", local engine on " + FALLBACK + " as the fallback")
    server = ThreadingHTTPServer((HOST, PORT), Handler)
    server.daemon_threads = True
    log("listening on http://%s:%d" % (HOST, PORT))
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        pass
    finally:
        server.server_close()


if __name__ == "__main__":
    sys.exit(main())
