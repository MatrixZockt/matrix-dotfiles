# Keeps a heavy render (or an agent driving one) from taking the whole machine
# down with it: watches free memory and closes the process that is growing fastest
# (not merely the largest), keeping the editor, Claude and the browser behind
# everything else, before the kernel would freeze instead.
#
# The story behind it is in the script's header: on 2026-11-18 an agent rendered
# a Blender scene with Cycles set to CPU, and with zram as the only swap the
# machine thrashed to a hard stop. The budget half of the fix is heavy.slice
# (docs/FEATURES.md); this unit is the backstop for anything started outside it.
#
# It is also the reason the OOM protection had to be arranged the way it was:
# systemd-oomd is masked system-wide (it killed two whole sessions on 2026-11-12),
# so the kernel's OOM killer is the only other thing left, and it fires only after
# reclaim has already frozen the desktop. Hence one process at
# a time, chosen here, with a notification.
#
# 2026-11-19: swap is no longer zram alone. /swapfile (32 GiB, priority 10, in
# /etc/fstab) sits behind zram, so a full zram spills to disk instead of freezing.
[Unit]
# 2026-11-19: "never close anything on its own". The guard is an OBSERVER now:
# it still samples memory and logs what it would close, but DRY_RUN=1 below
# makes killing impossible. It had closed an IDE/Gradle JVM four times in five
# minutes during a normal build. Closing requires editing this unit to
# Environment=DRY_RUN=0 and re-enabling it.
Description=Memory guard (reports memory pressure; never closes anything)
After=default.target
PartOf=default.target
# A guard that is down is a machine that can freeze unattended, so come back
# from anything: a crash, an OOM sweep, or someone stopping it by mistake.
StartLimitIntervalSec=0

[Service]
Type=simple
# Kills are opt-in, and this unit does not opt in.
Environment=DRY_RUN=1
ExecStart=/usr/bin/python3 %h/.local/bin/memory-guard
Restart=always
RestartSec=3
# Low priority on purpose: it must keep being scheduled while everything else
# is thrashing, and it must never be the thing competing for memory.
Nice=-5
IOSchedulingClass=best-effort
IOSchedulingPriority=2
StandardOutput=journal
StandardError=journal
SyslogIdentifier=memory-guard

[Install]
WantedBy=default.target
