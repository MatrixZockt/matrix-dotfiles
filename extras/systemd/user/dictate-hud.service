[Unit]
Description=WhisperFlow's own recording pill for the SUPER-hold dictation - feeds the app's bottom-of-screen HUD from the dictation daemon's meter, so the same pill shows for every recording and the bar keeps no display of its own
# Same anchor as the other helpers here: there is no graphical-session.target
# on this setup, so default.target is the one that actually starts. The watcher
# is free while nothing is being dictated (one small read every 50 ms) and it
# starts the pill itself, so starting it early costs nothing.
After=default.target

[Service]
Type=simple
ExecStart=%h/.local/bin/dictate-hud
Restart=on-failure
RestartSec=5
Environment=PYTHONUNBUFFERED=1
# Every pill that appeared (or did not) is answerable afterwards, the same way
# the other helpers do it: the app's own log for the pill's side lives beside
# it in $XDG_RUNTIME_DIR/ii-dictate/hud.log.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=dictate-hud

[Install]
WantedBy=default.target
