#!/bin/bash
# Rebuild the 0.0.188 profile from the CURRENT profile, so work done in the
# running build shows up in 0.0.188 too.
#
# Runs while the current build is open: each store is copied with
# `sqlite3 .backup`, which takes a consistent snapshot of a live WAL database
# instead of copying a torn file. Nothing in the source profile is modified.
#
# 0.0.188 must be closed while this runs — it opens these same files — and it
# will show the refreshed history on its next start.
#
# It also has to undo two things the current build writes that 0.0.188 cannot
# act on, or the migrated chats stop opening (both measured 2026-11-22):
#
#   * absolute paths inside state.json for the no-folder project, which would
#     otherwise point the copy back at the live profile;
#   * the cloud flags — every thread is recorded with
#     execution_target='cloud' (a hosted workspace) and projects carry
#     deviceCloud/accountId. 0.0.188 predates hosted workspaces, so opening
#     such a chat fails with "cloud workspace not found" even though the
#     transcript is right there in the local database. Setting them back to
#     local is what makes the migrated chats open.
set -eu

SRC="${FREEBUFF_SRC_PROFILE:-$HOME/.config/freebuff-desktop}"
DST="${FREEBUFF_0188_PROFILE:-$HOME/.config/freebuff-desktop-0.0.188}"

if pgrep -f "Freebuff-0.0.188-linux-x86_64.AppImage" >/dev/null 2>&1; then
    echo "refresh: close Freebuff 0.0.188 first (it holds $DST open)" >&2
    exit 1
fi

mkdir -p "$DST/projects"
cp -a "$SRC/state.json" "$DST/state.json"
[ -f "$SRC/state.json.device-key.json" ] && cp -a "$SRC/state.json.device-key.json" "$DST/"
[ -d "$SRC/account-skills" ] && cp -a "$SRC/account-skills" "$DST/"
[ -d "$SRC/no-folder" ] && cp -a "$SRC/no-folder" "$DST/"

for d in "$SRC"/projects/*/; do
    name=$(basename "$d")
    mkdir -p "$DST/projects/$name"
    [ -f "$d/project.json" ] && cp -a "$d/project.json" "$DST/projects/$name/"
    sqlite3 "$d/desktop-v2.db" ".backup '$DST/projects/$name/desktop-v2.db'"
done

python3 - "$DST" <<'EOF'
import json, pathlib, sqlite3, sys

dst = pathlib.Path(sys.argv[1])

# 1. Point the copy at itself.
state_path = dst / "state.json"
state_path.write_text(
    state_path.read_text().replace(
        "/.config/freebuff-desktop/", "/.config/freebuff-desktop-0.0.188/"
    )
)

# 2. Drop the cloud flags from every project entry.
state = json.loads(state_path.read_text())
for entry in state["projects"].values():
    for key in ("deviceCloud", "accountId", "apiHost", "cloudProjectId"):
        entry.pop(key, None)
    entry["location"] = "local"
    for source in entry.get("sources") or []:
        for key in ("deviceCloud", "accountId", "apiHost", "cloudProjectId"):
            source.pop(key, None)
state_path.write_text(json.dumps(state, indent=2))

# 3. Drop the cloud flags from every thread.
wanted = {
    "execution_target": "execution_target='local'",
    "next_execution_target": "next_execution_target='local'",
    "cloud_account_id": "cloud_account_id=null",
    "cloud_api_host": "cloud_api_host=null",
    "cloud_handoff_pending": "cloud_handoff_pending=0",
    "cloud_continuation_queued": "cloud_continuation_queued=0",
    "cloud_handback_at": "cloud_handback_at=null",
    "local_handoff_pending": "local_handoff_pending=0",
}
threads = messages = 0
for db in sorted(dst.glob("projects/*/desktop-v2.db")):
    con = sqlite3.connect(db)
    have = {row[1] for row in con.execute("pragma table_info(threads)")}
    stmts = [sql for col, sql in wanted.items() if col in have]
    if stmts:
        con.execute("update threads set " + ", ".join(stmts))
    threads += con.execute("select count(*) from threads").fetchone()[0]
    messages += con.execute("select count(*) from messages").fetchone()[0]
    con.commit()
    con.close()

print(f"refresh: {dst} now has {threads} threads / {messages} messages")
EOF
