# Machine-specific files that hypr tooling regenerates
workspaces.lua
monitors.lua
*.bak[0-9]*

# Editor / OS noise
*.bak
*~
*.swp
*.swo
.DS_Store
Thumbs.db

# Logs and runtime state
*.log
.cache/

# Local archives of removed scripts (incl. a 55 MB generated cursor theme).
# Kept on disk as a rollback, never part of the configuration being synced.
.config/hypr/custom/scripts/removed-*/

# Shell installer bookkeeping (machine-specific, regenerated by end-4's setup)
.config/illogical-impulse/installed_listfile
.config/illogical-impulse/installed_true

# Python bytecode inside the shell config
__pycache__/
*.pyc

# Local secrets (never commit)
.env
.env.local
*.bak-*

# Freebuff project state (machine-local)
.freebuff/

# ── Machine-specific / shell-regenerated (do not publish) ──────────────────
# The shell's live config: rewritten by the shell at runtime, carries absolute
# local paths (wallpaper, apps) and backup snapshots. Regenerated with defaults
# on first run for anyone cloning this repo.
.config/illogical-impulse/config.json
.config/illogical-impulse/config.json.bak*
# The lock screen's wallpaper OVERRIDE: written by set-lock-wallpaper.sh when a
# picture is picked for the lock screen, so it names a file only this machine
# has. Regenerated on demand; the generated pair below follows the desktop.
.config/hypr/hyprlock/lock-wallpaper.conf
# Lock screen pair is generated from the desktop wallpaper/palette:
# scripts/lock/generate-hyprlock-conf.sh rewrites it, so the copy here is
# always machine-local.
.config/hypr/hyprlock.conf
.config/hypr/hyprlock/colors.conf
# Archived lock-screen experiment (dead code, contains old absolute paths).
.config/hypr/.archive-lock/
# Personal launcher: Exec points at this user's local AppImage path.
extras/applications/freebuff.desktop
# Shell design screenshots: real captures of this desktop, local paths visible.
.config/quickshell/ii/design/.shots/
# Agent session scratch (design previews, reference screenshots).
.freebuff-tmp/
.thread-preview/
# Two stray artifacts on disk, neither of them configuration: `file:/` is a
# directory a path bug created under the shell config (a file:// URL used as a
# path, 2026-10-09) and `x + ` is an empty file left by a mistyped shell
# redirect (2026-10-07). Listed here rather than deleted, so nothing in this
# repository silently removes something from the disk.
.config/quickshell/ii/file:/
# (the trailing space is escaped: git strips unescaped trailing spaces)
/x +\ 
# Device insert/remove sounds: cut on this machine from a recording the user
# supplied (scripts/system/import-device-sound.py). The recording is not in
# this repository and is not free to redistribute, so neither is what is cut
# from it -- and these two are generated per machine anyway, never checked in.
# make-device-sounds.py still holds the synthesised fallback recipe.
.config/quickshell/ii/assets/sounds/device-insert.wav
.config/quickshell/ii/assets/sounds/device-remove.wav

# Editor and backup leftovers: never part of the config, and a stray *.bak next to a
# live file is how an old version of it ends up published by accident.
*.bak
*.bak[0-9]*
*.bak-*
*.orig
*.rej
*.swp
*~
__pycache__/
.DS_Store
