#!/usr/bin/env python3
# Razer Command Center — one desktop app for this Razer Blade 16 (2024).
#
# Pages (Adw.ViewStack, Grafizum palette: #101013 base, #1a1a1f cards,
# #3fb950 green, #3f8cfe primary blue):
#   Lighting    daemon control, brightness, iCUE-style PER-KEY editor:
#               a clickable Blade-16 key replica, brush/eraser/fill tools,
#               multiple named color profiles (created / duplicated /
#               deleted / applied), auto-apply at login; hardware quick
#               effects below that
#   Display     screen brightness, long-idle tier
#   Power       profile cards, battery gauge, autostart
#   GPU         power gauge + status pills, NVIDIA RTD3 (apply = live AND
#               persisted in one action), decode offload
#   Diagnostics hotkey capture test, services
#
# PERSISTENCE: long-idle → config.json; autostart → XDG autostart;
# lighting profiles → ~/.config/razer-command-center/lighting.json with a
# headless re-apply at login (custom frames are volatile across boots);
# GPU idle → modprobe conf + live apply; RGB hardware effects → the MCU.
#
# NO GUI-THREAD BLOCKING: slow commands run on worker threads.
#
# Headless:
#   razer-command-center --toggle performance|balanced|power-saver
#   razer-command-center --apply-lighting        (re-applies active profile)

import glob
import json
import math
import os
import select
import signal
import struct
import subprocess
import sys
import threading
import time

import gi

gi.require_version("Gtk", "4.0")
gi.require_version("Adw", "1")
# For Pango.EllipsizeMode only: a label that ellipsizes can shrink below the
# width of its own text, which is what lets a long status line live in a row
# that has to be able to get narrow.
gi.require_version("Pango", "1.0")
# Render with Cairo, not the GL/NGl renderer: a GTK GL context grabs the
# NVIDIA card (fds on /dev/nvidia0) and keeps the dGPU awake forever —
# the control app was preventing the very sleep it polices. This is a
# text utility; the Cairo renderer costs nothing here.
os.environ.setdefault("GSK_RENDERER", "cairo")
from gi.repository import (Adw, Gdk, Gio, GLib, GObject,  # noqa: E402
                           Graphene, Gtk, Pango)
import cairo  # noqa: E402

# ── constants ────────────────────────────────────────────────────────────────

HOME = os.path.expanduser("~")
II_CONFIG = os.path.join(HOME, ".config/illogical-impulse/config.json")

# Appearance setting, persisted in the same II config the app already owns
# (keys read and written by other features there), so this adds no new file.
# Values: "system" | "light" | "dark".
THEME_KEY = "razer_cc_theme"
THEME_CHOICES = ("system", "light", "dark")
# Which light sheet, when the theme resolves light. Values are keys of
# THEME_TOKENS; default is the pure white one.
SHADE_KEY = "razer_cc_theme_shade"
SHADE_CHOICES = ("light", "light_warm", "light_cool")
SHADE_LABELS = (("light", "Pure White"),
                ("light_warm", "Warm"),
                ("light_cool", "Cool"))


def read_theme():
    """The saved appearance, defaulting to system."""
    v = read_ii().get(THEME_KEY, "system")
    return v if v in THEME_CHOICES else "system"


def write_theme(v):
    """Persist the appearance choice; returns True on success."""
    if v not in THEME_CHOICES:
        return False
    cfg = read_ii()
    cfg[THEME_KEY] = v
    return write_ii(cfg)


def read_theme_shade():
    """The saved light shade, defaulting to the pure white sheet."""
    v = read_ii().get(SHADE_KEY, "light")
    return v if v in SHADE_CHOICES else "light"


def write_theme_shade(v):
    if v not in SHADE_CHOICES:
        return False
    cfg = read_ii()
    cfg[SHADE_KEY] = v
    return write_ii(cfg)


def apply_theme(v):
    """Apply an appearance choice to the whole app, not just libadwaita.

    Two layers used to disagree: libadwaita restyles its own widgets, but
    every colour in the app's custom CSS was a literal, and the keyboard
    board and gauges painted their own dark palette in cairo -- so LIGHT
    changed label colours while the window stayed black. Both layers now
    consume the same token sheet: this function resolves the tokens for the
    choice, loads them as a Gtk CSS provider (priority above libadwaita's
    defaults, below the app's layout CSS, which references the tokens), and
    hands the same values to the cairo draw code.
    """
    sm = Adw.StyleManager.get_default()
    if v == "light":
        sm.set_color_scheme(Adw.ColorScheme.FORCE_LIGHT)
    elif v == "dark":
        sm.set_color_scheme(Adw.ColorScheme.FORCE_DARK)
    else:
        sm.set_color_scheme(Adw.ColorScheme.DEFAULT)

    dark = (v == "dark") or (v == "system" and _system_prefers_dark())
    if dark:
        sheet = "dark"
    else:
        # The chosen white shade is what LIGHT (and system-on-a-light-day)
        # actually shows. Unknown shade falls back to the pure sheet.
        sheet = read_theme_shade()
        if sheet not in THEME_TOKENS:
            sheet = "light"
    tokens = THEME_TOKENS[sheet]
    CURRENT_SHEET.clear()
    CURRENT_SHEET.update(tokens)
    apply_token_css(tokens)
    sync_cairo_theme(tokens)
    _follow_system_dark(v)


# The "system" choice has to be LIVE. libadwaita follows the desktop's
# colour-scheme setting by itself, so the moment the desktop flips to light
# every libadwaita-owned widget (popovers, menus, tooltips, entry text)
# restyles to dark-on-white -- while the app's own token sheet, computed
# once when the window was built, is still the dark one. That mismatch is
# what "black text on a dark background" was: a light-scheme widget drawn
# over the dark sheet's window, or the reverse. Re-applying the tokens on
# notify::dark keeps the two layers agreeing in both directions.
_system_dark_watch = {"id": None, "choice": None}


def _follow_system_dark(choice):
    """(Re)arm the notify::dark watcher for the "system" choice."""
    sm = Adw.StyleManager.get_default()
    if _system_dark_watch["id"] is not None:
        sm.disconnect(_system_dark_watch["id"])
        _system_dark_watch["id"] = None
    _system_dark_watch["choice"] = choice
    if choice != "system":
        return

    def on_dark(*_args):
        # Re-entrancy guard: apply_token_css -> CSS invalidation can notify
        # again, and a second pass would rebuild the provider mid-read.
        if _system_dark_watch["choice"] != "system":
            return
        apply_theme("system")

    _system_dark_watch["id"] = sm.connect("notify::dark", on_dark)


def _system_prefers_dark():
    """The desktop's own preference, for the 'system' choice."""
    try:
        s = Adw.StyleManager.get_default()
        # libadwaita resolves the portal setting once a scheme is DEFAULT;
        # ask it directly rather than re-reading the portal.
        if s.get_system_supports_color_schemes():
            return bool(s.get_dark())
    except Exception:
        pass
    # Fallback: the GTK settings file most sessions actually use.
    try:
        import configparser
        cp = configparser.ConfigParser()
        cp.read(os.path.expanduser("~/.config/gtk-4.0/settings.ini"))
        return cp.get("Settings", "gtk-application-prefer-dark-theme",
                      fallback="0").strip() in ("1", "true")
    except Exception:
        return False


# ── theme tokens ─────────────────────────────────────────────────────────────
# Every colour the app uses, named. The dark sheet reproduces the previous
# literal palette; the light sheets are the same layout in white shades.
# apply_theme() loads the chosen sheet and cairo reads the same values, so
# CSS and hand-drawn widgets can never disagree again.
#
# Three white shades are offered for LIGHT; "light" uses the pure one and
# the picker can switch the sheet. All three keep the same token names.
#
# Legend (light): window = page, chrome = rail/headerbar, card = tiles.
