#!/usr/bin/env bash
# ppd-nvidia-boost -- tie NVIDIA Dynamic Boost (nvidia-powerd) to the PPD profile.
#
#   power-saver            -> Dynamic Boost OFF  (enforced GPU limit 55 W)
#   balanced / performance -> Dynamic Boost ON   (55 W -> up to 140 W, dynamic)
#
# Why not nvidia-smi -pl: on this laptop the driver refuses it. Measured
# 2026-10-12 as root, with the card parked AND with the card in P0 under load,
# with Dynamic Boost running and with it stopped: every value is answered with
# "Changing power management limit is not supported for GPU" (or "... in
# current scope") and the enforced limit never moves off 55 W. Dynamic Boost is
# the only lever there is, so it is the one this script pulls.
#
# What the two states actually are, measured on the same machine:
#
#   boost off: enforced 55 W, and the card draws 54.9 W under a CUDA load.
#   boost on : enforced reads 115 W while the card is idle and 140 W -- the
#              vBIOS ceiling, and the number nvidia-smi calls power.max_limit
#              -- under a real load, where it drew 139.9 W at 2070 MHz.
#
# So 115 W is not a cap the daemon imposes on the way to 140: it is what the
# same dynamic ceiling reads when nothing is asking for the watts. A mode that
# wants more than 115 W gets it by putting load on the card, not by a number
# any script could pass to the driver.
#
# Toggling nvidia-powerd needs no root for this user (polkit permits
# manage-units), which is exactly how ~/.local/bin/power-failsafe does it.
set -u

profile="$(gdbus call --system \
  --dest org.freedesktop.UPower.PowerProfiles \
  --object-path /org/freedesktop/UPower/PowerProfiles \
  --method org.freedesktop.DBus.Properties.Get \
  org.freedesktop.UPower.PowerProfiles ActiveProfile 2>/dev/null \
  | sed -n "s/.*'\(.*\)'.*/\1/p")"
[ -z "${profile:-}" ] && profile="$(powerprofilesctl get 2>/dev/null || echo balanced)"

case "$profile" in
  balanced|performance) want=on ;;
  *)                    want=off ;;
esac

if [ "$want" = on ]; then
  if ! systemctl is-active --quiet nvidia-powerd.service; then
    # Clear any start-limit-hit left by earlier flapping, then start.
    systemctl reset-failed nvidia-powerd.service 2>/dev/null || true
    systemctl start nvidia-powerd.service 2>/dev/null || true
  fi
else
  systemctl stop nvidia-powerd.service 2>/dev/null || true
fi

logger -t ppd-nvidia-boost "profile=$profile -> dynamic boost $want"
exit 0
