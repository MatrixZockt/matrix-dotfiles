# WhisperFlow on this machine (2026-11-17).
#
# ONE speech engine for the whole desktop. The shell's hold-SUPER dictation
# already runs a warm whisper.cpp server (dictate-server.service) with
# large-v3-turbo on the GPU, so WhisperFlow points at THAT server instead of
# starting a second copy: on 8 GB of VRAM a second model does not fit next to
# the local llama-server, and two servers holding the same weights would just
# halve the free memory for nothing.
#
# The trade-off is that WhisperFlow needs the shell's server up. It is a
# systemd unit enabled at login, and `dictate-server.sh start` brings it back
# if it was stopped, so in practice it always is.
WHISPER_FLOW_LOCAL_WHISPER_URL=http://127.0.0.1:8917
WHISPER_FLOW_MANAGE_LOCAL_SERVER=false
WHISPER_FLOW_MODEL_NAME=ggml-large-v3-turbo-q5_0

# Hotkeys. Push-to-talk is NOT super+alt: SUPER alone is this desktop's
# hold-to-dictate, and holding SUPER+ALT would arm the shell's dictation and
# WhisperFlow's at the same time, typing everything twice.
WHISPER_FLOW_HOTKEY_TRANSCRIBE=ctrl+alt+d
WHISPER_FLOW_HOTKEY_AUTO_TRANSCRIBE=ctrl+alt+space
WHISPER_FLOW_HOTKEY_COMMAND=ctrl+super+alt

WHISPER_FLOW_LIVE_TRANSCRIPTION=true
