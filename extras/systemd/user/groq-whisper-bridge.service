[Unit]
Description=Groq transcription behind whisper.cpp's API for hold-SUPER dictation and WhisperFlow - the clients keep posting to /inference, this forwards the audio to Groq (whisper-large-v3-turbo, free tier) and replays the same request against the local engine on 8917 when the key is missing, the quota is spent or the network is down
# Same anchor as the other helpers here: there is no graphical-session.target on
# this setup. Nothing is downloaded or bound in advance; the service is idle
# until a client posts a clip.
After=default.target

[Service]
Type=simple
ExecStart=%h/.local/bin/groq-whisper-bridge
# The key lives here, 0600, outside the repository: never in a tracked file and
# never in this unit. `-` so a machine without the file still starts (every
# request then takes the local fallback, which is a working dictation setup).
EnvironmentFile=-%h/.config/groq-whisper/groq.env
Environment=PYTHONUNBUFFERED=1
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=groq-whisper-bridge

[Install]
WantedBy=default.target
