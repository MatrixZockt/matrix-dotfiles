<?xml version="1.0" encoding="UTF-8"?>
<!--
  org.matrix.razercc: the privileged operations Razer Command Center
  performs, funneled through ONE narrow helper script so each operation is
  an enumerated argument, never a free-form root shell.

  The org.freedesktop.policykit.exec.path annotation on each action is what
  makes pkexec resolve to THESE actions instead of the built-in generic
  org.freedesktop.policykit.exec action. Without it, every fan/slider tweak
  fell through to the generic action (auth_admin by default) and asked for
  the admin password, even though the fan action was already marked
  allow_active=yes. That setting was simply never consulted.

  allow_active=yes is safe here specifically because of how the helper is
  written: every op is a fixed command with enumerated, validated arguments
  (`fan 0|1`, `fanlevel 0-50`, `pwrlimit 5-250 5-250 0|1`,
  `nvidia 0|2|3 0|1`, `decode`), anything else exits 2. So a passwordless
  grant opens no path to a general root shell: it only lets this user drive
  these five specific operations.

  `pwrlimit` (added 2026-09-28) is the one that does real work in the fan
  feature, and it is bounded in the same way: the helper rejects anything
  outside 5-250 W before writing, and the kernel rejects PL2 < PL1, so the
  worst this grant can do is what the CPU's own package power limits allow.
  It exists because the ACPI fan level this app used to drive is ignored by
  the embedded controller on this hardware (measured: 25 % and 90 % produce
  the same temperature under identical load), so the only lever that changes
  how loud the machine is turned out to be the heat the CPU is allowed to
  make. See FAN_POWER_POLICY in the app.

  NOTE: a double hyphen may never appear inside an XML comment. The XML spec
  forbids it, and a single occurrence silently invalidates the ENTIRE file:
  polkit then registers none of these actions, pkexec falls back to
  org.freedesktop.policykit.exec (auth_admin), and every tweak asks for a
  password again. That is exactly what happened on 2026-09-28, from two
  double-hyphen em-dash substitutes in this very comment.
-->
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD POLICY POLICYCONFIG 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>

  <action id="org.matrix.razercc.fan">
    <description>Set Razer fan boost switch and level</description>
    <message>Changing the fan curve requires privilege</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/sbin/razer-cc-elevate</annotate>
    <annotate key="org.freedesktop.policykit.exec.allowgui">true</annotate>
  </action>

  <action id="org.matrix.razercc.nvidia">
    <description>Write NVIDIA RTD3 power-management settings</description>
    <message>Writing the NVIDIA power-management settings requires privilege</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/sbin/razer-cc-elevate</annotate>
    <annotate key="org.freedesktop.policykit.exec.allowgui">true</annotate>
  </action>

  <action id="org.matrix.razercc.decode">
    <description>Fix decode offload environment</description>
    <message>Editing /etc/environment requires privilege</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/sbin/razer-cc-elevate</annotate>
    <annotate key="org.freedesktop.policykit.exec.allowgui">true</annotate>
  </action>

</policyconfig>
