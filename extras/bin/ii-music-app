.plistrow.sel {{ background: {LAYER2}; border-color: {ACCENT_DIM}; }}
.plistrow.sel image, .plistrow.sel .plname {{ color: {ACCENT}; }}
.plname {{ font-weight: 600; }}
.plcount {{ color: {SUB}; font-size: 12px; }}
.listbox {{ background: transparent; }}
.row-track {{ padding: 7px 10px; border-radius: 10px; }}
.row-track:hover {{ background: {LAYER2}; }}
.row-track.playing {{ background: {LAYER2}; }}
.row-track .rowicon {{ color: {SUB}; }}
.row-track.playing .rowicon {{ color: {ACCENT}; }}
.row-track .rowtitle {{ font-weight: 500; }}
.row-track.playing .rowtitle {{ color: {ACCENT}; }}
.rownum {{ color: {PLACEHOLDER}; font-family: monospace; font-size: 12px; }}
.rowtag {{ color: {SUB}; font-size: 12px; }}

/* scrollbars: present but quiet */
scrollbar {{ background: transparent; }}
scrollbar slider {{ background: {LAYER3}; border-radius: 4px; min-width: 6px; }}
scrollbar slider:hover {{ background: {OUTLINE2}; }}
""", -1)
        Gtk.StyleContext.add_provider_for_display(
            Gdk.Display.get_default(), prov,
            Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

    # ── artwork widgets ──────────────────────────────────────────────
    # One tile shape for both lists, so a track's art looks the same in a
    # row and in a playlist mosaic. A tile is an Overlay: the real cover, and
    # on top of it whatever marker is needed (the note icon while the art is
    # still being decoded or when the file simply has none).
    @staticmethod
    def _tile(size, cls="tile", marker_icon=None):
        """(container, set_art, marker) -- set_art(bytes_or_None) fills it.

        The container is an Overlay so the placeholder note sits ON TOP of the
        cover: a track with no embedded art shows the note, and one with art
        shows the art, with no layout change and no placeholder space to
        collapse when the decode lands. A marker_icon adds the play/pause
        badge on top of both, for the row that is playing.
        """
        img = Gtk.Image()
        img.set_pixel_size(size)
        img.set_size_request(size, size)

        fallback = Gtk.Image.new_from_icon_name("audio-x-generic-symbolic")
        fallback.set_pixel_size(max(14, size // 2))
        fallback.add_css_class("tileph")
        fallback.set_halign(Gtk.Align.CENTER)
        fallback.set_valign(Gtk.Align.CENTER)

        over = Gtk.Overlay()
        over.set_child(img)
        over.add_overlay(fallback)

        marker = None
        if marker_icon:
            marker = Gtk.Image.new_from_icon_name(marker_icon)
            marker.set_pixel_size(max(14, size // 2 - 2))
            marker.add_css_class("rowmarker")
            marker.set_halign(Gtk.Align.CENTER)
            marker.set_valign(Gtk.Align.CENTER)
            marker.set_visible(False)
            over.add_overlay(marker)

        over.set_size_request(size, size)
        box = Gtk.Box()
        box.add_css_class(cls)
        box.set_size_request(size, size)
        box.append(over)

        def set_art(art_path):
            set_cover_image(img, fallback, art_path)
        return box, set_art, marker

    def _playlist_tile(self, pl, size=46):
        """A playlist's art: a 2x2 mosaic of the first four tracks' covers.

        It is a Grid rather than one image because the four covers are four
        separate files, and because a partly-filled mosaic still reads as
        artwork -- the note icon shows through the squares that have none --
        instead of as a broken image. Built empty and filled as the
        extractions land, so the list is never waiting on ffmpeg.
        """
        half = (size - 1) // 2
        grid = Gtk.Grid()
        grid.set_row_spacing(1)
        grid.set_column_spacing(1)
        cells = []
        for i in range(4):
            cell = Gtk.Image()
            cell.set_pixel_size(half)
            cell.set_size_request(half, half)
            grid.attach(cell, i % 2, i // 2, 1, 1)
            cells.append(cell)

        fallback = Gtk.Image.new_from_icon_name("audio-x-generic-symbolic")
        fallback.set_pixel_size(size // 2)
        fallback.add_css_class("tileph")
        fallback.set_halign(Gtk.Align.CENTER)
        fallback.set_valign(Gtk.Align.CENTER)

        over = Gtk.Overlay()
        over.set_child(grid)
        over.add_overlay(fallback)
        over.set_size_request(size, size)

        tile = Gtk.Box()
        tile.add_css_class("tile")
        tile.add_css_class("mosaic")
        tile.set_size_request(size, size)
        tile.append(over)

        state = {"any": False}

        def take(art_path, slot):
            if not art_path:
                return
            cells[slot].set_from_file(art_path)
            if not state["any"]:
                state["any"] = True
                fallback.set_visible(False)

        for slot, t in enumerate(pl["tracks"][:4]):
            COVERS.request(t["path"], lambda data, s=slot: take(data, s))
        return tile

    # ── layout ───────────────────────────────────────────────────────────
    def build(self):
        """The middle island's Music view, rebuilt as a window.

        The layout below is NowBarPanel.qml's Media view (lines ~1364-2095)
        number for number -- 26px side margins, a 64px cover, a 34px outlined
        play disc, the merged bar at margins 6 with `pad: 4`, and a list of
        42px rows with a 32px header and 5px between them. The numbers are
        copied rather than approximated because the whole request is that this
        window BE that card.

        What is added on top of it, and only this:
          * the playlist rail, on the left -- the card has no room for one,
            and browsing the library is a thing this window does;
          * the search field, which covers the library AND the online
            catalogue.
        Everything about the music -- the hero, the bar, the rows, the
        feedback on the playing row -- is the card's.
        """
        self._css()
        self.set_content(Adw.ToolbarView())

        toolbar = self.get_content()

        # ── header: the title, and the explicit quit (closing only hides) ──
        header = Adw.HeaderBar()
        header.set_valign(Gtk.Align.CENTER)
        ttl = Gtk.Label(label="Music")
        ttl.set_xalign(0)
        ttl.set_hexpand(True)
        ttl.add_css_class("headtitle")
        header.set_title_widget(ttl)
        quit_btn = Gtk.Button(label="Quit app")
        quit_btn.add_css_class("quitbtn")
        quit_btn.set_tooltip_text(
            "Close the app. Playback continues in the music daemon.")
        quit_btn.connect("clicked", self._on_quit_clicked)
        header.pack_end(quit_btn)
        toolbar.add_top_bar(header)

        body = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=0)
        body.set_vexpand(True)

        # ══ LEFT: the playlists, and the search that covers everything ═════
        #
        # The one thing this window has that the card does not. The rail is
        # kept narrow and unadorned on purpose -- it is a filing cabinet next
        # to the instrument, not part of it.
        rail = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        rail.set_size_request(210, -1)
        rail.add_css_class("rail")

        self._entry = Gtk.SearchEntry()
        self._entry.set_hexpand(True)
        self._entry.set_placeholder_text("Search library and online")
        self._entry.set_tooltip_text(
            "Every playlist at once -- title, artist, playlist name -- and the "
            "online catalogue underneath, where results can be saved offline")
        self._entry.add_css_class("search")
        # `changed`, NOT `search-changed`: GTK's search-changed does not fire
        # when the text is set programmatically (setting it to a non-empty
        # value from empty emits nothing at all), so clearing the field from
        # a button would leave the list filtered with no query on screen.
        self._entry.connect("changed", self._on_search)
        rail.append(self._entry)

        plrule = Gtk.Label(label="PLAYLISTS")
        plrule.set_xalign(0)
        plrule.add_css_class("rule")
        rail.append(plrule)

        self._pllist = Gtk.ListBox()
        self._pllist.add_css_class("listbox")
        self._pllist.set_selection_mode(Gtk.SelectionMode.NONE)
        self._pllist.connect("row-activated", self._on_pl_activated)
        plscroll = Gtk.ScrolledWindow()
        plscroll.set_child(self._pllist)
        plscroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        plscroll.set_vexpand(True)
        rail.append(plscroll)

        self._btn_clear = Gtk.Button(label="Clear search")
        self._btn_clear.add_css_class("pbtn")
        self._btn_clear.set_visible(False)
        self._btn_clear.connect("clicked", self._clear_search)
        rail.append(self._btn_clear)
        body.append(rail)

        railsep = Gtk.Separator()
        railsep.set_orientation(Gtk.Orientation.VERTICAL)
        body.append(railsep)

        # ══ RIGHT: the card ═══════════════════════════════════════════════
        card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        card.set_hexpand(True)

        # ── the hero ─────────────────────────────────────────────────────
        #
        # This band used to be ~300px of a 580px card -- a 132px cover, 22px
        # gaps twice over, a 44px disc and a 46px bar -- and was then cut down
        # to a thin strip (64px cover, 10px gaps, a 30px bar) on the theory
        # that the list below is the part worth the pixels.
        #
        # That was wrong, and the user is the reason it is being undone: the
        # "playing now" statement is what the window is opened FOR, and at
        # strip size it read as a caption above a list rather than as the
        # thing itself. The list is a scroller and gives up rows happily; the
        # hero has no second place to be looked at. So the hero is sized to
        # read (HERO_COVER, HERO_GAP, HERO_AIR) and the list takes the rest.
        hero = Gtk.Box(orientation=Gtk.Orientation.VERTICAL,
                       spacing=HERO_AIR)
        hero.add_css_class("hero")
        hero.set_margin_top(HERO_AIR)
        hero.set_margin_bottom(HERO_AIR)

        # The cover and the words it belongs to, side by side. These were two
        # rows of a vertical layout once, so the title read as a caption to
        # the picture rather than as the thing the picture is for. A track's
        # title is the primary label on this screen; the art is secondary.
        hrow = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL,
                      spacing=HERO_GAP)
        # 22, not 30. The extra 8px a side went straight back to the title,
        # which was ellipsising a fourteen-character name in a window that is
        # 844px wide -- the width the margin was borrowing from was width the
        # words needed.
        hrow.set_margin_start(22)
        hrow.set_margin_end(22)

        cframe = Gtk.Box()
        cframe.add_css_class("herocover")
        cframe.set_size_request(HERO_COVER, HERO_COVER)
        cframe.set_valign(Gtk.Align.CENTER)
        # Gtk.Image WITH `set_pixel_size`, which is the only combination that
        # both fills the frame and stays the size it is told to be.
        #
        # Gtk.Picture looked like the better tool -- it has `content-fit`, so
        # it crops to a square -- and it was the cause of a bug worth writing
        # down. `set_size_request` sets a MINIMUM, and a Picture's natural
        # size is the artwork's own pixel size: the covers are 320x320, so an
        # "88px" frame measured a natural of 320 and the row handed the
        # picture every pixel the title had not already claimed. Measured on
        # this machine, the frame allocated 318x318, not 88x88 -- which is why
        # the title was ellipsised while the "88px" cover looked enormous.
        # Wrapping it in a size request cannot fix that; the widget has to
        # agree about its natural size.
        #
        # Gtk.Image with a pixel size does: measured natural is exactly the
        # size asked for, and it fills the frame. (An Image WITHOUT a pixel
        # size renders at the file's natural size in the corner -- the other
        # half of this same bug.)
        self._cover = Gtk.Image()
        self._cover.set_pixel_size(HERO_COVER)
        self._cover.set_size_request(HERO_COVER, HERO_COVER)
        self._cover.add_css_class("coverimage")
        self._coverph = Gtk.Image.new_from_icon_name("audio-x-generic-symbolic")
        self._coverph.set_pixel_size(int(HERO_COVER * 0.45))
        self._coverph.add_css_class("coverph")
        cover_ov = Gtk.Overlay()
        cover_ov.set_child(self._cover)
        cover_ov.add_overlay(self._coverph)
        cframe.append(cover_ov)
        hrow.append(cframe)

        # Title and sub-line, one block, one rhythm.
        #
        # `set_lines(1)` ON THE TITLE TOO. It was only on the sub-line, so a
        # name long enough to wrap grew the identity block to two lines and
        # pushed the cover's vertical centre out of alignment with the text --
        # the hero changed height depending on what was playing.
        htext = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=3)
        htext.set_hexpand(True)
        htext.set_valign(Gtk.Align.CENTER)
        self._lbl_title = Gtk.Label(label="Nothing playing")
        self._lbl_title.set_xalign(0)
        self._lbl_title.set_ellipsize(3)
        self._lbl_title.set_lines(1)
        self._lbl_title.add_css_class("herotitle")
        self._lbl_artist = Gtk.Label(label="")
        self._lbl_artist.set_xalign(0)
        self._lbl_artist.set_ellipsize(3)
        self._lbl_artist.set_lines(1)
        self._lbl_artist.add_css_class("subline")
        htext.append(self._lbl_title)
        htext.append(self._lbl_artist)
        hrow.append(htext)

        # ── transport, grouped at the right ─────────────────────────────
        #
        # All THREE marks on the title row. The skips used to flank the seek
        # bar, which cost that bar 66px of its length for two arrows that are
        # about the SONG rather than about where you are in it.
        #
        # 8px between them, and 8 is not `HERO_GAP - 9`: it is the number the
        # bar's own transport uses, and now that all three marks are the same
        # 25px there is no outline to keep clear of a neighbour, so the reason
        # for the odd subtraction is gone.
        tr = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        tr.set_valign(Gtk.Align.CENTER)

        self._btn_prev = self._mark("prev", "Previous")
        self._btn_play = self._mark("play", "Play or pause")
        self._playpause_btn = self._btn_play
        self._btn_next = self._mark("next", "Next")
        # Mode marks, Spotify-style: shuffle before prev, repeat after next,
        # both lit by a persistent ring while engaged. They are mode, not
        # transport, so they are drawn smaller-ink and never bold.
        self._btn_shuffle = self._mark("shuffle", "Shuffle")
        self._btn_repeat = self._mark("repeat", "Repeat playlist")
        self._btn_shuffle.connect("clicked", self._on_shuffle_clicked)
        self._btn_repeat.connect("clicked", self._on_repeat_clicked)
        tr.append(self._btn_shuffle)
        tr.append(self._btn_prev)
        tr.append(self._btn_play)
        tr.append(self._btn_next)
        tr.append(self._btn_repeat)
        hrow.append(tr)
        hero.append(hrow)

        # ── the merged sound + music bar ─────────────────────────────────
        #
        # ONE object where there were two, and now the widest thing on the
        # card. No plate: the bar used to draw its own surface, which on a
        # card that already has one read as a box inside a box.
        self._bar = SoundBar()
        self._bar.set_margin_start(6)
        self._bar.set_margin_end(6)
        self._bar.on_seek = self._seek_to_fraction
        self._bar.on_volume = self._on_volume_from_bar
        hero.append(self._bar)
        card.append(hero)

        # ── the playlist ─────────────────────────────────────────────────
        listbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        listbox.set_vexpand(True)

        # The column header, ABOVE the list and not inside it: a
        # delegate-positioned header sits inside the view's clip, so the one
        # row that explains what the columns mean is the one row you cannot
        # read.
        head = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        head.add_css_class("colhead")
        headrow = Gtk.Overlay()
        self._lbl_plname = Gtk.Label(label="SELECT A PLAYLIST")
        self._lbl_plname.set_halign(Gtk.Align.START)
        self._lbl_plname.set_ellipsize(3)
        self._lbl_plname.add_css_class("coltitle")
        headrow.set_child(self._lbl_plname)
        head.append(headrow)

        self._lbl_empty = Gtk.Label(label="Nothing in this playlist")
        self._lbl_empty.add_css_class("empty")
        self._lbl_empty.set_visible(False)
        listbox.append(self._lbl_empty)

        self._lbl_status = Gtk.Label(label="")
        self._lbl_status.set_xalign(0)
        self._lbl_status.set_ellipsize(3)
        self._lbl_status.add_css_class("status")
        self._lbl_status.set_visible(False)
        listbox.append(self._lbl_status)

        self._tracklist = Gtk.ListBox()
        self._tracklist.add_css_class("tracklist")
        self._tracklist.set_selection_mode(Gtk.SelectionMode.NONE)
        self._tracklist.connect("row-activated", self._on_track_activated)
        trscroll = Gtk.ScrolledWindow()
        trscroll.set_child(self._tracklist)
        trscroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        trscroll.set_vexpand(True)
        listbox.append(trscroll)
        card.append(listbox)

        body.append(card)
        toolbar.set_content(body)

        # keyboard
        keyc = Gtk.EventControllerKey()
        keyc.connect("key-pressed", self._on_key)
        self.add_controller(keyc)

    def _mark(self, kind, tip):
        """One transport mark, drawn by `Mark` (the island's TransportMark).

        It replaces a Gtk.Button carrying a stock symbolic icon, which is what
        the app had: a 32px skip and a 36px play disc using GTK's
        `media-playback-*` glyphs. Those are the OLD panel transport, not the
        bar's -- heavier, the wrong pause shape, and a background that
        appeared only on hover. See `Mark` for the port and the reasoning
        behind each number.
        """
        m = Mark(kind, tip)
        m.connect("clicked", self._on_mark_clicked, kind)
        return m

    def _on_mark_clicked(self, btn, icon):
        if icon == "prev":
            self._prev()
        elif icon == "next":
            self._next()
        else:
            self._playpause()

    def _on_shuffle_clicked(self, *_):
        self.cfg["shuffle"] = not bool(self.cfg.get("shuffle"))
        self._btn_shuffle.set_mode(self.cfg["shuffle"])
        self._persist()

    def _on_repeat_clicked(self, *_):
        self.cfg["repeat"] = not bool(self.cfg.get("repeat"))
        self._btn_repeat.set_mode(self.cfg["repeat"])
        # repeat = loop the WHOLE playlist (matches the daemon default), so a
        # queue never runs dry. repeat-one did nothing for the "randomly
        # stops" bug and loop-file vs loop-playlist was the whole confusion.
        self.mpv.send(["set_property", "loop-playlist", bool(self.cfg["repeat"])])
        self._persist()

    @staticmethod
    def _sinks():
        out = run("pactl", "list", "short", "sinks")
        names = []
        for line in out.decode(errors="ignore").splitlines():
            parts = line.split("\t")
            if len(parts) >= 2:
                names.append(parts[1].strip())
        return names

    # ── config ──────────────────────────────────────────────────────────
    def apply_config(self):
        """Push the persisted settings into the daemon.

        The daemon outlives the app, so settings are re-applied on every
        launch instead of being set once at daemon start: an app closed for
        a day and reopened must still be the thing that decides the volume.
        """
        self.mpv.send(["set_property", "volume", int(self.cfg["volume"])])
        # repeat = loop the playlist (loop-playlist), not repeat-one: the
        # daemon's unit default is loop-playlist=inf, so an OFF app must say
        # so explicitly or the app closed-yesterday keeps looping today.
        self.mpv.send(["set_property", "loop-playlist", bool(self.cfg["repeat"])])
        # restore the lit state of the mode marks from the persisted config
        try:
            self._btn_shuffle.set_mode(bool(self.cfg.get("shuffle")))
            self._btn_repeat.set_mode(bool(self.cfg.get("repeat")))
        except AttributeError:
            pass
        if self.cfg.get("outputDevice"):
            self.mpv.send(["set_property", "audio-device",
                           self.cfg["outputDevice"]])

    def _persist(self):
        save_config(self.cfg)

    # (the old _on_shuffle/_on_repeat Gtk.ToggleButton handlers are gone:
    # the buttons are the Mark-based mode marks on the title row now, and
    # nothing ever instantiated the toggles)

    def _on_device(self, _dd, _pspec):
        idx = self._dev.get_selected()
        names = getattr(self, "_sinks_cache", self._sinks())
        self.cfg["outputDevice"] = names[idx - 1] if idx > 0 else ""
        if self.cfg["outputDevice"]:
            self.mpv.send(["set_property", "audio-device",
                           self.cfg["outputDevice"]])
        else:
            self.mpv.send(["set_property", "audio-device", "auto"])
        self._persist()

    def _on_quit_clicked(self, *_):
        self.get_application().quit()

    # ── search ──────────────────────────────────────────────────────────
    # One field for both halves. Empty query = the selected playlist, exactly
    # as before; a query switches the right column to matches from every
    # playlist, tagged with where each one came from, and — once there are at
    # least two characters — to the online catalogue underneath.
    #
    # The local filter is instant and the online half is DEBOUNCED, because
    # Audius rate-limits by app_name and this app shares that identity with
    # the shell's Music tab: one keystroke, one request would spend the budget
    # on a prefix nobody wanted.
    ONLINE_DEBOUNCE_MS = 450

    def _on_search(self, entry):
        raw = entry.get_text().strip()
        self._raw_query = raw
        self._query = raw.lower()
        self._btn_clear.set_visible(bool(raw))
        self._rebuild_tracks()          # local matches: no waiting
        if self._search_timer is not None:
            GLib.source_remove(self._search_timer)
            self._search_timer = None
        if len(raw) >= 2:
            self._search_timer = GLib.timeout_add(
                self.ONLINE_DEBOUNCE_MS, self._online_search_fire)
        else:
            # Nothing to search online for, so drop the old results outright:
            # leaving them loaded means the next two-letter query briefly shows
            # the previous answer's tracks, and burns rate limit re-fetching
            # what is already in hand.
            AUDIUS.clear()
            self._set_status("")

    def _online_search_fire(self):
        """The debounce timer, kept separate from the action itself so that
        firing the action directly (a test, or a future "refresh" affordance)
        does not leave the armed timeout behind to fire a second request."""
        self._search_timer = None
        self._online_search()
        return False

    def _online_search(self, raw=None):
        if self._search_timer is not None:
            GLib.source_remove(self._search_timer)
            self._search_timer = None
        q = self._raw_query if raw is None else raw
        AUDIUS.search(q, False, self._online_search_done)

    def _online_search_done(self):
        """A page (or a failure) arrived. Everything is read off AUDIUS, which
        is the only thing that knows what actually came back."""
        if AUDIUS.busy:
            self._set_status(f"Searching Audius for “{self._raw_query}”…")
        elif AUDIUS.error:
            self._set_status(AUDIUS.error)
        elif self._raw_query and len(AUDIUS.results) > 0:
            self._set_status(
                f"{len(AUDIUS.results)} from the online catalogue"
                + (" — more available" if AUDIUS.has_more else ""))
        else:
            self._set_status("")
        self._rebuild_tracks()

    def _load_more(self, *_):
        AUDIUS.load_more(self._online_search_done)

    def _clear_search(self, *_):
        self._entry.set_text("")
        self._entry.grab_focus()

    def _set_status(self, text):
        self._status = text or ""
        self._lbl_status.set_text(self._status)
        self._lbl_status.set_visible(bool(self._status))

    def _rows_source(self):
        """The list the right column is showing: matches, then online, then a
        paging row — or, with no query, just the selected playlist."""
        out = []
        if self._query:
            for pl in self._library:
                for t in pl["tracks"]:
                    if matches(t, pl["name"], self._query):
                        out.append((t, pl["name"]))
        else:
            pl = next((p for p in self._library
                       if p["name"] == self._sel_playlist), None)
            out = [(t, pl["name"]) for t in pl["tracks"]] if pl else []
        # Online rows only belong to a search: browsing a playlist must not
        # quietly turn into "this playlist plus 150 strangers".
        if self._query:
            for t in AUDIUS.results:
                out.append((t, "Audius"))
            if AUDIUS.has_more:
                out.append(({"load_more": True}, ""))
        return out

    def _tick_spectrum(self):
        """Copy cava's bands onto the GTK thread and push them into the bar.

        cava writes from its own thread; widgets may only be touched from the
        main loop, so the values are read under the spectrum's own lock and
        then handed over. 60Hz is the config's own frame rate, so nothing is
        thrown away and nothing is invented.
        """
        pts = SPECTRUM.snapshot()
        self._spectrum = pts
        self._bar.set_spectrum(pts)
        row = self._play_row
        if row is not None and not self._query:
            self._update_meter(row)
        return True

    @property
    def _playing_path(self):
        """The file that is actually playing.

        mpv's `filename`, not the queue index: the queue can be shuffled,
        filtered to one track, or hold tracks from several folders, so an
        index into it says nothing about which playlist is on screen. This is
        the card's `playingPath`, and the join key for everything below it.
        """
        return self._state.get("filename", "")

    # ── the current playlist, exactly as the card derives it ─────────────
    #
    # The file that is actually playing is the join key for everything below,
    # and it is deliberately NOT the queue index: the queue can be shuffled,
    # filtered to one track, or hold tracks from several folders, so an index
    # into it says nothing about which playlist is on screen.
    def _derive_playlist(self):
        """Which scanned folder the playing file lives in, and the last one we
        saw.

        A path is in at most one folder, so the first match is the only match.

        `lastPlaylist` is a REFERENCE, not a copy of its tracks: the library
        is rebuilt from scratch on every scan, so a copied array would freeze
        the rows -- and their covers -- at whatever the scan knew when the
        music stopped, and would then disagree with the rail.
        """
        path = self._playing_path
        found = None
        if path:
            for pl in self._library:
                for t in pl["tracks"]:
                    if t["path"] == path:
                        found = pl
                        break
                if found:
                    break
        if found is not None:
            self._last_playlist = found
            self._last_playing_path = path
        return found or self._last_playlist

    @property
    def shown_playlist(self):
        return self._derive_playlist()

    @property
    def marked_path(self):
        return self._playing_path or self._last_playing_path

    def _shown_tracks(self):
        """The rows the list renders.

        Durations are attached HERE, at read time, rather than stored on the
        track: the library is rebuilt on every scan and a duration written onto
        the track at parse time would be lost every time the cache grew.
        """
        pl = self._derive_playlist()
        if not pl:
            return []
        out = []
        for t in pl["tracks"]:
            out.append({
                "path": t["path"],
                "title": t["title"],
                "artist": t["artist"],
                "album": t.get("album", ""),
                "duration": self._duration_of(t["path"]),
            })
        return out

    def _subline(self, playlist_name, album):
        """Playlist and album on one line -- and NOT the same word twice.

        The playlist is the more important of the two (it is the only thing on
        this screen that answers "why is the next track that one"), and on a
        local library the folder is called "My Breakcore" and the files inside
        carry ALBUM=My Breakcore, so `playlist . album` printed it twice and
        the line read as noise. Compared case-insensitively, because folder and
        tag disagree on case often enough that an exact test lets "my breakcore"
        through beside "My Breakcore" and reintroduces the same thing.
        """
        pl = (playlist_name or "").strip()
        al = (album or "").strip()
        # The MPRIS bridge substitutes "Unknown Album" for a tag that is not
        # there. Fine for a log, terrible for a card: it reads as a real album.
        if al.lower() == "unknown album":
            al = ""
        if pl == "":
            return al
        if al == "":
            return pl
        if al.lower() == pl.lower():
            return pl
        return f"{pl}  ·  {al}"

    def _duration_of(self, path):
        return self._durations.get(path, 0.0)

    def _ensure_durations(self, pl):
        """Fill in the running times for the playlist on screen.

        ffprobe, one process per track, on a worker thread -- the library has
        no duration cache of its own and spawning 125 of them on the GTK
        thread would freeze the window. Only the playlist being shown is
        measured, and only the ones not already known, so opening a playlist
        costs one pass and reopening it costs nothing.
        """
        if not pl:
            return
        want = [t["path"] for t in pl["tracks"]
                if t["path"] not in self._durations]
        if not want:
            return

        def worker():
            found = {p: read_duration(p) for p in want}
            GLib.idle_add(self._merge_durations, found)

        threading.Thread(target=worker, daemon=True).start()

    def _merge_durations(self, found):
        self._durations.update(found)
        # The list is only rebuilt when NOT searching: a search shows matches
        # from every playlist and rebuilding per keystroke would fight the
        # debounce for no gain.
        if not self._query:
            self._rebuild_tracks()

    # ── library UI ───────────────────────────────────────────────────────
    def refresh_library(self):
        self._library = scan_library()
        child = self._pllist.get_first_child()
        while child:
            nxt = child.get_next_sibling()
            self._pllist.remove(child)
            child = nxt
        for pl in self._library:
            row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
            row.add_css_class("plistrow")
            tile = self._playlist_tile(pl)
            tile.set_valign(Gtk.Align.CENTER)
            row.append(tile)
            box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=1)
            box.set_hexpand(True)
            name = Gtk.Label(label=pl["name"])
            name.set_xalign(0)
            name.set_ellipsize(3)
            name.add_css_class("plname")
            n = Gtk.Label(label=f"{len(pl['tracks'])} tracks")
            n.set_xalign(0)
            n.add_css_class("plcount")
            box.append(name)
            box.append(n)
            row.append(box)
            self._pllist.append(row)
            row._pl_name = pl["name"]
        # auto-select the first playlist with tracks
        if self._sel_playlist is None and self._library:
            self._select_playlist(self._library[0]["name"])
        else:
            self._rebuild_tracks()
        if not self._query:
            self._ensure_durations(self._derive_playlist())

    def _select_playlist(self, name):
        self._sel_playlist = name
        child = self._pllist.get_first_child()
        while child:
            card = child.get_child()
            if card:
                if getattr(card, "_pl_name", None) == name:
                    card.add_css_class("sel")
                else:
                    card.remove_css_class("sel")
            child = child.get_next_sibling()
        self._rebuild_tracks()

    # ── the rows ─────────────────────────────────────────────────────────
    ROW_H = 56            # the card's row height. 42 was the number that made
                          # the list read as a dense index rather than as
                          # songs: a 24px thumbnail with a 15px title inside a
                          # 42px row leaves the art smaller than the text it
                          # sits beside. The row is sized off the ART now, so
                          # the two cannot disagree again.
    ROW_GAP = 7           # air between rows: without it a list of 56px rows
                          # butted together reads as one striped block, and
                          # the only thing separating "now" from "next" is
                          # the accent rule on the current row
    ART = 36              # was 24: too small to recognise a cover at, and
                          # smaller than the row's own title text

    def _rebuild_tracks(self):
        """Redraw the list, and keep the header honest about what it shows.

        There are three different lists and only one of them is "the queue":
        browsing a playlist, searching (local hits, then online, then the
        paging row), and the card's own list, which is whatever playlist is
        playing. Search wins when it is on, because a query is a question and
        it has to be answered by the thing the user typed.
        """
        child = self._tracklist.get_first_child()
        while child:
            nxt = child.get_next_sibling()
            self._tracklist.remove(child)
            child = nxt
        self._rows = []

        searching = bool(self._query)
        rows = self._rows_source()

        n_local = sum(1 for t, _ in rows if not t.get("online")
                      and not t.get("load_more"))
        n_online = sum(1 for t, _ in rows if t.get("online"))
        if searching:
            if n_online:
                head = (f"{n_local} LOCAL MATCH{'ES' if n_local != 1 else ''}"
                        f"  ·  {n_online} ONLINE")
            else:
                head = (f"{n_local} MATCH{'ES' if n_local != 1 else ''} FOR "
                        f"“{self._raw_query}”")
        else:
            head = (self._sel_playlist or "SELECT A PLAYLIST").upper()
        self._lbl_plname.set_text(head)

        self._visible = rows
        for idx, (t, plname) in enumerate(rows):
            if t.get("load_more"):
                self._append_load_more_row(idx)
                continue
            row = self._build_row(t, plname, idx, searching)
            self._tracklist.append(row)
            row._vis_idx = idx
            self._rows.append(row)

        self._lbl_empty.set_visible(not self._visible)
        if self._lbl_empty.get_visible():
            self._lbl_empty.set_text(
                "Nothing matches that search" if searching
                else ("No playlist playing" if not rows else ""))
        self._mark_playing()

    def _build_row(self, t, plname, idx, searching):
        """One row, in the card's geometry.

        The columns are PLACED BY HAND, not by a layout: a fillWidth title
        takes everything left AFTER the fixed columns, and in practice the
        artist and time columns collapsed to nothing and were simply not on
        screen. Absolute offsets are also the only way the header and the rows
        can be guaranteed to line up.
        """
        is_cur = (not searching) and t.get("path") == self.marked_path
        row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
        row.add_css_class("row")
        if is_cur:
            row.add_css_class("current")
        if t.get("online"):
            row.add_css_class("rowonline")

        # The current row is marked THREE ways at once on purpose: colour
        # alone fails for anyone who cannot separate the accent from the
        # background, and a single left border is easy to lose in a long list.
        # The accent rule is on EVERY row and only VISIBLE on the current one.
        # Gtk.Box has no `insert` and no `prepend`-that-preserves-order in this
        # binding, and a rule that appeared on marking would shove every
        # column 8px sideways at the exact moment the user clicked something.
        # A rule that is always there and only changes colour does neither.
        rule = Gtk.Box()
        rule.add_css_class("currentrule")
        rule.set_size_request(3, -1)
        row.append(rule)

        # every row gets art, because the list is SCANNED rather than read and
        # a picture is how you find the track you half-remember
        art, set_art, marker = self._tile(self.ART,
                                          marker_icon="media-playback-start-symbolic")
        row._marker = marker
        row._set_art = set_art
        art.add_css_class("rowart")
        art.set_size_request(self.ART, self.ART)
        row.append(art)
        if t.get("online"):
            COVERS.request_url(t.get("art"), set_art)
        else:
            COVERS.request(t["path"], set_art)

        # The number slot is a container holding EITHER the row number or the
        # live meter, never both. A row is built before it is known to be the
        # playing one, so the swap happens when it becomes current -- which is
        # why the slot has to exist first: Gtk.Box has no `replace()` and no
        # `insert()` in this binding, so "swap it later" means the new widget
        # has somewhere to go before it is needed.
        numslot = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
        numslot.add_css_class("numslot")
        numslot.set_size_request(30, -1)
        row._numslot = numslot
        if t.get("online"):
            first = Gtk.Label(label="☁")
            first.add_css_class("rownum")
            numslot.append(first)
        elif is_cur:
            numslot.append(self._meter())
        else:
            first = Gtk.Label(label=f"{idx + 1}")
            first.add_css_class("rownum")
            numslot.append(first)
        row.append(numslot)

        # The row is a FIXED height. A Box of labels sizes itself to the
        # tallest child, so without this the rows grew and shrank with their
        # text and the list stopped being a list.
        row.set_size_request(-1, self.ROW_H)

        ti = Gtk.Label(label=t["title"])
        ti.set_xalign(0)
        ti.set_ellipsize(3)
        ti.add_css_class("rowtitle")
        # The only column that flexes. Everything else has a width, so no two
        # of them can ever be drawn on top of each other.
        ti.set_hexpand(True)
        if is_cur:
            ti.add_css_class("rowtitlecur")
        row.append(ti)

        # in search mode the artist line carries where the track lives,
        # because the match may have come from any playlist
        sub = f"{t['artist'] or '—'}  ·  {plname}" if searching \
            else (t["artist"] or "—")
        ar = Gtk.Label(label=sub)
        ar.set_xalign(1)
        ar.set_ellipsize(3)
        ar.add_css_class("rowartist")
        ar.set_width_chars(18)       # the card's artist column, roughly
        row.append(ar)

        dur = t.get("duration") or 0
        tm = Gtk.Label(label=clock(dur) if dur else "")
        tm.set_xalign(1)
        tm.add_css_class("rowtime")
        tm.set_width_chars(5)        # M:SS never needs more
        row.append(tm)

        if t.get("online"):
            row.append(self._online_buttons(t))
        return row

    def _meter(self):
        """The playing row's live meter, in the number column.

        It used to be three bars whose heights were constants picked by
        isPlaying -- it flipped once and then sat there, looking like an
        equaliser while listening to nothing at all. This reads real bands off
        the spectrum instead, so it moves because the music is moving. Three
        bands spread across the spectrum, low/mid/high, so the row wiggles the
        way a spectrum should instead of pulsing in unison.
        """
        box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=2)
        box.add_css_class("meter")
        box.set_halign(Gtk.Align.CENTER)
        box._bands = []
        for frac in (0.06, 0.30, 0.72):
            b = Gtk.Box()
            b.add_css_class("band")
            b.set_halign(Gtk.Align.END)
            b.set_valign(Gtk.Align.CENTER)
            b.set_size_request(3, 2)
            box.append(b)
            box._bands.append((frac, b))
        return box

    def _update_meter(self, row):
        """Animate the current row's meter from the live spectrum."""
        meter = None
        for child in kids(row):
            if "meter" in child.get_css_classes():
                meter = child
                break
        if meter is None:
            return
        for frac, b in meter._bands:
            shape = band_shape(self._spectrum, int(frac * 40), 40)
            b.set_size_request(3, max(2, int(2 + min(1.0, shape) * 12)))


    def _append_load_more_row(self, idx):
        """The paging control, in the list rather than above it: the point of
        it is that there are MORE results BELOW, and a row is the only way to
        say that without pushing the list around while it is being read."""
        row = Gtk.Button()
        row.add_css_class("loadmore")
        row.set_label("Load more results" if not AUDIUS.busy
                      else "Loading…")
        row.set_sensitive(not AUDIUS.busy)
        row.set_tooltip_text(
            f"Fetch the next {AUDIUS_PAGE} results for “{self._raw_query}”")
        row.connect("clicked", self._load_more)
        self._tracklist.append(row)
        row._vis_idx = idx
        row._load_more_row = True
        self._rows.append(row)

    def _online_buttons(self, track):
        """The two things you can do with a result you do not own yet.

        Save (arrow into a tray) puts it in the standalone bucket; the folder
        button opens the playlists and saves into one of them. Both are
        disabled while a download runs, so a second click cannot start a
        second curl writing to the same path.
        """
        wrap = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        wrap.set_valign(Gtk.Align.CENTER)
        saved = track["id"] in self._online_saved

        save = Gtk.Button()
        save.set_icon_name("document-save-symbolic"
                           if not saved else "object-select-symbolic")
        save.add_css_class("rowbtn")
        busy = self._downloading == track["id"]
        if saved:
            save.set_tooltip_text(f"Saved offline to "
                                  f"{os.path.dirname(self._online_saved[track['id']])}")
            save.add_css_class("saved")
        elif not track.get("downloadable"):
            save.set_sensitive(False)
            save.set_tooltip_text(
                "The artist does not allow this track to be downloaded")
        else:
            save.set_tooltip_text("Save offline on its own, outside every "
                                  "playlist")
        save.set_sensitive(save.get_sensitive() and not busy and not saved)
        save.connect("clicked", lambda *_b: self._save_online(track, ""))
        wrap.append(save)

        add = Gtk.MenuButton()
        add.set_icon_name("list-add-symbolic")
        add.set_always_show_arrow(False)
        add.add_css_class("rowbtn")
        add.set_sensitive(not busy)
        add.set_tooltip_text("Save offline into one of your playlists")
        # Gtk.MenuButton, not Gtk.Button: in this binding only MenuButton
        # carries the `popover` property, and that property is what makes the
        # widget OPEN the picker on click. Gtk.Button has no set_popover here
        # at all, so the obvious choice raises at the first click.
        self._attach_playlist_picker(add, track)
        wrap.append(add)
        return wrap

    def _attach_playlist_picker(self, button, track):
        """A popover listing the playlists, plus a box to name a new one.

        Built with a ListBox rather than a menu model because the entries are
        the library's own names, which change when a save lands — a menu
        model built once would go stale and quietly drop the new playlist.
        """
        pop = Gtk.Popover()
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        box.set_margin_top(10)
        box.set_margin_bottom(10)
        box.set_margin_start(10)
        box.set_margin_end(10)
        box.set_size_request(240, -1)

        head = Gtk.Label(label="SAVE INTO")
        head.set_xalign(0)
        head.add_css_class("rule")
        box.append(head)

        lb = Gtk.ListBox()
        lb.add_css_class("listbox")
        lb.set_selection_mode(Gtk.SelectionMode.NONE)
        for pl in self._library:
            row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
            nm = Gtk.Label(label=pl["name"])
            nm.set_xalign(0)
            nm.set_hexpand(True)
            nm.set_ellipsize(3)
            nm.add_css_class("plname")
            ct = Gtk.Label(label=f"{len(pl['tracks'])}")
            ct.add_css_class("plcount")
            row.append(nm)
            row.append(ct)
            lb.append(row)
            row._pl_name = pl["name"]
        # One handler on the list, not one per row: row-activated delivers the
        # Gtk.ListBoxRow, and the name is read off its child. A per-row
        # "activate" handler is not even connectable here — Gtk.Box has no
        # such signal, and connecting one raises at runtime, not at import.
        lb.connect("row-activated", self._on_playlist_picked, track, pop)
        sw = Gtk.ScrolledWindow()
        sw.set_child(lb)
        sw.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        sw.set_max_content_height(190)
        box.append(sw)

        sep = Gtk.Separator()
        box.append(sep)

        # A playlist that does not exist yet is a normal thing to want, so it
        # is one line away rather than a dialog and a round trip through a
        # separate settings window.
        newrow = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        ent = Gtk.Entry()
        ent.set_hexpand(True)
        ent.set_placeholder_text("New playlist name")
        addb = Gtk.Button(label="Add")
        addb.add_css_class("pbtn")
        addb.connect("clicked",
                     lambda _b: self._on_new_playlist(track, ent.get_text(), pop))
        ent.connect("activate", lambda _e: self._on_new_playlist(
            track, ent.get_text(), pop))
        newrow.append(ent)
        newrow.append(addb)
        box.append(newrow)

        pop.set_child(box)
        button.set_popover(pop)
        return pop

    def _on_playlist_picked(self, _lb, row, track, pop):
        name = getattr(row.get_child(), "_pl_name", "")
        if name:
            self._save_online(track, name)
            pop.popdown()

    def _on_new_playlist(self, track, name, pop):
        name = (name or "").strip()
        if not name:
            self._set_status("A playlist needs a name")
            return
        # The folder is created by the download itself, so nothing has to
        # exist on disk for this name to be valid yet.
        self._save_online(track, name)
        pop.popdown()

    # ── actions ──────────────────────────────────────────────────────────
    def _play_visible_index(self, idx):
        """Play from row `idx`.

        Online rows are NOT queued behind the local ones. Queueing fifty
        remote streams behind a click on a local track would open fifty
        network connections the user did not ask for, and mpv would start
        pre-buffering all of them. So the queue is the local rows, plus the
        one online row that was clicked — which also means the queue index
        has to be recomputed, not reused.
        """
        if not (0 <= idx < len(self._visible)):
            return
        clicked, _pl = self._visible[idx]
        self.mpv.send(["playlist-clear"])
        local, pos, online = [], 0, None
        for i, (t, _pl) in enumerate(self._visible):
            if t.get("load_more"):
                continue
            if t.get("online"):
                if i == idx:
                    online = t
                continue
            if i < idx:
                pos += 1
            local.append(t["path"])
        for p in local:
            self.mpv.send(["loadfile", p, "append-play"])
        if online is not None:
            self.mpv.send(["loadfile", online["path"], "append-play"])
            pos = len(local)
        self.mpv.send(["playlist-play-index", pos])
        self.mpv.send(["set_property", "pause", False])

    # ── saving an online track ──────────────────────────────────────
    def _save_online(self, track, folder=""):
        """Put a found track on the disk, offline.

        `folder` is optional and that is the whole point: omitted means the
        standalone bucket (saved, in no playlist), a name means that playlist,
        created by the download itself. Either way the file lands inside the
        library root, so the next scan makes it an ordinary local track.
        """
        if self._downloading:
            self._set_status("A download is already running")
            return None
        if track.get("load_more"):
            return None
        dest = target_dir(folder)
        name = (f"{sanitize_filename(track.get('artist'))} - "
                f"{sanitize_filename(track.get('title'))}.mp3")
        path = os.path.join(dest, name)
        if self._online_saved.get(track["id"]) == path:
            # Already on disk, exactly there. Refusing is right here: a second
            # curl would rewrite the same bytes over the same file.
            self._set_status(f"Already saved to {os.path.dirname(path)}")
            return path
        # A DIFFERENT destination is a real request and gets a real download:
        # "save it offline" and "put it in this playlist" are two answers to
        # two different questions, and having the first silently cancel the
        # second would be the wrong one.

        self._downloading = track["id"]
        label = os.path.basename(dest) if folder else "Downloads"
        self._set_status(f"Saving “{track['title']}” to {label}…")
        self._rebuild_tracks()          # so the row's buttons go disabled now

        def worker():
            err = download_track(track, path)
            GLib.idle_add(self._save_done, track, path, err)

        threading.Thread(target=worker, daemon=True).start()
        return path

    def _save_done(self, track, path, err):
        self._downloading = ""
        if err:
            self._set_status(err)
        else:
            self._online_saved[track["id"]] = path
            self._set_status(f"Saved to {os.path.dirname(path)}")
            # Re-scan so the new file is a real library entry immediately,
            # and so the playlist it landed in shows the new count.
            self.refresh_library()
        self._rebuild_tracks()

    def _playpause(self, *_):
        self.mpv.send(["cycle", "pause"])

    def _next(self, *_):
        self.mpv.send(["playlist-next", "weak"])

    def _prev(self, *_):
        self.mpv.send(["playlist-prev", "weak"])

    def _on_play_playlist(self, *_):
        self._play_visible_index(0)

    def _on_pl_activated(self, _lb, row):
        name = getattr(row.get_child(), "_pl_name", None)
        if name:
            # clicking a playlist while searching drops back to browsing it:
            # the search covers every playlist, so a card click means "show me
            # this one".
            if self._query:
                self._entry.set_text("")
            self._select_playlist(name)

    def _on_track_activated(self, _lb, row):
        child = row.get_child()
        # The paging row is a plain Gtk.Button, not a track row, and clicking
        # it must page rather than try to play a "song" that has no path.
        if getattr(child, "_load_more_row", False):
            self._load_more()
            return
        idx = getattr(child, "_vis_idx", -1)
        self._play_visible_index(idx)

    # `key-pressed` delivers (controller, keyval, keycode, state) -- the
    # modifier mask is the FOURTH argument and the keycode the third, which
    # is the wrong way round to guess at. Naming them apart from each other
    # is the point: binding "keystate" to the keycode silently makes every
    # Ctrl shortcut unreachable, because a keycode never has Ctrl bits in it.
    def _on_key(self, _controller, keyval, _keycode, state):
        kv = Gdk.keyval_name(keyval)
        ctrl = bool(state & Gdk.ModifierType.CONTROL_MASK)
        if ctrl and kv in ("f", "F"):
            self._entry.grab_focus()
            return True
        if kv == "Escape":
            # Escape clears a search that has something to clear, and is
            # otherwise left to GTK, which blurs the entry and gives the
            # key back to whatever had focus before it.
            if self._query:
                self._entry.set_text("")
                return True
        if kv == "space":
            self._playpause()
            return True
        if kv in ("Right", "Left") and self._state["dur"] > 0:
            d = 10 if kv == "Right" else -10
            self.mpv.send(["seek", d, "relative"])
            return True
        if kv in ("Up", "Down"):
            v = int(max(0, min(100, self._state["volume"]
                               + (5 if kv == "Up" else -5))))
            self._on_volume_from_bar(v)
            return True
        if kv == "n":
            self._next()
            return True
        if kv == "p":
            self._prev()
            return True
        return False

    # ── state from mpv ───────────────────────────────────────────────────
    def _on_mpv(self, d):
        if isinstance(d, bool):  # connection state
            if d:
                # Reconnected: pull the truth immediately rather than waiting
                # for the next poll, and say so. Reporting "offline" and then
                # never reporting "back" is how a window ends up lying about a
                # daemon that never stopped.
                self._set_daemon(True)
                self._poll()
            else:
                self._set_daemon(False)
            return
        if d.get("event") != "property-change":
            return
        name, data = d.get("name"), d.get("data")
        st = self._state
        if name == "pause":
            st["paused"] = bool(data) if data is not None else True
        elif name == "time-pos":
            st["pos"] = float(data or 0)
            st["pos_at"] = time.time()
        elif name == "duration":
            st["dur"] = float(data or 0)
        elif name == "media-title":
            st["title"] = str(data or "")
        elif name == "metadata":
            m = data or {}
            st["artist"] = str(m.get("artist") or m.get("ARTIST") or "")
            al = str(m.get("album") or m.get("ALBUM") or "")
            # The bridge substitutes "Unknown Album" for a track that carries
            # no album tag. Fine for a log, terrible for a card: it reads as
            # a real album called "Unknown Album".
            st["album"] = "" if al.lower() == "unknown album" else al
            t = str(m.get("title") or m.get("TITLE") or "")
            if t:
                st["title"] = t
        elif name == "playlist-pos":
            st["qpos"] = data if data is not None else -1
        elif name == "volume":
            st["volume"] = float(data or 0)
        elif name in ("filename", "path"):
            # `filename` is mpv's BASENAME and `path` is the absolute one.
            # The library is scanned as absolute paths, so joining on
            # `filename` finds nothing and the playing row is never marked --
            # which is why the whole playlist said "no playlist playing"
            # while a track from it was playing. `path` is the join key.
            v = str(data or "")
            if name == "path" or (v and "/" in v):
                st["filename"] = v
        elif name == "idle-active":
            if data:
                st.update(title="", artist="", album="", pos=0.0, dur=0.0,
                          qpos=-1, paused=True, volume=0.0, filename="")
        self._render()

    def _set_daemon(self, up):
        """Track the daemon, and say NOTHING about it in the hero.

        It used to write "Daemon offline" into the title and "starting
        ii-music-mpd…" into the sub-line, so a daemon restart replaced what
        you were listening to with a status message. The hero is for music
        and only music; a daemon that is briefly down leaves an inert player
        and an unseekable bar, which is exactly what it is. The status line
        is kept for things the user did -- a search, a save.
        """
        # Idempotent, because this is polled.
        if up == self._daemon:
            return
        self._daemon = up
        if not up:
            self._bar.set_state(active=False, show_spectrum=False)
        for m in (self._btn_prev, self._btn_play, self._btn_next):
            # A `Mark` is a DrawingArea, so it has no `set_sensitive`. The
            # island's answer to "cannot do this yet" is a DIMMED mark rather
            # than a hidden one, which here is a CSS class.
            m.set_opacity(1.0 if up else 0.4)
            m.set_sensitive(up)

    # ── position: interpolated, not read ──────────────────────────────────
    #
    # mpv only reports `time-pos` when it changes, so reading it leaves the
    # scrubber frozen between reports -- which is exactly the "the bar does
    # not fill up" complaint. The value on screen is therefore the last thing
    # mpv actually said plus the wall time since, re-anchored from mpv on
    # every poll, so the worst case is one poll of drift rather than a whole
    # track.
    def _display_position(self):
        st = self._state
        if st["paused"] or st["dur"] <= 0:
            return st["pos"]
        drift = time.time() - st.get("pos_at", 0)
        # Only extrapolate across a short, trustworthy interval. If the stamp
        # is old the poll was not running and adding all that time in one go
        # is a guess.
        if drift > 1.5:
            return st["pos"]
        # never past the end: a missing or wrong duration would let the bar
        # run off the right-hand edge
        return min(st["dur"], st["pos"] + drift)

    def _seek_to_fraction(self, f):
        """Seek to a fraction of the track, sent once per gesture.

        Nothing is sent while the pointer is down: a drag across the bar must
        not fire a seek per motion event, which makes the player stutter and
        queue dozens of seeks behind the gesture.
        """
        st = self._state
        if st["dur"] <= 0:
            return
        target = max(0.0, min(1.0, f)) * st["dur"]
        self._last_seek_touch = time.time()
        self.mpv.send(["seek", round(target, 2), "absolute"])
        st["pos"] = target
        st["pos_at"] = time.time()
        self._render()

    def _on_volume_from_bar(self, level):
        self.cfg["volume"] = level
        self.mpv.send(["set_property", "volume", level])
        self._persist()

    def _poll(self):
        """Ask mpv for everything the card draws.

        250ms while something is playing, 1s when it is not: the bar has to
        move smoothly, and a five-second poll is the other half of why it did
        not.

        The connection flag is read from `send`'s own truth rather than from
        the push notification. The notification is missed entirely when the
        socket is ALREADY up at startup -- `_connect()` notifies `handlers`,
        and the window appends its handler after the reader thread is already
        running, so the one "we are connected" message can be delivered to
        nobody and the hero then says "Daemon offline" forever against a
        daemon that never stopped.
        """
        self._set_daemon(self.mpv.daemon_up)
        def gp(prop, key, conv, default=None):
            def cb(data):
                if data is None:
                    return
                st = self._state
                st[key] = conv(data)
                if key == "pos":
                    st["pos_at"] = time.time()
            self.mpv.send(["get_property", prop], cb)

        gp("pause", "paused", bool, True)
        gp("time-pos", "pos", float, 0.0)
        gp("duration", "dur", float, 0.0)
        gp("media-title", "title", str, "")
        gp("playlist-pos", "qpos", int, -1)
        gp("volume", "volume", float, 0.0)
        gp("path", "filename", str, "")

        def on_meta(data):
            m = data or {}
            if m:
                self._on_mpv({"event": "property-change",
                              "name": "metadata", "data": m})
        self.mpv.send(["get_property", "metadata"], on_meta)

        self._render()
        return True

    def _mark_playing(self):
        """Exactly one row carries the accent, and only while the marked path
        still lines up with the rows on screen.

        Deliberately NOT driven by the queue index: the queue can be shuffled,
        filtered, or hold tracks from several folders, so an index into it
        says nothing about which row of WHICH playlist is playing. The join is
        the file path, which is what the card uses too.
        """
        marked = self.marked_path
        target = None
        if marked and not self._query:
            for row, (t, _pl) in zip(self._rows, self._visible):
                if getattr(row, "_load_more_row", False):
                    continue
                if t.get("path") == marked:
                    target = row
                    break
        if target is self._play_row:
            self._paint_marker()
            return
        if self._play_row is not None:
            self._play_row.remove_css_class("current")
            marker = getattr(self._play_row, "_marker", None)
            if marker is not None:
                marker.set_visible(False)
            slot = getattr(self._play_row, "_numslot", None)
            if slot is not None:
                meter = [c for c in kids(slot) if "meter" in c.get_css_classes()]
                if meter:
                    slot.remove(meter[0])
                    n = Gtk.Label(label=f"{self._play_row._vis_idx + 1}")
                    n.add_css_class("rownum")
                    slot.append(n)
        self._play_row = None
        if target is not None:
            target.add_css_class("current")
            marker = getattr(target, "_marker", None)
            if marker is not None:
                marker.set_visible(True)
            # The meter takes the number's place rather than being drawn over
            # it: a row is either numbered or metered, never both, which is
            # what the card does too.
            slot = getattr(target, "_numslot", None)
            if slot is not None:
                metered = [c for c in kids(slot)
                           if "meter" in c.get_css_classes()]
                if not metered:
                    for c in kids(slot):
                        slot.remove(c)
                    slot.append(self._meter())
            self._play_row = target
        self._paint_marker()

    @staticmethod
    def _plain_num(idx):
        n = Gtk.Label(label=f"{idx + 1}")
        n.add_css_class("rownum")
        return n

    def _paint_marker(self):
        """The play/pause badge laid over the playing row's cover."""
        row = self._play_row
        marker = getattr(row, "_marker", None) if row is not None else None
        if marker is None:
            return
        # Gtk.Image has no set_icon_name in this binding -- the setter is
        # set_from_icon_name. (Gtk.Button does have set_icon_name, which is
        # why the transport marks get away with it.)
        marker.set_from_icon_name(
            "media-playback-pause-symbolic" if not self._state["paused"]
            else "media-playback-start-symbolic")

    def _render(self):
        st = self._state
        playing = self._daemon and st["dur"] > 0 and not st["paused"] \
            and st["title"] != ""
        self._btn_play.set_playing(not st["paused"])

        # The title line. "Nothing playing" rather than a blank, because a
        # blank hero reads as a broken one.
        self._lbl_title.set_text(st["title"] or "Nothing playing")

        # The playlist, and the album when it says anything new. This is the
        # only thing on the screen that answers "why is the next track that
        # one", so it is worth the line -- and it is hidden rather than
        # filled with a placeholder when there is nothing to say.
        pl = self._derive_playlist()
        sub = self._subline(pl["name"] if pl else "", st.get("album", ""))
        if sub == "":
            sub = st.get("artist", "")
        self._lbl_artist.set_text(sub)
        self._lbl_artist.set_visible(sub != "")

        # the bar
        self._bar.set_state(
            position=self._display_position(),
            duration=st["dur"],
            volume=st["volume"],
            active=self._daemon and st["dur"] > 0,
            show_spectrum=playing)

        # Durations for whatever playlist just became the one on screen. Only
        # when it CHANGES: this runs four times a second, and measuring 45
        # tracks every time would be absurd.
        pl = self._derive_playlist()
        if pl is not None and pl is not self._measured_playlist:
            self._measured_playlist = pl
            self._ensure_durations(pl)

        # cover art: the file that is playing, through the shared cache
        fn = st.get("filename", "")
        if fn != self._cover_key:
            self._cover_key = fn
            self._cover_current(fn)
        self._mark_playing()

    def _cover_current(self, fn):
        if not fn:
            set_cover_image(self._cover, self._coverph, None)
            return
        COVERS.request(fn, self._apply_cover)

    def _apply_cover(self, art_path):
        set_cover_image(self._cover, self._coverph, art_path)


# One time format, one function. An alias rather than a second implementation
# so the now-playing stamps and the bar's stamps cannot drift apart.
fmt_time = clock


class MusicApp(Adw.Application):
    """Single-instance app whose window can hide without the app dying.

    The application_id puts it on the session bus, which is what makes the
    second launch reuse this process instead of starting a rival: activate is
    then delivered to the running instance, which just re-presents its window.
    """

    def __init__(self):
        super().__init__(application_id=APP_ID,
                         flags=Gio.ApplicationFlags.HANDLES_COMMAND_LINE)

    def do_command_line(self, cmdline):
        # Every launch ends here, including the remote one that a second
        # `ii-music-app` produces: bring the existing window back rather than
        # letting the new invocation start its own.
        self.activate()
        win = self.props.active_window
        if win is not None:
            win.present()
        return 0

    def do_startup(self, *args):
        # Register with the shell's background-apps tray before any window
        # exists, so the entry is there from the moment the app is running.
        Adw.Application.do_startup(self, *args)
        # The palette is a fixed dark ramp, so the app is dark regardless of
        # the system's light/dark preference — the same choice every other
        # app in the tray makes.
        Adw.StyleManager.get_default().set_color_scheme(
            Adw.ColorScheme.FORCE_DARK)
        publish_presence()
        self._install_term_handler()

    def _install_term_handler(self):
        """Clean up the registry when the app is terminated by signal.

        The tray's Quit action sends SIGTERM, and a default SIGTERM just kills
        the process: GApplication's shutdown never runs, so the presence file
        would be left behind pointing at a dead pid. The shell's registry does
        drop such a stale file, so this is tidiness rather than correctness --
        but an entry that outlives its app is exactly the kind of phantom that
        makes a "what is running?" list untrustworthy, so it is worth the three
        lines to not create one.

        Handing the cleanup to the main loop's idle queue (rather than doing it
        inline) lets the process finish exiting first.
        """
        try:
            import signal
            from gi.repository import GLibUnix
        except Exception:
            # No signal support here: the registry's stale-file check is the
            # backstop, so this is not fatal.
            return

        def on_term():
            # Cleanup on the idle queue, so it runs as the process winds down
            # rather than in the middle of the signal delivery.
            GLib.idle_add(clear_presence)
            self.quit()
            return False

        for sig in (signal.SIGTERM, signal.SIGINT):
            try:
                GLibUnix.signal_add(GLib.PRIORITY_HIGH, sig, on_term)
            except Exception:
                pass

    def do_activate(self):
        win = self.props.active_window
        if win is None:
            win = MusicWindow(self)
        win.present()

    def do_shutdown(self, *args):
        # A real quit: leave the registry, but do NOT touch playback — the
        # daemon is a separate service and the song must survive the UI.
        clear_presence()
        # Chain up: a GApplication vfunc override that does not is a
        # GLib-GIO-CRITICAL, and the base shutdown is what actually tears the
        # process down.
        Adw.Application.do_shutdown(self, *args)


def main():
    app = MusicApp()
    return app.run(None)


if __name__ == "__main__":
    sys.exit(main())