[Unit]
Description=Bind NVIDIA Dynamic Boost to the power profile (balanced/performance = 115 W)
After=default.target
PartOf=default.target

[Service]
Type=simple
# Apply once on start, then re-apply on every power-profile change.
ExecStart=/bin/bash -c '%h/.local/bin/ppd-nvidia-boost; stdbuf -oL gdbus monitor --system --dest org.freedesktop.UPower.PowerProfiles --object-path /org/freedesktop/UPower/PowerProfiles | grep --line-buffered ActiveProfile | while IFS= read -r _; do %h/.local/bin/ppd-nvidia-boost; done'
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
