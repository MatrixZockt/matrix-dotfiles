# "light_warm"/"light_cool" derive from "light"; backfill anything a sheet
# forgot from the base light sheet so a token can never resolve missing.
for _n in ("light_warm", "light_cool"):
    THEME_TOKENS[_n] = {**THEME_TOKENS["light"], **THEME_TOKENS[_n]}


_token_provider = None


def apply_token_css(tokens):
    """Load @rcc_* tokens as a CSS provider.

    Priority sits BETWEEN libadwaita's defaults and the app layout CSS so
    the tokens win over theme defaults but the layout rules (which only
    reference tokens) still apply on top. Re-loading on every theme change
    replaces the values in place.
    """
    global _token_provider
    lines = "\n".join(f"@define-color rcc_{k} {v};" for k, v in tokens.items())
    if _token_provider is None:
        _token_provider = Gtk.CssProvider()
        Gtk.StyleContext.add_provider_for_display(
            Gdk.Display.get_default(), _token_provider,
            Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION - 1)
    try:
        _token_provider.load_from_data(lines.encode(), -1)
    except Exception as e:
        print("token CSS failed:", e, file=sys.stderr)


# cairo-side theme mirror. Kept as a module dict, not globals, so the draw
# functions can read one stable object and the theme swap is atomic.
CAIRO_THEME = {}

# The token sheet currently in force. apply_theme() sets this; token_color()
# reads it, because Pango markup needs a literal colour string and so
# cannot resolve @rcc_* itself.
CURRENT_SHEET = {}


def _css_color(v):
    """Parse a token value into an (r, g, b, a) float tuple for cairo.

    Handles the three forms the sheets use: #rrggbb, rgba(r, g, b, a) and
    alpha(#rrggbb, a). Anything unparsable returns opaque black rather than
    raising -- a theme bug must never take the draw path down.
    """
    v = (v or "").strip()
    try:
        if v.startswith("#"):
            h = v[1:]
            return (int(h[0:2], 16) / 255.0, int(h[2:4], 16) / 255.0,
                    int(h[4:6], 16) / 255.0, 1.0)
        if v.startswith("alpha("):
            inner = v[6:-1]
            hexpart, ap = inner.split(",")
            t = _css_color(hexpart.strip())
            return (t[0], t[1], t[2], float(ap.strip()))
        if v.startswith("rgba("):
            parts = [p.strip() for p in v[5:-1].split(",")]
            return (float(parts[0]) / 255.0, float(parts[1]) / 255.0,
                    float(parts[2]) / 255.0, float(parts[3]))
    except (ValueError, IndexError):
        pass
    return (0.0, 0.0, 0.0, 1.0)


def ctheme(name, fallback):
    """CAIRO_THEME[name], or a sheet-derived fallback, never a literal.

    The draw code used to spell its fallbacks inline -- (1, 1, 1, 0.30) for
    the hover ring, (0.96, 0.96, 0.96) for the gauge number. Those are dark
    sheet values: in a light theme a missing token silently became white
    ink on a white board. When the sheet has no answer, use its `ink`
    (tinted by the caller's alpha) instead, which is light on dark and
    dark on light by construction.
    """
    v = CAIRO_THEME.get(name)
    if v is not None:
        return v
    ink = CAIRO_THEME.get("ink") or CAIRO_THEME.get("gauge_text")
    if ink is None:
        return fallback
    if len(fallback) == 4:
        return (ink[0], ink[1], ink[2], fallback[3])
    return ink


def token_color(name, fallback):
    """A token as a string Pango markup can use, e.g. "#e8e8e8".

    Pango does not read CSS tokens or the alpha() form, so anything handed
    to a markup span has to be a literal colour -- which is exactly how a
    hardcoded near-white ended up painted on a light rail. This resolves
    through the sheet instead, so the span follows the theme.
    """
    v = CURRENT_SHEET.get(name)
    if v:
        c = _css_color(v)
        return "#%02x%02x%02x" % (round(c[0] * 255), round(c[1] * 255),
                                  round(c[2] * 255))
    return fallback


def sync_cairo_theme(tokens):
    """Hand the same sheet to the cairo draw code (board, gauges).

    Everything is pre-parsed to numeric tuples so the per-frame draw path
    does no string work at all.
    """
    def rgb(name):
        t = _css_color(tokens[name])
        return (t[0], t[1], t[2])

    def rgba(name):
        return _css_color(tokens[name])

    CAIRO_THEME.clear()
    CAIRO_THEME.update(
        board_bg=rgb("board_bg"),
        keycap=rgb("keycap"), keycap_hover=rgb("keycap_hover"),
        keycap_edge=rgba("keycap_edge"),
        gauge_text=rgb("gauge_text"), gauge_sub=rgba("gauge_sub"),
        gauge_track=rgba("gauge_track"), gauge_accent=rgb("gauge_accent"),
        hover_line=rgba("hover_line"),
        unlit_label=rgba("unlit_label"),
        # Board chrome that used to be a hardcoded near-white: the hover
        # ring, the marquee tint and its edge.
        hover_ring=rgba("hover_ring"),
        marquee_fill=rgba("marquee_fill"),
        marquee_edge=rgba("marquee_edge"),
        # The sheet's own ink. ctheme() falls back to THIS rather than to a
        # white literal, so a token the draw code asks for but the sheet
        # does not define resolves to a colour that is visible on the
        # sheet's background instead of white-on-white in light mode.
        ink=rgb("ink"), ink_faint=rgba("ink_faint"),
        # Drives the label-ink direction: on a light keycap a bright LED
        # colour is unreadable, so ink is darkened instead of lifted.
        keycap_is_light=sum(rgb("keycap")) / 3 > 0.6,
    )
