# ── async plumbing ───────────────────────────────────────────────────────────

def bg(fn, done):
    def worker():
        try:
            result = fn()
        except Exception as e:  # noqa: BLE001
            result = ("error", str(e))
        GLib.idle_add(lambda: (done(result), GLib.SOURCE_REMOVE)[1])
    threading.Thread(target=worker, daemon=True).start()


def run(*cmd, check=False):
    try:
        p = subprocess.run(cmd, capture_output=True, text=True, check=check)
        return p.returncode == 0, (p.stdout or p.stderr or "").strip()
    except FileNotFoundError:
        return False, f"not installed: {cmd[0]}"


def read(path, default=""):
    try:
        with open(path) as f:
            return f.read().strip()
    except OSError:
        return default


# ── II config: persistent store for long-idle + misc ────────────────────────

def read_ii():
    try:
        with open(II_CONFIG) as f:
            return json.load(f)
    except Exception:
        return {}


def write_ii(cfg):
    try:
        with open(II_CONFIG, "w") as f:
            json.dump(cfg, f, indent=2)
            f.write("\n")
        return True
    except OSError:
        return False


def long_idle_state():
    b = read_ii().get("battery", {})
    try:
        minutes = int(b.get("longIdleMinutes", 10))
    except (TypeError, ValueError):
        minutes = 10
    return (bool(b.get("longIdleEnabled", False)),
            min(max(minutes, 1), 120),
            bool(b.get("longIdleSuspend", False)))


def set_long_idle_state(enabled=None, minutes=None, suspend=None):
    cfg = read_ii()
    b = cfg.setdefault("battery", {})
    cur_en, cur_min, cur_susp = long_idle_state()
    b["longIdleEnabled"] = cur_en if enabled is None else bool(enabled)
    b["longIdleMinutes"] = cur_min if minutes is None else int(minutes)
    b["longIdleSuspend"] = (cur_susp if suspend is None else bool(suspend))
    return write_ii(cfg)


def kbd_autodim_state():
    b = read_ii().get("battery", {})
    return (bool(b.get("kbdAutoDim", False)),
            int(b.get("kbdDayBrightness", 35)),
            int(b.get("kbdDayStart", 8)),
            int(b.get("kbdDayEnd", 18)))


def set_kbd_autodim(enabled=None, day_brightness=None,
                    day_start=None, day_end=None):
    cfg = read_ii()
    b = cfg.setdefault("battery", {})
    en, db, ds, de = kbd_autodim_state()
    b["kbdAutoDim"] = en if enabled is None else bool(enabled)
    b["kbdDayBrightness"] = (max(0, min(100, db)) if day_brightness is None
                              else max(0, min(100, int(day_brightness))))
    b["kbdDayStart"] = ds if day_start is None else max(0, min(23,
                                                            int(day_start)))
    b["kbdDayEnd"] = de if day_end is None else max(1, min(24,
                                                          int(day_end)))
    return write_ii(cfg)


def in_day_window(now=None):
    """Is 'now' inside the configured daylight window?"""
    _en, _db, ds, de = kbd_autodim_state()
    hour = now if now is not None else time.localtime().tm_hour
    return ds <= hour < de


def day_cap_active():
    """The cap is switched ON and the clock is inside its window."""
    enabled, _db, _ds, _de = kbd_autodim_state()
    return enabled and in_day_window()


def clear_kbd_lock():
    """Housekeeping: drop any legacy stored lock keys from older builds."""
    cfg = read_ii()
    b = cfg.get("battery", {})
    if not any(k in b for k in ("kbdLockLevel", "kbdLockHourStart",
                                "kbdLockHourEnd", "kbdLockDay")):
        return None
    for k in ("kbdLockLevel", "kbdLockHourStart", "kbdLockHourEnd",
              "kbdLockDay"):
        b.pop(k, None)
    write_ii(cfg)
    return None


def autodim_tick():
    """Enforce the day cap: inside the window the keyboard is held at the
    CONFIGURED day level (kbdDayBrightness); the tick re-applies it against
    anything that moved it since. Outside the window, or with the cap off,
    nothing is enforced — the brightness bar's own value is the user's to
    command again. Returns the applied level or None."""
    enabled, day_pct, ds, de = kbd_autodim_state()
    if not enabled:
        return clear_kbd_lock()
    hour = time.localtime().tm_hour
    if not (ds <= hour < de):
        return clear_kbd_lock()
    cur = kbd_get_brightness("main")
    if cur is not None and cur != day_pct:
        kbd_set_brightness("main", day_pct)
    return day_pct


# ── fan control ─────────────────────────────────────────────────────────────
#
# Two levers on this machine:
#   cooling_device1  "Fan"    the legacy 2-state boost switch (max_state=1)
#   cooling_device0  "TFN1"   the fine-grained fan device (max_state=50):
#                             the same lever Synapse's slider drives on
#                             Windows. Writes are accepted and persist;
#                             reads are not (blind write, but the EC still
#                             overrides at critical heat).

FAN_BOOST_CUR = "/sys/class/thermal/cooling_device1/cur_state"
FAN_LEVEL_CUR = "/sys/class/thermal/cooling_device0/cur_state"
FAN_LEVEL_MAX = 50

# ── the lever that ACTUALLY works: CPU package power ────────────────────────
#
# The ACPI fan level above is accepted by the kernel and then ignored by the
# embedded controller. Measured on this machine, holding level 12 (25 %) vs
# level 45 (90 %) at 10 Hz through a full minute of identical 32-thread load
# moved the settled package temperature by 0.7 C. Writing nothing at all and
# writing the maximum at 10 Hz are the same temperature to within 1 C. So the
# fan is entirely firmware-owned, and every "fan mode" this app used to offer
# was, on this hardware, a number with nothing behind it.
#
# The EC's curve tracks temperature, so the way to make the machine quiet is
# to stop making heat. Same load, measured through the real helper:
#
#     vendor limits   120 W / 160 W         92.3 C   (fan ramped)
#     quiet            35 W /  45 W         65.4 C   (fan near idle)
#     battery saver    20 W /  30 W, no TB  58.6 C
#
# That 27 C is the whole difference between quiet and loud, and unlike the
# fan level it is enforced in silicon, so nothing can take it back.


def _rapl_dir():
    """The package RAPL domain, discovered rather than assumed."""
    base = "/sys/class/powercap"
    try:
        names = sorted(os.listdir(base))
    except OSError:
        return None
    for n in names:
        if n.startswith("intel-rapl:") and n.count(":") == 1:
            if read(os.path.join(base, n, "name")) == "package-0":
                return os.path.join(base, n)
    for n in names:
        if "rapl" in n and n.count(":") == 1:
            return os.path.join(base, n)
    return None


def _rapl_paths():
    """(pl1, pl2) writable limit files, or (None, None)."""
    d = _rapl_dir()
    if not d:
        return None, None
    return d + "/constraint_0_power_limit_uw", d + "/constraint_1_power_limit_uw"


NO_TURBO_PATH = "/sys/devices/system/cpu/intel_pstate/no_turbo"

# mode -> (pl1_w, pl2_w, turbo_allowed), or None for "leave the vendor's".
#
# Automatic deliberately restores the shipping limits instead of capping:
# "automatic" has to mean "the machine decides", which is the vendor's own
# curve and the vendor's own power limits. That is also why the vendor values
# are captured and persisted before anything overwrites them -- once capped,
# they are unrecoverable from the running system.
FAN_POWER_POLICY = {
    "quiet":   (35, 45, True),
    "battery": (20, 30, False),
    "default": None,
    "noisy":   None,
    "manual":  None,
}

# The ACPI fan device that owns TFN1. Its sysfs directory -- not the
# cooling_device directory -- carries the performance-state table
# (state0..stateN), fine_grain_control and fan_speed_rpm. Read from
# /sys/class/thermal/cooling_device0/device's parent, so the path follows
# the device instead of being hardcoded.
FAN_ACPI_DEVICE = "INTC10A2:00"


def _fan_acpi_dir():
    dev = os.path.realpath("/sys/class/thermal/cooling_device0/device")
    # .../PNP0C09:01/INTC10A2:00 -- the leaf component is the ACPI id.
    leaf = os.path.basename(dev)
    p = "/sys/bus/acpi/devices/" + leaf
    return p if os.path.isdir(p) else None


def fan_states():
    """[(cur_state, percent, rpm)] parsed from the ACPI performance states.

    Measured on this machine (INTC10A2:00, fine_grain_control=1):

        state0   0%       0 RPM      <- OFF
        state1  25%    3200 RPM      <- lowest speed the fan is defined at
        state2  30%    3800
        state3  40%    5100
        state4  50%    6300
        state5  60%    7400
        state6  70%    9300
        state7  80%    9800
        state8  85%   10500
        state9  90%   11200
        state10 95%   11600
        state11 100%  12000

    This answers the question the slider could never answer: level 0 is
    0 PERCENT, i.e. the fan switched OFF, not "the quietest setting". The
    machine then runs to 100 C and the firmware's own thermal control
    brings the fan in at full -- which is exactly what "0 makes the fan
    go to 100% for no reason" was.

    fine_grain_control=1 means cur_state is a percentage in 2% steps up to
    max_state=50, so any level between two states above is interpolated.
    """
    d = _fan_acpi_dir()
    if not d:
        return []
    out = []
    try:
        names = os.listdir(d)
    except OSError:
        return []
    for n in names:
        if not (n.startswith("state") and n[5:].isdigit()):
            continue
        raw = read(os.path.join(d, n), "")
        if not raw:
            continue
        parts = raw.split(":")
        if len(parts) < 3:
            continue
        try:
            pct = float(parts[0])
            rpm = float(parts[2])
        except ValueError:
            continue
        # stateN is an INDEX into the table, not the percent.
        out.append((int(n[5:]), pct, int(rpm)))
    out.sort()
    return out


def fan_rpm_for(level):
    """The RPM a cur_state corresponds to, or None.

    fine_grain_control=1 means every cur_state is a real, drivable speed
    and the performance states are only ANCHORS, so the value is linearly
    interpolated between the two states that bracket the requested
    percent. Snapping to the nearest lower state (the obvious first
    implementation) reported "0 RPM" for level 12, which is 24% and
    therefore about 3100 RPM -- the fan is not off there, it is turning.

    This is a claim about the table, never a measurement: fan_speed_rpm on
    this machine reports 4294967295 (the EC publishes no feedback) and
    hwmon/fan1_input reads ENODEV.
    """
    states = fan_states()
    if not states:
        return None
    max_state = int(read("/sys/class/thermal/cooling_device0/max_state",
                         str(FAN_LEVEL_MAX)) or FAN_LEVEL_MAX)
    pct = 100.0 * float(level) / max_state if max_state else 0.0
    if pct <= 0:
        return 0
    lo = hi = None
    for _idx, p, rpm in states:
        if p <= pct:
            lo = (p, rpm)
        elif hi is None:
            hi = (p, rpm)
    if lo is None:
        return hi[1] if hi else None
    if hi is None:
        return lo[1]
    if hi[0] == lo[0]:
        return lo[1]
    span = hi[0] - lo[0]
    return int(round(lo[1] + (hi[1] - lo[1]) * (pct - lo[0]) / span))


def fan_state():
    """(boosted, available) — the legacy 2-state boost switch."""
    raw = read(FAN_BOOST_CUR)
    if raw == "":
        return False, False
    return raw != "0", True


ELEVATE = "/usr/local/sbin/razer-cc-elevate"


def fan_set(boosted):
    ok, out = run("pkexec", ELEVATE, "fan", "1" if boosted else "0")
    return ok, ("" if ok else out or "pkexec denied")


def fan_level_set(level):
    """Pin the TFN1 fan device to a fixed level (0-50). Blind write."""
    ok, out = run("pkexec", ELEVATE, "fanlevel", str(int(level)))
    return ok, ("" if ok else out or "pkexec denied")


def pwr_state():
    """(pl1_w, pl2_w, turbo_allowed) live from sysfs, or (None, None, None).

    Readable without privilege, which is what lets the UI -- and the
    once-a-tick re-assertion -- see whether the cap is still in force
    without spawning a single process.
    """
    p1, p2 = _rapl_paths()
    if not p1:
        return None, None, None
    try:
        pl1 = int(read(p1, "0") or 0) // 1000000
        pl2 = int(read(p2, "0") or 0) // 1000000
    except ValueError:
        return None, None, None
    if pl1 <= 0 or pl2 <= 0:
        return None, None, None
    nt = read(NO_TURBO_PATH, "")
    turbo = None if nt == "" else (nt != "1")
    return pl1, pl2, turbo


def pwr_apply(pl1, pl2, turbo):
    """Set the CPU package power cap through the elevated helper."""
    ok, out = run("pkexec", ELEVATE, "pwrlimit",
                  str(int(pl1)), str(int(pl2)), "1" if turbo else "0")
    return ok, ("" if ok else out or "pkexec denied")


def pwr_vendor_defaults():
    """(pl1_w, pl2_w, turbo_allowed) the machine ships with, captured once.

    Persisted the first time the app runs, because the only way to restore
    the vendor limits is to remember them before anything overwrote them --
    the running system cannot tell you what they used to be.

    The capture is refused if the live values are already one of our caps.
    That can only happen if the very first run of this version started with
    a cap already applied by something else, and in that case "the vendor
    default" would be a lie, so it is better to have nothing to restore to
    than to persist a wrong number as the truth.
    """
    b = read_ii().get("battery", {})
    saved = b.get("powerDefaults")
    if isinstance(saved, (list, tuple)) and len(saved) == 3:
        try:
            return int(saved[0]), int(saved[1]), bool(saved[2])
        except (TypeError, ValueError):
            pass
    live = pwr_state()
    if live[0] is None:
        return None
    ours = {(p[0], p[1], p[2]) for p in FAN_POWER_POLICY.values() if p}
    if live in ours:
        return None
    cfg = read_ii()
    cfg.setdefault("battery", {})["powerDefaults"] = [
        live[0], live[1], 1 if live[2] else 0]
    write_ii(cfg)
    return live


def pwr_enforce():
    """Re-assert the saved mode's cap if it has drifted off. Cheap.

    The RAPL limits are enforced in silicon and survive everything short of
    a reboot, so this is not a re-write loop -- it reads two sysfs files and
    does nothing at all unless something else has moved them (a power tool,
    a profile switch, a reboot). An idle desktop therefore spawns nothing.
    """
    mode, _lvl = fan_mode_state()
    pol = FAN_POWER_POLICY.get(mode)
    target = pol if pol is not None else pwr_vendor_defaults()
    if target is None:
        return False
    live = pwr_state()
    if live[0] is None:
        return False
    if live[2] is None:
        same = (live[0], live[1]) == (target[0], target[1])
    else:
        same = (live[0], live[1], 1 if live[2] else 0) == \
               (target[0], target[1], 1 if target[2] else 0)
    if same:
        return False
    ok, _err = pwr_apply(*target)
    return ok


def fan_mode_state():
    """(mode, manual_level) from config.json.

    mode: quiet|battery|default|noisy|manual.
    """
    b = read_ii().get("battery", {})
    mode = b.get("fanMode", "default")
    if mode not in ("quiet", "battery", "default", "noisy", "manual"):
        mode = "default"
    try:
        lvl = int(b.get("fanManualLevel", 0))
    except (TypeError, ValueError):
        lvl = 0
    return mode, min(max(lvl, 0), FAN_LEVEL_MAX)


def set_fan_mode_state(mode=None, level=None):
    cfg = read_ii()
    b = cfg.setdefault("battery", {})
    cur_mode, cur_lvl = fan_mode_state()
    b["fanMode"] = cur_mode if mode is None else mode
    b["fanManualLevel"] = cur_lvl if level is None else int(level)
    return write_ii(cfg)


def fan_level_read():
    """Last level WE applied to the TFN1 device, or None.

    cooling_device0/cur_state is WRITE-ONLY on this machine: reading it
    returns EINVAL (the acpi-fan driver accepts the write and refuses the
    read-back). The old code still tried to read it, so every level came
    back empty and the UI could never show what was actually set. The last
    applied value is therefore tracked here and persisted, which is the
    only truthful answer available on this hardware.
    """
    lvl = read_ii().get("battery", {}).get("fanAppliedLevel", None)
    try:
        return min(max(int(lvl), 0), FAN_LEVEL_MAX)
    except (TypeError, ValueError):
        return None


def fan_apply_mode():
    """Push the saved fan mode to the hardware.

    A mode is two things here, and only one of them does anything:

      * THE PACKAGE POWER CAP, which works. The EC's fan curve responds to
        temperature, so the only way to make the machine quiet is to stop
        making heat. Measured on this machine, identical 32-thread load:
             vendor 120 W / 160 W   92.3 C
             quiet   35 W /  45 W   65.4 C
             battery 20 W /  30 W   58.6 C (turbo off)
        That gap is the difference between the firmware ramping the fan and
        the fan sitting near idle, which is the noise that is actually heard.

      * THE ACPI FAN LEVEL, which does not work, and is kept only so that a
        firmware that starts honouring it gets the right value. Measured:
        holding level 12 vs 45 at 10 Hz through a minute of identical load
        moved the settled temperature by 0.7 C. The embedded controller
        ignores _FSL; there is no RPM feedback either (fan_speed_rpm reads
        -1, hwmon fan1_input ENODEV), so the OS cannot observe the fan, let
        alone command it. The level write is therefore a REQUEST.

    quiet    - 35 W cap, turbo allowed: quiet without losing burst speed.
    battery  - 20 W cap, turbo off: longest runtime, coolest, quietest.
    default  - Automatic: vendor limits restored, no fan level pinned.
    noisy    - vendor limits: maximum performance, and so the loudest fan.
    manual   - vendor limits plus the slider level as a request.

    The legacy 2-state boost switch (Fan, 0|1) is a different device and
    is not what the level drives; it is only cleared so a stale firmware
    boost is not fighting the level.
    """
    mode, lvl = fan_mode_state()
    # Capture the vendor limits BEFORE anything can overwrite them: this is
    # the only moment they are still the vendor's own numbers.
    pwr_vendor_defaults()

    # Always clear a stale firmware boost first -- that device really is a
    # switch with a defined off position, unlike the level.
    fan_set(False)

    # 1. The lever that works: how much heat the CPU is allowed to make.
    pol = FAN_POWER_POLICY.get(mode)
    target_pwr = pol if pol is not None else pwr_vendor_defaults()
    ok_pwr, err_pwr = (True, "")
    if target_pwr is not None:
        ok_pwr, err_pwr = pwr_apply(*target_pwr)

    # 2. The lever that does not, kept honest: only pin a level when the mode
    #    asks for one, and never present it as something the hardware obeys.
    cfg = read_ii()
    b = cfg.setdefault("battery", {})
    if mode == "default":
        # Nothing is pinned, so forget the last pinned level too -- leaving
        # a stale number in the store is what made the UI claim a level the
        # hardware was not actually held at.
        b["fanAppliedLevel"] = None
        write_ii(cfg)
        return ok_pwr, err_pwr

    target = {"quiet": 12, "noisy": 45, "manual": lvl}.get(mode, 0)
    ok, err = fan_level_set(target)
    b["fanAppliedLevel"] = target if ok else b.get("fanAppliedLevel", 0)
    write_ii(cfg)
    return (ok_pwr and ok), (err_pwr or err)


_CPU_TEMP = {"path": None, "hist": []}

# Median window for the temperature reading. The raw coretemp value on
# this machine is not trustworthy sample-to-sample: measured at 250 ms
# intervals it sits at ~56 C, then reports 94 C and 85 C for exactly one
# second at a time before dropping straight back. A 38 C jump and full
# recovery inside 250 ms is not thermal behaviour, it is a bad sample from
# the EC/driver, and the old code showed it verbatim -- so the app would
# report 94 C on a machine that is physically cool, which is exactly the
# "says hot but isn't" symptom. Sampling every 5 s meant roughly one in
# five refreshes caught a glitch.
#
# A median over the last five samples discards an isolated spike entirely
# while still tracking genuinely sustained heat, which is what a
# temperature readout is for.
_CPU_TEMP_HISTORY = 5
_CPU_TEMP_WINDOW = 25.0   # seconds of samples the median is taken over
_CPU_TEMP_MIN = 20.0      # °C; below this a "reading" is a bad read
_CPU_TEMP_MAX = 115.0     # °C; above this a "reading" is a bad read


def _coretemp_path():
    """Locate the coretemp 'Package id' input by NAME, not by hwmon index.

    The old code hardcoded hwmon8. Those numbers are assigned in driver
    probe order, not by device identity: a kernel update, a DKMS rebuild
    or simply a different load order renumbers them, and the app would then
    silently read some other sensor (an NVMe drive, a DIMM) and report its
    temperature as the CPU's. Resolving by name cannot go wrong that way.
    """
    if _CPU_TEMP["path"] and os.path.exists(_CPU_TEMP["path"]):
        return _CPU_TEMP["path"]
    base = "/sys/class/hwmon"
    try:
        entries = os.listdir(base)
    except OSError:
        return None

    def num(d):
        return int(d[5:]) if d.startswith("hwmon") and d[5:].isdigit() else -1

    fallback = None
    for dev in sorted(entries, key=num):
        p = os.path.join(base, dev)
        try:
            if open(p + "/name").read().strip() != "coretemp":
                continue
        except OSError:
            continue
        # Prefer an explicitly labelled package input; a hybrid part can
        # expose several, and only the package one is the number a user
        # means by "CPU temperature".
        for i in range(1, 8):
            t = os.path.join(p, "temp%d_input" % i)
            if not os.path.exists(t):
                continue
            try:
                lbl = open(os.path.join(p, "temp%d_label" % i)).read().strip()
            except OSError:
                lbl = ""
            if lbl.lower().startswith("package"):
                _CPU_TEMP["path"] = t
                return t
            if fallback is None and i == 1:
                fallback = t
    if fallback:
        _CPU_TEMP["path"] = fallback
    return fallback


def cpu_temp_raw():
    """One raw sample in °C, or None.

    Plausibility gate. A real package reading on this class of machine sits
    between roughly 20 and 110 °C; anything outside that is a bad read, not
    a temperature. The historical "it says 100 for no reason" reports come
    from exactly two places, and both are handled here:
      * a stale cached sensor path. _coretemp_path() caches the hwmon file
        it resolved, and hwmon numbers are assigned in driver probe order,
        so a DKMS rebuild or a suspend/resume cycle can leave the cache
        pointing at a different device entirely. An implausible sample
        therefore also DISCARDS the cache and re-resolves by name.
      * a transient garbage read. Rejected, not displayed.
    """
    global _CPU_TEMP
    for _attempt in (0, 1):
        p = _coretemp_path()
        if not p:
            return None
        try:
            v = int(read(p)) / 1000.0
        except (ValueError, TypeError, OSError):
            return None
        if _CPU_TEMP_MIN <= v <= _CPU_TEMP_MAX:
            return v
        # Implausible: drop the cached path and resolve it by name again.
        _CPU_TEMP["path"] = None
        if _attempt:
            return None
    return None


def cpu_temp():
    """Filtered package temperature in °C, or None.

    Median over a TIME window, not a sample count. The count-based version
    (last 5 samples) was defeated by the app's own behaviour: refresh() is
    called on every slider drag and every mode change as well as on the
    5 s tick, so during interaction the whole "history" covered well under
    a second and a single bad sample carried real weight again.
    """
    v = cpu_temp_raw()
    if v is None:
        return None
    now = time.time()
    hist = [(t, x) for t, x in _CPU_TEMP["hist"] if now - t <= _CPU_TEMP_WINDOW]
    hist.append((now, v))
    _CPU_TEMP["hist"] = hist
    ordered = sorted(x for _, x in hist)
    return round(ordered[len(ordered) // 2])


def device_name():
    """The real machine name from DMI, e.g. 'Razer Blade 16 (2024)'."""
    vendor = read("/sys/class/dmi/id/sys_vendor", "").strip()
    product = read("/sys/class/dmi/id/product_name", "").strip()
    product = product.replace(" - ", " ").strip()
    if vendor and vendor.lower() in product.lower():
        return product
    return f"{vendor} {product}".strip() or "Razer Command Center"


# ── lighting profiles: the persistent per-key store ─────────────────────────

DEFAULT_PROFILE = "Razer green"


def load_lighting():
    try:
        with open(LIGHTING_JSON) as f:
            data = json.load(f)
        if not isinstance(data.get("profiles"), list) or \
                not data["profiles"]:
            raise ValueError("no profiles")
        return data
    except Exception:
        # seed: one profile with the classic green
        data = {"active": 0, "profiles": [
            {"name": DEFAULT_PROFILE, "keys": {}}]}
        os.makedirs(RCC_DIR, exist_ok=True)
        with open(LIGHTING_JSON, "w") as f:
            json.dump(data, f, indent=2)
        return data


def save_lighting(data):
    os.makedirs(RCC_DIR, exist_ok=True)
    with open(LIGHTING_JSON, "w") as f:
        json.dump(data, f, indent=2)
    return True


def active_profile(data):
    idx = data.get("active", 0)
    profiles = data["profiles"]
    idx = max(0, min(idx, len(profiles) - 1))
    return idx, profiles[idx]


# ── autostart (GUI + headless lighting re-apply) ─────────────────────────────

def autostart_enabled():
    return os.path.exists(AUTOSTART_FILE)


def set_autostart_enabled(on):
    os.makedirs(os.path.dirname(AUTOSTART_FILE), exist_ok=True)
    if on:
        with open(AUTOSTART_FILE, "w") as f:
            f.write("[Desktop Entry]\nType=Application\n"
                    "Name=Razer Command Center\n"
                    "Comment=Power, lighting and GPU control\n"
                    f"Exec={HOME}/.local/bin/razer-command-center\n"
                    f"Icon={ICON}\nTerminal=false\n"
                    "X-GNOME-Autostart-enabled=true\n")
        # custom per-key frames are volatile: re-apply the active profile
        # headlessly right after login.
        with open(AUTOSTART_APPLY, "w") as f:
            f.write("[Desktop Entry]\nType=Application\n"
                    "Name=Razer Command Center lighting\n"
                    "Comment=Re-applies the active key colors\n"
                    f"Exec={HOME}/.local/bin/razer-command-center "
                    "--apply-lighting\n"
                    f"Icon={ICON}\nTerminal=false\n"
                    "X-GNOME-Autostart-enabled=true\n")
    else:
        for path in (AUTOSTART_FILE, AUTOSTART_APPLY):
            if os.path.exists(path):
                os.remove(path)
    return True


# ── power-profiles-daemon ────────────────────────────────────────────────────

PPD_IFACES = ("net.hadess.PowerProfiles",
              "org.freedesktop.UPower.PowerProfiles")


def _ppd():
    try:
        bus = Gio.bus_get_sync(Gio.BusType.SYSTEM, None)
    except GLib.Error:
        return None, None
    for iface in PPD_IFACES:
        try:
            return Gio.DBusProxy.new_sync(
                bus, Gio.DBusProxyFlags.NONE, None,
                "net.hadess.PowerProfiles", "/net/hadess/PowerProfiles",
                iface, None), iface
        except GLib.Error:
            continue
    return None, None


def ppd_state():
    proxy, _ = _ppd()
    if proxy is None:
        return {"ok": False, "active": None, "profiles": []}
    active = proxy.get_cached_property("ActiveProfile")
    profs = proxy.get_cached_property("Profiles")
    names = [list(pr.values())[0] for pr in profs.unpack()] if profs else []
    return {"ok": active is not None,
            "active": active.unpack() if active else None,
            "profiles": names or [v for v, _, _, _ in PROFILES]}


PPD_TO_II = {"performance": "performance", "balanced": "default",
             "power-saver": "eco"}


def sync_ii_power_mode(profile):
    """Persist the shell's own mode key (battery.powerMode) to match a PPD
    profile write.

    WHY this exists: the shell's PowerMode service re-applies its CONFIG
    value -- battery.powerMode, default 'default' == balanced -- on login
    and whenever the config object re-signals. A power-saver set through
    THIS app (or the bar chips) that didn't update that key got stomped
    back to balanced by the shell's next apply(): the 'keeps switching to
    balanced' bug. Writing the key here makes both UIs agree on one
    source of truth: the config. Idempotent and silent on failure -- a
    config write must never fail a profile switch that already landed.
    """
    mode = PPD_TO_II.get(profile)
    if not mode:
        return
    try:
        cfg = read_ii()
        if cfg.get("battery", {}).get("powerMode") != mode:
            cfg.setdefault("battery", {})["powerMode"] = mode
            write_ii(cfg)
    except Exception:
        pass


def ppd_set(profile):
    proxy, iface = _ppd()
    if proxy is None:
        return False, "power-profiles-daemon is not reachable"
    try:
        proxy.call_sync("org.freedesktop.DBus.Properties.Set",
                        GLib.Variant("(ssv)",
                                     (iface, "ActiveProfile",
                                      GLib.Variant.new_string(profile))),
                        Gio.DBusCallFlags.NONE, -1, None)
        sync_ii_power_mode(profile)
        return True, ""
    except GLib.Error as e:
        return False, str(e.message or e)


# ── battery / GPU / decode / screen ─────────────────────────────────────────

def battery_pct():
    try:
        return int(read("/sys/class/power_supply/BAT0/capacity", "0"))
    except ValueError:
        return 0


def battery_info():
    cap = read("/sys/class/power_supply/BAT0/capacity", "?")
    status = read("/sys/class/power_supply/BAT0/status", "?")
    cycles = read("/sys/class/power_supply/BAT0/cycle_count", "?")
    ac = read("/sys/class/power_supply/AC0/online", "0") == "1"
    return (f"{cap} % · {'AC' if ac else 'battery'} · {status.lower()} · "
            f"{cycles} cycles")


def gpu_runtime_status():
    return read(f"/sys/bus/pci/devices/{NVIDIA_PCI}/power/runtime_status", "?")


def gpu_power_draw():
    """Watts as float. ONLY call this while the GPU is runtime-active —
    nvidia-smi itself opens the device and would wake a sleeping GPU."""
    ok, out = run("nvidia-smi", "--query-gpu=power.draw",
                  "--format=csv,noheader")
    if ok and out:
        try:
            return float(out.splitlines()[0].split()[0])
        except (ValueError, IndexError):
            return 0.0
    return 0.0


def gpu_metrics():
    """One nvidia-smi query: load, VRAM load, watts, pstate, temperature, VRAM.

    Returns a dict, or None if the query could not be read.

    This OPENS the card, so it must only be called while the GPU is already
    runtime-active -- polling a sleeping GPU to draw a pretty number would
    undo the power saving this whole page exists to protect. The one exception
    is the explicit "Sample" button, where waking the card is the point.
    """
    ok, out = run("nvidia-smi",
                  "--query-gpu=utilization.gpu,utilization.memory,"
                  "power.draw,pstate,temperature.gpu,"
                  "memory.used,memory.total",
                  "--format=csv,noheader,nounits")
    if not ok or not out:
        return None
    parts = [p.strip() for p in out.splitlines()[0].split(",")]
    if len(parts) < 7:
        return None

    def num(i):
        # nvidia-smi answers "[N/A]" for a field it cannot read, which is not
        # an error worth surfacing -- it just means "no reading right now".
        try:
            return float(parts[i])
        except ValueError:
            return 0.0

    return {"util": num(0), "mem_util": num(1), "watts": num(2),
            "pstate": parts[3] or "?", "temp": num(4),
            "mem_used": num(5), "mem_total": num(6)}


def ac_online():
    """True when the charger is plugged in."""
    return read("/sys/class/power_supply/AC0/online", "0") == "1"


def battery_field(name, default=None):
    """One BAT0 sysfs field, or None when this firmware does not have it.

    Returning None rather than a zero is the point: a missing reading and a
    reading of zero are different facts, and a panel that cannot tell them
    apart will confidently draw "0 W" on a machine that never said 0 W.
    """
    raw = read(f"/sys/class/power_supply/BAT0/{name}", "")
    if not raw:
        return default
    try:
        return int(raw)
    except ValueError:
        return default


def battery_watts():
    """Battery power flow in watts, or None if the kernel does not report it.

    Direction follows POWER_SUPPLY_STATUS, because on this class of machine
    the current is unsigned: a laptop charging at 60 W and one discharging at
    60 W report the same number and only the status tells them apart.
    """
    status = read("/sys/class/power_supply/BAT0/status", "").lower()
    if "discharg" in status:
        sign = -1.0
    elif "charg" in status:
        sign = 1.0
    else:
        sign = 0.0
    power = battery_field("power_now")
    if power is None:
        return None
    return sign * power / 1_000_000.0


def wall_time():
    """(text, is_estimate) for the battery's remaining-time field.

    A laptop that is full and plugged in reports an enormous 'time to empty'
    that is really a statement about the charger, not the battery, so the
    kernel marks it ESTIMATED. Both facts are passed on because the honest
    reading of a 30-hour estimate is "this number is meaningless right now".
    """
    status = read("/sys/class/power_supply/BAT0/status", "").lower()
    want = "time_to_empty_now" if "charg" not in status else "time_to_full_now"
    mins = battery_field(want)
    if mins is None:
        return None, False
    est = read(f"/sys/class/power_supply/BAT0/{want}_estimated", "0") == "1"
    if mins < 0 or mins > 60 * 24 * 7:
        return None, est
    h, m = divmod(mins, 60)
    text = f"{h} h {m:02d} m" if h else f"{m} min"
    return text, est


def cpu_model():
    """"model name" out of /proc/cpuinfo, or '' when there isn't one."""
    for line in read("/proc/cpuinfo", "").splitlines():
        if line.startswith("model name"):
            return line.split(":", 1)[1].strip()
    return ""


def ram_total_gb():
    try:
        kb = int(read("/proc/meminfo", "").split("MemTotal:")[1]
                 .split()[0])
    except (IndexError, ValueError):
        return None
    return round(kb / 1024 / 1024, 1)


def gpu_name():
    """The dGPU's inventory name, from PCI config space -- NOT nvidia-smi.

    lspci reads the PCI configuration space and opens no device node, so it
    can be called on a sleeping card. nvidia-smi would wake it, which is the
    one thing this readout must never do.
    """
    ok, out = run("lspci", "-mm", "-nn")
    if not ok:
        return ""
    # One line per device, alternating quoted fields:
    #   01:00.0 "VGA compatible controller [0300]" "NVIDIA Corporation [10de]"
    #          "AD106M [GeForce RTX 4070 Max-Q / Mobile] [2860]" -ra1 -p00 ...
    # so the device name is field 3, and lspci's trailing " [2860]" PCI-id
    # suffix is noise on a caption line.
    for line in out.splitlines():
        if '"VGA compatible controller' not in line or "NVIDIA" not in line:
            continue
        parts = [p.strip() for p in line.split('"') if p.strip()]
        if len(parts) >= 4:
            name = parts[3]
            return name.rsplit(" [", 1)[0] if name.endswith("]") else name
    return ""


# Facts that cannot change while the machine is up. Computed once per app
# run instead of on every publish: lspci costs ~30 ms and answers the same
# thing every time, and the publish happens on a timer for the whole session.
_STATIC = {}


def power_snapshot(allow_metrics=None):
    """Everything the shell's System tab shows about power and the GPU.

    Read-only. Two rules, both of them learned the hard way:

    * The GPU is only sampled while it is already awake. nvidia-smi opens the
      card, so asking a sleeping one for its numbers would undo the power
      saving this very readout exists to make visible.
    * Nothing here is invented. A field the firmware does not report is None,
      not 0 -- a missing reading and a reading of zero are different facts,
      and a panel that cannot tell them apart will cheerfully draw "0 W" on a
      machine that never said 0 W.

    allow_metrics: None (default) samples nvidia-smi whenever the card is
    already active -- the window's own behaviour. False drops the metrics
    even then; the headless tick uses that to avoid restarting an idle
    card's power-down countdown with a poll nobody is watching.
    """
    if not _STATIC:
        _STATIC.update(cpu_model=cpu_model(), gpu_name=gpu_name(),
                       ram_total_gb=ram_total_gb(), device=device_name())
    status = gpu_runtime_status()
    sample = status == "active" if allow_metrics is None \
        else bool(allow_metrics) and status == "active"
    m = gpu_metrics() if sample else None
    t, est = wall_time()
    return {
        "ac_online": ac_online(),
        "battery_pct": battery_pct(),
        "battery_status": read("/sys/class/power_supply/BAT0/status", "?"),
        "battery_watts": battery_watts(),
        "battery_cycles": battery_field("cycle_count"),
        "battery_wall_time": t,
        "battery_wall_time_estimated": est,
        "gpu_state": status,
        "gpu_load": None if m is None else m["util"],
        "gpu_watts": None if m is None else m["watts"],
        "gpu_pstate": None if m is None else m["pstate"],
        "gpu_temp_c": None if m is None else m["temp"],
        "gpu_vram_mb": None if m is None else m["mem_used"],
        "cpu_temp_c": cpu_temp(),
        **_STATIC,
        # Stated, not implied. This machine's ACPI exposes AC0/online and
        # nothing at all about the adapter, so the charger's own input wattage
        # is not knowable from here. The panel shows what IS knowable and says
        # where the rest would have to come from.
        "wall_watts": None,
        "wall_watts_reason": "ACPI reports only AC0/online; this firmware "
                             "exposes no adapter input wattage",
    }


def publish_power_json():
    """Write the snapshot where the shell can read it without spawning us.

    The alternative -- the shell running `--power-json` on a timer -- costs
    ~460 ms per call, because the app's module level imports Gtk and
    Adw before any argument is even looked at. This process is already
    resident and already owns every one of these reads, so it publishes the
    answer and the shell just reads a file. Atomic replace, so a reader can
    never catch a half-written blob.
    """
    try:
        os.makedirs(RCC_DIR, exist_ok=True)
        tmp = POWER_JSON + ".tmp"
        with open(tmp, "w") as fh:
            json.dump(power_snapshot(), fh)
        os.replace(tmp, POWER_JSON)
    except OSError:
        pass      # a missing status file is not worth a dialog


def tick_power_snapshot():
    """The headless 5s publisher's snapshot, with nvidia-smi gated.

    A query cannot WAKE a sleeping card (power_snapshot skips it), but every
    query does restart the driver's idle countdown on an idle-but-awake card
    (P8, a few watts) -- so polling every 5s would keep it awake forever.
    Full metrics are therefore published only when someone can see them: the
    window is open, or a real process holds the device open. Otherwise the
    snapshot goes out without them -- pure sysfs, no device touch -- and the
    card is free to finish its countdown and suspend.
    """
    if not UI_VISIBLE and not nvidia_device_holders():
        return power_snapshot(allow_metrics=False)
    return power_snapshot()


def gpu_load_text(m):
    """One line describing what the dGPU is actually doing right now."""
    if m is None:
        return "asleep — nothing is using the dGPU"
    return (f"{m['util']:.0f}% load · {m['mem_util']:.0f}% VRAM · "
            f"{m['watts']:.0f} W · {m['pstate']} · {m['temp']:.0f} °C · "
            f"{m['mem_used']:.0f}/{m['mem_total']:.0f} MiB")


# Processes this panel must never terminate, whatever the user clicks.
# Killing the compositor, init, or our own UI takes the whole session with
# it, so the guard checks the executable as well as the display name -- a
# renamed or symlinked binary must not slip past the name check alone.
GPU_HOLDER_PROTECTED = {
    "hyprland", "hyprlandctl", "init", "systemd", "systemd-journald",
    "systemd-logind", "dbus-daemon", "dbus-broker", "pipewire",
    "wireplumber", "qs", "quickshell", "gnome-shell", "plasmashell",
    "sddm", "razer-command-center", "Xwayland", "Xorg",
}


def _pid_label(pid):
    """Human name for a pid. Generic interpreter names are useless (five
    python3s could be five different things), so prefer the script/app
    name from the command line when it tells a clearer story."""
    comm = read(f"/proc/{pid}/comm", "").strip()
    cmdline = read(f"/proc/{pid}/cmdline").replace("\x00", " ").strip()
    base = os.path.basename(cmdline.split(" ")[-1]) if cmdline else ""
    if comm in ("python3", "python", "node", "uwsgi") and base and base != comm:
        return base[:32]
    return comm or (base[:32] if base else f"pid {pid}")


def _is_protected(pid, name):
    """True if this process must not be terminated from the panel."""
    if pid in (0, 1) or pid == os.getpid() or pid == os.getppid():
        return True
    try:
        exe = os.path.basename(os.readlink(f"/proc/{pid}/exe")).lower()
    except OSError:
        exe = ""
    if exe in GPU_HOLDER_PROTECTED or (name or "").lower() in GPU_HOLDER_PROTECTED:
        return True
    # Never signal our own ancestors: that is the terminal or desktop that
    # launched us, and killing it would take the panel down mid-click. Walk
    # the WHOLE chain, not just the direct parent -- a helper two levels up
    # owns our stdout and our window just as much as our parent does.
    try:
        seen = set()
        cur = pid
        for _ in range(16):          # pid_max is far larger, but a cycle or
            if cur in seen:           # a runaway reparent must not hang us
                return True
            if cur == os.getpid():
                return True
            seen.add(cur)
            stat = read(f"/proc/{cur}/stat", "")
            if ") " not in stat:
                return False          # gone, or unreadable: not an ancestor
            ppid = int(stat.split(") ", 1)[1].split()[1])
            if ppid <= 0:
                return False          # reached init
            if ppid == os.getpid():
                return True
            cur = ppid
    except (IndexError, ValueError):
        return False
    return False


def gpu_holder_pids():
    """(pid, name) for every process holding the NVIDIA device open.

    fuser's bare-PID output (its verbose table goes to stderr, which run()
    would discard) is mapped to real names via /proc/<pid>/comm; nvidia-smi's
    compute-app list adds full names for CUDA clients. The query tools
    themselves and our own process are filtered out. Pids are kept alongside
    the names so the panel can act on them, not just describe them."""
    found = {}
    ok, out = run("fuser", "/dev/nvidia0")
    if ok or out:
        for token in out.split():
            if not token.isdigit():
                continue
            pid = int(token)
            if pid == os.getpid():
                continue
            found[pid] = _pid_label(pid)
    ok, out = run("nvidia-smi", "--query-compute-apps=pid,process_name",
                  "--format=csv,noheader")
    if ok:
        for line in out.splitlines():
            if "," not in line:
                continue
            pid_s, pname = line.split(",", 1)
            pid_s, pname = pid_s.strip(), os.path.basename(pname.strip())
            if not pid_s.isdigit() or pname in ("nvidia-smi", "fuser"):
                continue
            pid = int(pid_s)
            if pid == os.getpid():
                continue
            found.setdefault(pid, pname or _pid_label(pid))
    return sorted((pid, found[pid]) for pid in found if found[pid])


def nvidia_device_holders():
    """Pids holding /dev/nvidia* open, from a pure /proc scan.

    Unlike gpu_holder_pids() this never runs fuser or nvidia-smi, so it is
    safe on a sleeping card: it only reads other processes' fd symlinks.
    The headless tick uses it to tell "a real app is using the card" apart
    from "the card is idle-awake only because a poller keeps resetting its
    idle timer".
    """
    me = os.getpid()
    found = set()
    for path in glob.glob("/proc/[0-9]*/fd"):
        try:
            pid = int(path.split("/")[2])
            if pid == me:
                continue
            for fd in os.listdir(path):
                try:
                    target = os.readlink(os.path.join(path, fd))
                except OSError:
                    continue
                if os.path.basename(target).startswith("nvidia"):
                    found.add(pid)
                    break
        except OSError:
            continue
    return found


def gpu_holders():
    """Names only — the hero label and the 5s loop just want the list."""
    names = {name for _, name in gpu_holder_pids()}
    names -= {"nvidia-smi", "fuser"}
    return sorted(n for n in names if n)


def gpu_terminate(pid):
    """Ask a GPU holder to exit: SIGTERM, then wait briefly to see whether
    it actually went away. Returns (ok, message).

    SIGTERM only, never SIGKILL -- the point is to let the app close its
    own files and let the driver reclaim the device cleanly, and a hard
    kill of something we misidentified would lose the user's work. If the
    process is still alive after ~1s we report that rather than escalating:
    if it is a service that immediately reopened the device, killing it
    harder would not help."""
    name = _pid_label(pid)
    if _is_protected(pid, name):
        return False, f"{name or pid} is protected — leaving it alone"
    try:
        os.kill(pid, signal.SIGTERM)
    except ProcessLookupError:
        return False, f"{name} had already exited"
    except PermissionError:
        return False, f"not permitted to signal {name}"
    except OSError as e:
        return False, f"could not signal {name}: {e}"
    for _ in range(10):
        time.sleep(0.1)
        if not os.path.exists(f"/proc/{pid}"):
            return True, f"{name} closed — the card can sleep"
    return False, (f"{name} ignored the request; it is probably a service "
                   f"that reopened the device at once")


def nvidia_param(key):
    for line in read(NVIDIA_PARAMS).splitlines():
        if line.startswith(key + ":"):
            return line.split(":", 1)[1].strip()
    return None


def nvidia_persisted():
    if not os.path.exists(NVIDIA_PM_CONF):
        return False, None, None
    dpm = s0ix = None
    for line in read(NVIDIA_PM_CONF).splitlines():
        if "DynamicPowerManagement=" in line:
            dpm = line.split("=", 1)[1].strip().replace("0x", "")
        if "EnableS0ixPowerManagement=" in line:
            s0ix = line.split("=", 1)[1].strip()
    return True, dpm, s0ix


def nvidia_apply(dpm, s0ix):
    ok, out = run("pkexec", ELEVATE, "nvidia", str(dpm), str(s0ix))
    return ok, ("" if ok else out or "pkexec denied")


def download_progress(name, pct):
    """Tell the shell's bar status line about a download. pct 0-100.
    Called repeatedly by --download-progress; 100 finishes the line."""
    frac = max(0.0, min(1.0, pct / 100.0))
    try:
        run("qs", "-c", "ii", "ipc", "call", "loading", "progress",
            name, f"{frac:.4f}")
        return True
    except Exception:
        return False


def decode_state():
    val = ""
    for line in read("/etc/environment").splitlines():
        if line.strip().startswith("LIBVA_DRIVER_NAME="):
            val = line.split("=", 1)[1].strip()
    if val.lower() == "nvidia":
        return False, "on the RTX 4070"
    if val:
        return False, f"forced to {val}"
    return True, "on the Intel iGPU"


def decode_fix():
    ok, out = run("pkexec", ELEVATE, "decode")
    return ok, ("" if ok else out or "pkexec denied")


def screen_brightness_pct():
    ok, out = run("brightnessctl", "-d", SCREEN_DEV, "info")
    if ok:
        for line in out.splitlines():
            if "Current brightness" in line:
                for token in line.replace("(", " ").replace(")", " ").split():
                    if token.endswith("%"):
                        try:
                            return int(token[:-1])
                        except ValueError:
                            pass
    return None


def set_screen_brightness(pct):
    # --save makes brightnessctl remember the level in its own state file,
    # which is what restore_screen_brightness() reads at next startup.
    # Without it the panel is back at the firmware default after every
    # reboot, so the slider's setting never survived a power cycle.
    run("brightnessctl", "-d", SCREEN_DEV, "set", f"{int(pct)}%")
    run("brightnessctl", "-d", SCREEN_DEV, "--save")


def restore_screen_brightness():
    """Re-apply the last saved panel brightness. One-shot, at startup.

    The firmware resets the backlight to its own default on every boot, so
    without this the Display page shows a level the user never chose.
    brightnessctl's own state file lives outside this app, so a level set
    from hyprland's brightness keys is restored here too.
    """
    ok, _out = run("brightnessctl", "-d", SCREEN_DEV, "--restore")
    return ok


def save_screen_brightness_now():
    """Snapshot the current level without changing it (used at shutdown-ish
    points and by the persistence self-test)."""
    return run("brightnessctl", "-d", SCREEN_DEV, "--save")[0]


# ── openrazer: per-key matrix + effects + brightness (direct client API,
#    no polychromatic) ──────────────────────────────────────────────────

ROWS, COLS = 6, 16


def _kbd_device():
    import openrazer.client as orclient
    dm = orclient.DeviceManager()
    for d in dm.devices:
        if getattr(d, "type", "") == "keyboard" or "Blade" in d.name:
            return d
    return dm.devices[0] if dm.devices else None


def kbd_get_brightness(zone):
    """0–100 int, or None. zone 'main' = keyboard, 'logo' = 0/1."""
    try:
        d = _kbd_device()
        if d is None:
            return None
        if zone == "logo":
            return 100 if d.fx.misc.logo.active else 0
        return int(round(float(d.brightness)))
    except Exception:
        return None


def kbd_set_brightness(zone, pct):
    pct = int(pct)
    try:
        d = _kbd_device()
        if d is None:
            return False, "no device"
        if zone == "logo":
            d.fx.misc.logo.active = pct > 0
            return True, ""
        d.brightness = max(0, min(100, pct))
        return True, ""
    except Exception as e:
        return False, str(e)


def _rgb_of(hexc):
    h = (hexc or "000000").lstrip("#")
    return (int(h[0:2], 16), int(h[2:4], 16), int(h[4:6], 16))


def kbd_apply(zone, option, param, colors):
    """Hardware quick effects through the openrazer client API.
    option: static|spectrum|wave|ripple|reactive|breath|starlight|none"""
    if zone == "logo":
        return kbd_set_brightness("logo", 100 if option != "none" else 0)
    try:
        d = _kbd_device()
        if d is None:
            return False, "no device"
        fx = d.fx
        c1 = _rgb_of(colors[0]) if colors else (0x3f, 0xb9, 0x50)
        c2 = _rgb_of(colors[1]) if colors and len(colors) > 1 else \
            (0x10, 0x10, 0x10)
        p = str(param or "").strip()
        if option == "static":
            fx.static(*c1)
        elif option == "spectrum":
            fx.spectrum()
        elif option == "wave":
            fx.wave(int(p) if p.isdigit() and p in ("1", "2") else 1)
        elif option == "ripple":
            if p.startswith("rand"):
                fx.ripple_random(*c1)
            else:
                fx.ripple(*c1)
        elif option == "reactive":
            fx.reactive(*c1, int(p) if p.isdigit() and p in
                        ("0", "1", "2", "3") else 1)
        elif option == "breath":
            if p.startswith("dual"):
                fx.breath_dual(*c1, *c2)
            elif p.startswith("rand") or not p:
                fx.breath_random()
            else:
                fx.breath_single(*c1)
        elif option == "starlight":
            base = p.split(":")[0] if p else "single"
            if base.startswith("rand"):
                fx.starlight_random()
            else:
                fx.starlight_single(*c1, 1)
        elif option == "none":
            fx.none()
        else:
            return False, f"unknown effect {option}"
        return True, ""
    except Exception as e:
        return False, str(e)


def kbd_push_matrix(colors):
    """colors: dict (r,c)->hex ('rrggbb' or '#rrggbb'). Missing = dark."""
    d = _kbd_device()
    if d is None:
        return False, "no Razer device found"
    fx = d.fx.advanced
    for r in range(ROWS):
        for c in range(COLS):
            hx = colors.get((r, c), "000000").lstrip("#")
            fx.matrix.set(r, c, (int(hx[0:2], 16), int(hx[2:4], 16),
                                 int(hx[4:6], 16)))
    fx.draw()
    return True, ""


def daemon_active():
    return run("systemctl", "--user", "is-active", "--quiet",
               "openrazer-daemon")[0]


def daemon_ctl(action):
    return run("systemctl", "--user", action, "openrazer-daemon")


def hotkey_capture(seconds=8):
    nodes = ["/dev/input/event11", "/dev/input/event13",
             "/dev/input/event16"]
    fds = {}
    for d in nodes:
        try:
            fds[os.open(d, os.O_RDONLY | os.O_NONBLOCK)] = d
        except OSError:
            pass
    fmt, size = "llHHI", struct.calcsize("llHHI")
    found = set()
    end = time.time() + seconds
    while time.time() < end and fds:
        r, _, _ = select.select(list(fds), [], [], 0.1)
        for fd in r:
            try:
                data = os.read(fd, size * 32)
            except OSError:
                continue
            for i in range(len(data) // size):
                _, _, etype, code, value = struct.unpack_from(
                    fmt, data, i * size)
                if etype == 1 and value == 1:
                    found.add(KBD_KEY_NAMES.get(code, f"code_{code}"))
    for fd in fds:
        os.close(fd)
    return sorted(found)


def rgba_of(hexstr):
    c = Gdk.RGBA()
    c.parse(hexstr)
    return c


def _hex_rgb(h):
    h = h.lstrip("#")
    return tuple(int(h[i:i + 2], 16) / 255.0 for i in (0, 2, 4))


def parse_color(text):
    """Accept any colour string Gdk.RGBA parses (#rgb, #rrggbb, #rrggbbaa,
    rgb()/rgba(), hsl()/hsla(), CSS colour names) and return a normalised
    #rrggbb string, or None if nothing sensible was typed."""
    t = (text or "").strip()
    if not t:
        return None
    c = Gdk.RGBA()
    ok = c.parse(t)
    if not ok and "#" not in t:
        ok = c.parse("#" + t)
    if not ok:
        return None
    return "#%02x%02x%02x" % (round(c.red * 255),
                              round(c.green * 255),
                              round(c.blue * 255))


# Wheel-palette swatches for the custom colour popover: greys plus a
# warm→cool hue sweep, tuned against the warm-scheme reference image.
WHEEL_COLORS = (
    "#f5f5f4", "#c9c9c9", "#8a8a8a", "#4a4a4a", "#1c1c1c",
    "#f5d5c0", "#f2b28c", "#e8875f", "#d95d39", "#b03a2e",
    "#f2e2b1", "#e9c46a", "#dfa32d", "#c8871e", "#9c6410",
    "#dcecc8", "#b7d8a0", "#8fbf6f", "#297934", "#1d5e28",
    "#cfe4ef", "#9fc6dd", "#6fa8c9", "#3f7ca6", "#2a5b7c",
    "#e2d4ee", "#c3a8dd", "#a483c9", "#7e5cae", "#5d3f8f",
    "#f0c7d8", "#e39ab8", "#d36a94", "#b74370", "#8f2f52",
)


# ── the keyboard replica layout ──────────────────────────────────────────
# Each entry: (label, span in LED columns). Spans MUST sum to the profile's
# column count, row by row: the replica and the hardware frame share one
# indexing, so a key painted at (r, c) here is the LED at (r, c) there. A row
# that does not sum correctly silently misaligns every key after the gap, and
# painting then lights the wrong physical key, so the sum is asserted below
# rather than trusted.
#
# The old layout was one hardcoded board, which was wrong twice over: it was
# only correct for a Blade 16 (2024), and even there it did not match the
# machine (see the German notes in the profile below). The table is now keyed
# by device so each computer gets its own board.
#
# Profile fields: cols/rows are the LED matrix, layout the replica, `match` the
# DMI substrings that select it, `note` the short label shown in the UI.

def _row(*entries):
    """Normalize a layout row: bare strings become (label, 1)."""
    return [(e, 1) if isinstance(e, str) else e for e in entries]


# GERMAN (QWERTZ, ISO) Blade 16 (2024) -- RZ09-0510.
#
# Facts established for this machine, not assumed:
#   * the LED matrix is 6 x 16 -- the openrazer kernel driver defines
#     RAZER_BLADE_16_2024_MATRIX_ROWS 6 / _COLUMNS 16 (razerkbd_driver.h), and
#     the daemon agrees; the replica must be exactly that shape;
#   * there is NO numpad. Reviews of this exact model are explicit about it
#     ("it's a little surprising that in such a wide enclosure there's no room
#     for a numeric keypad"), so the 16 columns are the main block, not a
#     keypad;
#   * there are NO macro keys. The "column of five programmable macro keys"
#     on the far right belongs to the 2025 refresh, not the 2024, so drawing
#     them would put five keys on this board that do not exist.
#
# Corrections against the old layout, which is what "not at all the German
# keyboard" meant:
#   * the number row starts with ^ (the app drew only its shifted legend °);
#   * < and > are TWO separate keys on a German board -- the app had one, so
#     every key from Y onwards sat one column to the left of reality;
#   * the spacebar was 7 columns wide; it is 6, and the freed column is the
#     context-menu key that sits between the right Strg and the arrows;
#   * the right shift was 2 columns, which left no room for the up arrow. It
#     is 1 column here, giving the correct inverted-T: ^ over the down arrow.
#   * the number row's Backspace is 3 columns on this chassis.
#
# Still worth eyeballing against the real machine: the three keys at the top
# right (Einfg / Entf / Ende). Their exact identity is the one part of this
# layout that no datasheet states, and it is a three-cell edit if they differ.
_GERMAN_16_2024 = [
    _row("esc", *[f"F{i}" for i in range(1, 13)],
         "Einfg", "Entf", "Ende"),
    _row("^", "1", "2", "3", "4", "5", "6", "7", "8", "9", "0",
         "ß", "´", ("⌫", 3)),
    # ISO corner-Enter: the top bar is the right two cells of this row and
    # the leg the right two cells of the next, as the hardware addresses it.
    _row(("tab", 2), "Q", "W", "E", "R", "T", "Z", "U", "I", "O", "P",
         "ü", "+", ("↵", 2)),
    _row(("⇪", 2), "A", "S", "D", "F", "G", "H", "J", "K", "L",
         "ö", "ä", "#", ("", 2)),
    # Left shift 2 cells, then the two German <> keys, then Y..-, then a
    # ONE-cell right shift and the up arrow.
    _row(("⇧", 2), "<", ">", "Y", "X", "C", "V", "B", "N", "M",
         ",", ".", "-", ("⇧", 1), "↑"),
    _row("strg", "fn", "❖", "alt", ("", 6), "alt gr", "strg",
         "Menü", "←", "↓", "→"),
]

# US (QWERTY, ANSI) of the same chassis, for an English-market 2024 board.
_US_16_2024 = [
    _row("esc", *[f"F{i}" for i in range(1, 13)],
         "Einfg", "Entf", "Ende"),
    _row("`", "1", "2", "3", "4", "5", "6", "7", "8", "9", "0",
         "-", "=", ("⌫", 3)),
    _row(("tab", 2), "Q", "W", "E", "R", "T", "Y", "U", "I", "O", "P",
         "[", "]", ("\\", 2)),
    _row(("⇪", 2), "A", "S", "D", "F", "G", "H", "J", "K", "L",
         ";", "'", ("", 2)),
    _row(("⇧", 2), "Z", "X", "C", "V", "B", "N", "M",
         ",", ".", "/", ("⇧", 1), "↑"),
    _row("strg", "fn", "❖", "alt", ("", 6), "alt gr", "strg",
         "Menü", "←", "↓", "→"),
]

# Blade 16 (2025) and later: the 2025 refresh ADDED a column of five macro
# keys on the far right, which is why the 2024 profile above must not have
# them. Those machines report a wider matrix, so they get their own profile
# rather than inheriting the 2024 one.
_GERMAN_16_MACRO = [
    _row("esc", *[f"F{i}" for i in range(1, 13)],
         "Einfg", "Entf", "Ende", ("", 1)),
    _row("^", "1", "2", "3", "4", "5", "6", "7", "8", "9", "0",
         "ß", "´", ("⌫", 3), ("M1", 1)),
    _row(("tab", 2), "Q", "W", "E", "R", "T", "Z", "U", "I", "O", "P",
         "ü", "+", ("↵", 2), ("M2", 1)),
    _row(("⇪", 2), "A", "S", "D", "F", "G", "H", "J", "K", "L",
         "ö", "ä", "#", ("", 2), ("M3", 1)),
    _row(("⇧", 2), "<", ">", "Y", "X", "C", "V", "B", "N", "M",
         ",", ".", "-", ("⇧", 1), "↑", ("M4", 1)),
    _row("strg", "fn", "❖", "alt", ("", 6), "alt gr", "strg",
         "Menü", "←", "↓", "→", ("M5", 1)),
]

KB_PROFILES = [
    {"match": ("rz09-0510", "blade 16 (2024)", "blade 16 2024"),
     "cols": 16, "rows": 6, "layout": _GERMAN_16_2024,
     "title": "German QWERTZ (ISO) — Blade 16 (2024)",
     "locale": "de"},
    {"match": ("rz09-0510", "blade 16 (2024)", "blade 16 2024"),
     "cols": 16, "rows": 6, "layout": _US_16_2024,
     "title": "US QWERTY (ANSI) — Blade 16 (2024)",
     "locale": "us"},
    {"match": ("rz09-0506", "rz09-0550", "blade 16 (2025)", "blade 16 2025"),
     "cols": 17, "rows": 6, "layout": _GERMAN_16_MACRO,
     "title": "German QWERTZ (ISO) — Blade 16 (2025), 5 macro keys",
     "locale": "de"},
]

# Used when nothing matches. Same shape as every other entry, so the board
# still draws and still paints the right LEDs -- a wrong LABEL is a cosmetic
# bug, a wrong matrix shape would light the wrong keys.
KB_FALLBACK = {
    "match": (), "cols": 16, "rows": 6, "layout": _GERMAN_16_2024,
    "title": "Generic 6x16 board (unknown device)", "locale": "de",
}


def _kb_locale():
    """'de' or 'us', from the session's keyboard layout.

    Both a German and a US Blade 16 (2024) exist with the SAME DMI name, so
    the machine cannot tell them apart -- only the chosen keymap can. If that
    lookup fails, German is assumed because the owner of this config is on a
    German board, and the title says which one is in use so a wrong guess is
    visible rather than silent.
    """
    try:
        import subprocess
        out = subprocess.run(["localectl", "status"], capture_output=True,
                             timeout=1.5).stdout.decode(errors="replace")
        if "de" in out.lower():
            return "de"
    except (OSError, ValueError):
        pass
    return "de"


def detect_kb_profile():
    """Pick this computer's board from DMI + the session keymap."""
    name = " ".join([
        read("/sys/class/dmi/id/sys_vendor", ""),
        read("/sys/class/dmi/id/product_name", ""),
        read("/sys/class/dmi/id/product_version", ""),
    ]).lower()
    locale = _kb_locale()
    for prof in KB_PROFILES:
        if locale not in (prof["locale"], "any"):
            continue
        if any(m in name for m in prof["match"]):
            return prof
    return KB_FALLBACK


_KB_PROFILE = detect_kb_profile()
KB_LAYOUT = _KB_PROFILE["layout"]
KB_COLS = _KB_PROFILE["cols"]
KB_ROWS = _KB_PROFILE["rows"]

# Fail loudly at import rather than silently painting the wrong keys: a row
# whose spans do not add up to the column count shifts every key after the
# error by one cell, and the first symptom would be "the board lights up but
# not the keys I clicked" -- with no clue where to look.
_bad = [i for i, r in enumerate(KB_LAYOUT)
        if sum(s for _, s in r) != KB_COLS]
if _bad:
    raise SystemExit(
        f"razer-command-center: keyboard layout row(s) {_bad} do not sum "
        f"to {KB_COLS} columns — check KB_PROFILES before painting anything.")


# Glyph safety.
#
# Every label above is drawn with cairo's toy font API, which takes a single
# family and does NO font fallback: one character the family lacks becomes
# .notdef -- the empty rectangle the owner saw on Backspace, Enter, Shift,
# Caps and the Win key. cairo resolves "sans" through fontconfig, and on
# this system that is Noto Sans, which has none of U+232B (erase to the
# left), U+21B5 (return), U+21A9/U+21EA (shifts/caps) or U+2744 (Win).
#
# Two independent fixes, because relying on either one alone is fragile:
#   1. KEY_FONT below is a family that actually carries every glyph used
#      here (verified with fc-list ":charset=..." on this machine), and it
#      is set explicitly instead of letting fontconfig pick.
#   2. The arrow cluster uses U+2190..U+2193 (LEFTWARDS/UPWARDS/DOWNWARDS/
#      RIGHTWARDS ARROW) rather than U+25C0/U+25B2/U+25BC/U+25B6 (the black
#      geometric triangles), because the arrows are in plain Latin-1-era
#      text fonts and the triangles are not -- verified: Noto Sans, DejaVu
#      Sans, Adwaita Sans and Cantarell all carry 2190-2193, and none of
#      them carries 25B2.
# The German umlauts, ß, °, ´ and the backspace/shift/enter glyphs are all
# present in DejaVu Sans.
KEY_FONT = "DejaVu Sans"


def _cairo_of(snap, w, h):
    if hasattr(snap, "append_cairo"):
        rect = Graphene.Rect()
        rect.init(0, 0, w, h)
        return snap.append_cairo(rect)
    return snap


def _rounded(ctx, x, y, w, h, r):
    r = min(r, w / 2, h / 2)
    ctx.new_sub_path()
    ctx.arc(x + w - r, y + r, r, -math.pi / 2, 0)
    ctx.arc(x + w - r, y + h - r, r, 0, math.pi / 2)
    ctx.arc(x + r, y + h - r, r, math.pi / 2, math.pi)
    ctx.arc(x + r, y + r, r, math.pi, 3 * math.pi / 2)
    ctx.close_path()


def _hsv(h, s, v):
    import colorsys
    return colorsys.hsv_to_rgb(h, s, v)


# How a painted key is drawn.
#
# This used to tone-map every painted key before drawing it: saturation was
# capped at 0.30, lightness was multiplied by 0.80 and then capped at 0.46, and
# the fill was composited at 0.88 alpha. The idea was to stop a full-strength
# LED colour from glaring against the app's neutral chrome. The owner's verdict
# was that the board read as "more faded when looking on the keyboard" than the
# keys really are -- which is correct. Measured on this app's own accent green
# #3FB950: saturation 0.492 -> 0.300 (the cap), lightness 0.486 -> 0.389, and
# the 0.88 alpha then composited it over the 0.13 keycap grey, leaving the
# green channel at 0.461 against a true 0.725 -- about 64% of its real value.
# Picking a colour in this app is a decision about the LIGHTING, and judging it
# from a deliberately falsified preview is not a usable workflow.
#
# The replica is still a true preview: what is painted here is what the key
# lights up. That is also why no tone map exists any more -- _keycap_color is
# the identity, kept as a named seam so the alpha/contrast code below has one
# place to read the displayed colour from.
#
# What changed is WHERE the colour goes. The replica no longer FILLS a keycap
# with it. Filling
# 90+ keycaps with a saturated colour turns the board into a solid slab of
# light: neighbouring keys bleed into each other, the labels lose contrast,
# and an effect like a rainbow or a wave is unreadable because the whole
# rectangle glows at once. The keycap is now always the neutral dark plastic
# it really is; the LED colour appears where the eye actually reads it --
# the key's LABEL and its BORDER.
KEYCAP_FILL = (0.125, 0.125, 0.125)     # unlit keycap plastic
KEYCAP_FILL_HOVER = (0.165, 0.165, 0.165)
KEYCAP_EDGE = (1.0, 1.0, 1.0, 0.10)     # unlit keycap hairline


def _keycap_color(rgb):
    """The colour a painted key is drawn in. Kept as a named seam.

    Returned unchanged (the paint colour); the draw code uses it for the
    label and the border, not for the fill. A single seam means there is
    exactly one place to change if the displayed colour ever needs mapping,
    and the frame written to the device never went through it either way.
    """
    return rgb


def _led_ink(rgb):
    """The LED colour, lifted until it is actually readable as text.

    A dark paint colour (a deep blue, a near-black red) is invisible as a
    label on a 0.125 keycap. Rec.709 luminance is scaled up until it clears
    LABEL_LUM, which keeps the hue and the relationship between channels --
    it is a legibility floor, not a second tone map: bright colours pass
    through untouched.
    """
    lum = 0.2126 * rgb[0] + 0.7152 * rgb[1] + 0.0722 * rgb[2]
    if lum >= LABEL_LUM:
        return rgb
    k = LABEL_LUM / max(lum, 0.04)
    return tuple(min(1.0, c * k) for c in rgb)


LABEL_LUM = 0.55       # minimum perceived luminance of a painted key label
LED_EDGE_ALPHA = 0.95  # how strongly a painted key's border shows its colour
LED_LABEL_ALPHA = 0.95
UNLIT_LABEL_ALPHA = 0.45


# ── interactive keyboard replica ─────────────────────────────────────────────

# True only while the control center's window is actually on screen.
#
# The keyboard preview redraws itself at 20 Hz whenever an animated effect is
# selected, and with the app running in the background (`--background`, the
# default at login) there is no window for that to draw into. Left alone that
# is 20 wakeups a second for the whole session, producing frames nobody sees.
# The board consults this before arming its timer, and the window flips it in
# its visible-property handler.
UI_VISIBLE = False


class KbdBoard(Gtk.DrawingArea):
    """Blade-16 replica: every key rendered, clickable, colored from the
    active profile.

    Mouse language (iCUE-style):
      click            paint / erase that one key immediately
      press + drag     rubber-band marquee; on release the active tool is
                       applied to EVERY key inside the box
    """

    DRAG_THRESHOLD = 6  # px before a press becomes a marquee

    # Size. The board is 16 LED cells wide and 6 rows deep, and a keycap is
    # 1u x 1u, so a real Blade 16 keyboard is about 16/6 = 2.7 times as wide
    # as it is tall. The old request was 640x230 (2.8:1) BUT the widget also
    # set_hexpand(True), so in a maximized 1100px window the board was handed
    # ~1000px of width and only 230px of height: every keycap became a wide
    # flat slab, the labels sat in a sea of empty keycap, and the whole thing
    # ran the full width of the app. KEY_W below is the 1u cell including its
    # gap, so the board is exactly 16 x KEY_W wide and 6 x KEY_W tall plus
    # the frame padding, and the keys stay square. The widget still spans
    # the content column -- it is the BOARD inside it that is fixed and
    # centred (_geom), so the keyboard never stretches.
    # 1u cell. 31px was comfortable to look at but small to hit with a
    # mouse; 36px is the smallest size that still reads as a target
    # without the 16x6 board swallowing the page. At 36 the board is
    # 596x236, which fits the 820px column with room to spare.
    KEY_W = 36.0
    PAD = 10.0

    @classmethod
    def board_size(cls):
        w = 2 * cls.PAD + KB_COLS * cls.KEY_W
        h = 2 * cls.PAD + 6 * cls.KEY_W
        return int(round(w)), int(round(h))

    def __init__(self, window):
        super().__init__()
        self.win = window
        bw, bh = self.board_size()
        # The widget spans the content column and the BOARD is centred
        # inside it (_geom's ox/oy). Deliberately NO set_content_width(bw):
        # in GTK4 that is a MINIMUM width, and a 516px minimum would make a
        # narrow window clip the right-hand keys instead of shrinking them.
        # Height IS pinned, because a keyboard is not a flexible element.
        self.set_content_height(bh)
        self.set_size_request(-1, bh)
        self.set_hexpand(True)
        self.set_vexpand(False)
        self.set_halign(Gtk.Align.FILL)
        self.set_draw_func(self._draw, None)

        self._hover = None
        self._btn_down = False
        self._press_xy = None        # pixel where the press began
        self._dragging = False
        self._marquee = None         # (r0, c0, r1, c1) normalized

        click = Gtk.GestureClick()
        click.set_button(1)
        click.connect("pressed", self._on_press)
        click.connect("released", self._on_release)
        self.add_controller(click)

        motion = Gtk.EventControllerMotion()
        motion.connect("motion", self._on_motion)
        self.add_controller(motion)

    # geometry -------------------------------------------------------------
    def _geom(self, w, h):
        """Board origin + key size, in widget pixels.

        ox/oy centre the 16x6 board inside whatever the widget was actually
        allocated, so the hit-testing in _key_at can never disagree with what
        _draw painted. cells is the unit key width INCLUDING the gap; kw/kh
        are the drawn keycap size (cell minus gap).
        """
        cell = self.KEY_W
        # Shrink to fit: the board is fixed at 516px, but a narrow window
        # (or a narrower content column) must never clip it -- the scroller
        # has no horizontal policy, so a clipped keycap is simply lost.
        cell = min(cell, (w - 2 * self.PAD) / KB_COLS,
                   (h - 2 * self.PAD) / KB_ROWS)
        cell = max(cell, 12.0)
        ox = (w - (2 * self.PAD + KB_COLS * cell)) / 2.0
        oy = (h - (2 * self.PAD + KB_ROWS * cell)) / 2.0
        return ox, oy, self.PAD, cell - 3.0, cell - 3.0

    def _key_at(self, x, y):
        w = self.get_width()
        h = self.get_height()
        ox, oy, pad, kw, kh = self._geom(w, h)
        cell = kw + 3.0
        row = int((y - oy - pad) // cell)
        if not (0 <= row < len(KB_LAYOUT)):
            return None
        col = int((x - ox - pad) // cell)
        if not (0 <= col < 16):
            return None
        return row, col

    def _on_motion(self, ctrl, x, y):
        self._hover = self._key_at(x, y)
        if self._btn_down and self._press_xy is not None:
            dx = x - self._press_xy[0]
            dy = y - self._press_xy[1]
            if self._dragging or math.hypot(dx, dy) > self.DRAG_THRESHOLD:
                self._dragging = True
                start = self._key_at(*self._press_xy)
                cur = self._key_at(x, y)
                if start and cur:
                    self._marquee = (min(start[0], cur[0]),
                                     min(start[1], cur[1]),
                                     max(start[0], cur[0]),
                                     max(start[1], cur[1]))
                elif cur:
                    self._marquee = (cur[0], cur[1], cur[0], cur[1])
        self.queue_draw()

    def _on_press(self, gesture, n, x, y):
        self._btn_down = True
        self._press_xy = (x, y)
        self._dragging = False
        self._marquee = None

    def _on_release(self, gesture, n, x, y):
        self._btn_down = False
        if self._dragging and self._marquee is not None:
            r0, c0, r1, c1 = self._marquee
            self._marquee = None
            self._dragging = False
            self.win.on_keys_region(r0, c0, r1, c1)
        else:
            pos = self._key_at(x, y)
            if pos:
                self.win.on_key_clicked(*pos)
        self._press_xy = None
        self.queue_draw()

    # painting ---------------------------------------------------------------
    def _draw(self, area, snap, w, h, _ud):
        ctx = _cairo_of(snap, w, h)
        ox, oy, pad, kw, kh = self._geom(w, h)
        cell = kw + 3.0
        keycolors = self.win.current_key_colors()

        # Frame interior follows the theme's card colour via CAIRO_THEME
        # (see apply_theme), so the board rethemes with the rest of the app.
        ctx.set_source_rgb(*ctheme("board_bg", (0.086, 0.086, 0.086)))
        _rounded(ctx, 0, 0, w, h, 18)
        ctx.fill()

        # Explicit family: cairo's toy API does no fallback, so a family that
        # lacks a glyph renders .notdef (the empty rectangles). See KEY_FONT.
        ctx.select_font_face(KEY_FONT, cairo.FONT_SLANT_NORMAL,
                             cairo.FONT_WEIGHT_NORMAL)
        font_size = max(8.0, min(12.0, kh * 0.38))
        ctx.set_font_size(font_size)
        for r, row in enumerate(KB_LAYOUT):
            c = 0
            for label, span in row:
                hx = keycolors.get((r, c), "#000000")
                x = ox + pad + c * cell
                y = oy + pad + r * cell
                wpx = kw * span + 3.0 * (span - 1)
                painted = bool(hx)

                # The keycap is ALWAYS neutral plastic. The LED colour is
                # shown on the label and the border instead (see the block
                # comment above KEYCAP_FILL), so a painted board reads as a
                # set of coloured glyphs rather than a slab of light.
                fill = (ctheme("keycap_hover", KEYCAP_FILL_HOVER)
                        if self._hover == (r, c)
                        else ctheme("keycap", KEYCAP_FILL))
                ctx.set_source_rgb(*fill)
                _rounded(ctx, x, y, wpx, kh, 4)
                ctx.fill()

                if painted:
                    ink = _led_ink(_keycap_color(_hex_rgb(hx)))
                else:
                    ink = None

                # keycap edge: the paint colour when lit, a plain hairline
                # when not.
                if ink:
                    ctx.set_source_rgba(ink[0], ink[1], ink[2],
                                       LED_EDGE_ALPHA)
                else:
                    ctx.set_source_rgba(*ctheme("keycap_edge", KEYCAP_EDGE))
                ctx.set_line_width(1.2 if ink else 1.0)
                _rounded(ctx, x + 0.5, y + 0.5, wpx - 1, kh - 1, 4)
                ctx.stroke()

                if (self._hover == (r, c)):
                    ctx.set_source_rgba(*ctheme("hover_ring",
                                                (1, 1, 1, 0.30)))
                    ctx.set_line_width(1.0)
                    _rounded(ctx, x + 0.5, y + 0.5, wpx - 1, kh - 1, 4)
                    ctx.stroke()

                if label and kh > 14:
                    if ink:
                        ctx.set_source_rgba(ink[0], ink[1], ink[2],
                                           LED_LABEL_ALPHA)
                    else:
                        ctx.set_source_rgba(*ctheme(
                            "unlit_label", (1, 1, 1, UNLIT_LABEL_ALPHA)))
                    ext = ctx.text_extents(label)
                    if ext.width <= wpx - 3:
                        ctx.move_to(x + (wpx - ext.width) / 2,
                                    y + kh / 2 + ext.height / 2)
                        ctx.show_text(label)
                    else:
                        # Shrink to fit rather than drop the label: on a
                        # narrow cell "Bild↑" or "alt gr" is what tells the
                        # owner which key this is.
                        fs = font_size
                        while fs > 6.0:
                            fs -= 0.5
                            ctx.set_font_size(fs)
                            ext = ctx.text_extents(label)
                            if ext.width <= wpx - 3:
                                break
                        else:
                            ctx.set_font_size(font_size)
                        if ext.width <= wpx - 3:
                            ctx.move_to(x + (wpx - ext.width) / 2,
                                        y + kh / 2 + ext.height / 2)
                            ctx.show_text(label)
                        ctx.set_font_size(font_size)
                c += span

        # marquee: tint every covered key + dashed selection rect
        if self._marquee is not None:
            r0, c0, r1, c1 = self._marquee
            x0 = ox + pad + c0 * cell
            y0 = oy + pad + r0 * cell
            x1 = ox + pad + (c1 + 1) * cell - 3.0
            y1 = oy + pad + (r1 + 1) * cell - 3.0
            # Marquee highlight: neutral like the rest of the chrome.
            ctx.set_source_rgba(*ctheme("marquee_fill",
                                        (0.910, 0.918, 0.929, 0.10)))
            ctx.rectangle(x0, y0, x1 - x0, y1 - y0)
            ctx.fill()
            ctx.set_source_rgba(*ctheme("marquee_edge",
                                        (0.910, 0.918, 0.929, 0.9)))
            ctx.set_line_width(1.5)
            ctx.set_dash([5.0, 4.0])
            ctx.rectangle(x0, y0, x1 - x0, y1 - y0)
            ctx.stroke()
            ctx.set_dash([])
            for rr in range(r0, r1 + 1):
                cc0 = c0 if rr == r0 else 0
                cc1 = c1 if rr == r1 else 15
                for cc in range(cc0, cc1 + 1):
                    # highlight border of covered keys (span-aware approx:
                    # highlight the LED cell, which is what gets painted)
                    hx_pos = ox + pad + cc * cell
                    hy_pos = oy + pad + rr * cell
                    ctx.set_source_rgba(*ctheme("hover_ring",
                                                (1, 1, 1, 0.30)))
                    ctx.set_line_width(1)
                    _rounded(ctx, hx_pos, hy_pos, kw, kh, 4)
                    ctx.stroke()


# ── animated mini preview for hardware effects (kept from v2) ───────────────

class KbdPreview(Gtk.DrawingArea):
    COLS, ROWS = KB_COLS, KB_ROWS

    def __init__(self):
        super().__init__()
        self.effect = "static"
        self.c1 = _hex_rgb("#3fb950")
        self.c2 = _hex_rgb("#101010")
        self._t0 = time.time()
        self._tick_src = None
        self.set_content_height(110)
        self.set_hexpand(True)
        self.set_draw_func(self._draw, None)

    def set_effect(self, name, c1hex, c2hex):
        self.effect = name
        try:
            self.c1 = _hex_rgb(c1hex)
            self.c2 = _hex_rgb(c2hex)
        except ValueError:
            pass
        self._t0 = time.time()
        self.queue_draw()
        self._pump()

    def _pump(self):
        animated = self.effect in ("wave", "ripple", "reactive", "breath",
                                   "starlight", "spectrum")
        # Only animate while there is a window to animate into (UI_VISIBLE).
        if animated and UI_VISIBLE and self._tick_src is None:
            self._tick_src = GLib.timeout_add(50, self._on_tick)
        elif (not animated or not UI_VISIBLE) and self._tick_src is not None:
            GLib.source_remove(self._tick_src)
            self._tick_src = None

    def _on_tick(self):
        self.queue_draw()
        if self.effect in ("wave", "ripple", "reactive", "breath",
                           "starlight", "spectrum"):
            return GLib.SOURCE_CONTINUE
        self._tick_src = None
        return GLib.SOURCE_REMOVE

    def _key_color(self, i, j, t):
        e = self.effect
        c1, c2 = self.c1, self.c2
        if e == "static":
            return c1
        if e == "none":
            return (0.09, 0.09, 0.10)
        if e == "spectrum":
            return _hsv(((i / self.COLS) * 300 + t * 50) % 360 / 360,
                        0.85, 1.0)
        k = None
        if e == "wave":
            k = 0.5 + 0.5 * math.sin(i * 0.55 - t * 3.2)
        elif e == "breath":
            k = 0.15 + 0.85 * (0.5 + 0.5 * math.sin(t * 2.1))
        elif e in ("ripple", "reactive"):
            d = math.hypot((i - self.COLS / 2) * 0.8,
                           (j - self.ROWS / 2) * 1.6)
            k = (0.5 + 0.5 * math.sin(d * 1.4 - t *
                 (4.0 if e == "ripple" else 6.0))) ** 3
        elif e == "starlight":
            seed = math.sin(i * 12.9898 + j * 78.233) * 43758.5453
            k = max(0.0, math.sin(t * 2.2 +
                                  (seed - math.floor(seed)) * 6.28)) ** 6
        if k is None:
            return c1
        return tuple(c1[q] * k + c2[q] * (1 - k) for q in range(3))

    def _draw(self, area, snap, w, h, _ud):
        ctx = _cairo_of(snap, w, h)
        t = time.time() - self._t0
        pad, gapx, gapy = 6.0, 2.5, 3.0
        kw = (w - 2 * pad - (self.COLS - 1) * gapx) / self.COLS
        kh = (h - 2 * pad - (self.ROWS - 1) * gapy) / self.ROWS
        for j in range(self.ROWS):
            for i in range(self.COLS):
                col = self._key_color(i, j, t)
                ctx.set_source_rgba(col[0], col[1], col[2], 1.0)
                _rounded(ctx, pad + i * (kw + gapx), pad + j * (kh + gapy),
                         kw, kh, 2.5)
                ctx.fill()


# ── power gauge (kept from v2) ───────────────────────────────────────────────

# The gauge draws in Python, outside the stylesheet, so it carries the
# theme itself: a near-white (#e8eaed) for the arc and label. Same value
# as the CSS accent_color above -- keep the two in step.
ACCENT = (0.910, 0.918, 0.929)          # #e8eaed
TRACK = (1.0, 1.0, 1.0, 0.09)

# Content column (layout A + template 2). Past CONTENT_MAX_W the column
# stops growing and centres instead, so a maximized window no longer smears
# every row edge to edge. Below CONTENT_TIGHT_W the clamp stops adding its
# own padding and just follows the pane, which keeps the app usable down to
# its 520px minimum window width. Template 2 is the widest of the five
# (820), because it removed the group cards and so has nothing to gain from
# a narrow measure.
CONTENT_MAX_W = 980
CONTENT_TIGHT_W = 640
RAIL_W = 232               # wider rail: room for label + live value
# The rail's icon-only width. The label and the live value are what make it
# 232px, and they are the first thing worth losing when the window is narrow:
# the icons still identify the five pages, and every value on the rail is
# also on the page it points at. 232px of a 520px window is nearly half the
# window spent on navigation chrome.
RAIL_W_NARROW = 64
# Breakpoint thresholds, in logical px. Deliberately well below the maximized
# width (1600 logical on this panel) so an ordinary maximized window never
# sees any of this -- it only engages when the window is actually made small.
BP_STACK_W = 860           # below: side-by-side blocks stack
BP_RAIL_W = 760            # below: the rail drops to icons only

# The rail's per-item value column. Only the runtime_status strings that
# /sys/bus/pci/devices/.../power/runtime_status actually emits are mapped;
# anything else falls back to an em dash rather than showing raw sysfs.
GPU_STATE_LABELS = {
    "active": "awake", "suspended": "asleep", "suspending": "asleep",
    "resuming": "awake", "support": "—", "?": "—",
}


class Gauge(Gtk.DrawingArea):
    def __init__(self, vmax, unit, sub, size=(180, 130)):
        super().__init__()
        self.value = 0.0
        self.vmax = float(vmax)
        self.unit = unit
        self.sub = sub
        self.set_content_width(size[0])
        self.set_content_height(size[1])
        self.set_draw_func(self._draw, None)

    def set_value(self, v):
        try:
            self.value = max(0.0, min(float(v), self.vmax))
        except (TypeError, ValueError):
            self.value = 0.0
        self.queue_draw()

    def set_sub(self, sub):
        self.sub = sub
        self.queue_draw()

    def _draw(self, area, snap, w, h, _ud):
        ctx = _cairo_of(snap, w, h)
        cx, cy = w / 2, h * 0.60
        r = min(w * 0.40, h * 0.55)
        a0, a1 = math.radians(140), math.radians(400)

        ctx.set_line_width(11)
        ctx.set_line_cap(cairo.LINE_CAP_ROUND)
        ctx.set_source_rgba(*ctheme("gauge_track", TRACK))
        ctx.arc(cx, cy, r, a0, a1)
        ctx.stroke()

        frac = self.value / self.vmax if self.vmax else 0
        if frac > 0.003:
            ctx.set_source_rgb(*ctheme("gauge_accent", ACCENT))
            ctx.arc(cx, cy, r, a0, a0 + (a1 - a0) * frac)
            ctx.stroke()

        ctx.set_source_rgb(*ctheme("gauge_text", (0.96, 0.96, 0.96)))
        ctx.select_font_face("monospace", cairo.FONT_SLANT_NORMAL,
                             cairo.FONT_WEIGHT_BOLD)
        ctx.set_font_size(26)
        text = f"{self.value:.0f}"
        ext = ctx.text_extents(text)
        ctx.move_to(cx - ext.width / 2, cy + ext.height / 2)
        ctx.show_text(text)

        ctx.set_source_rgba(*ctheme("gauge_sub", (1.0, 1.0, 1.0, 0.55)))
        ctx.set_font_size(10)
        for dy, txt in ((cy + 26, self.unit), (cy + 40, self.sub)):
            e = ctx.text_extents(txt)
            ctx.move_to(cx - e.width / 2, dy)
            ctx.show_text(txt)


# ── the window ───────────────────────────────────────────────────────────────

class RcWindow(Adw.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app)
        self._updating = False
        self._refreshing = False
        self._scr_last = 0.0
        self._kbd_last = 0.0
        self._scr_timer = None
        self._kbd_timer = None

        # lighting editor state
        self._lighting = load_lighting()
        # Blocks built for the page currently being assembled, in build
        # order. Drained by _finish_page at the end of every builder.
        self._order = []
        self._tool = "brush"           # brush | eraser
        self._brush_color = "#3fb950"
        self._recent = ["#3fb950", "#58a6ff", "#e5534b", "#e2a336",
                        "#a371f7", "#ffffff"]

        self.set_title("Razer Command Center")
        # Open BIG (maximized) — the content column inside adapts; on a
        # smaller screen the window shrinks fine down to the minimum, where
        # the bottom switcher bar takes over from the title switcher.
        self.set_default_size(1100, 820)
        self.set_size_request(520, 620)
        self.maximize()
        self.set_icon_name(ICON)

        # Appearance: the user's saved choice (light / dark / system), not a
        # hard-coded dark. Applied before the CSS loads so the first frame is
        # already in the right scheme.
        apply_theme(read_theme())
        provider = Gtk.CssProvider()
        provider.load_from_data(CSS, -1)
        Gtk.StyleContext.add_provider_for_display(
            Gdk.Display.get_default(), provider,
            Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

        self._toasts = Adw.ToastOverlay()
        self.set_content(self._toasts)
        toolbar = Adw.ToolbarView()
        self._toasts.set_child(toolbar)

        header = Adw.HeaderBar()
        header.set_title_widget(Gtk.Label(label="Razer Command Center"))
        refresh = Gtk.Button(icon_name="view-refresh-symbolic")
        refresh.set_tooltip_text("Refresh live values")
        refresh.set_valign(Gtk.Align.CENTER)
        refresh.connect("clicked", lambda *_: self.refresh())
        header.pack_end(refresh)
        toolbar.add_top_bar(header)

        # GPU transition tracker (session sleep/wake event log)
        self._gpu_state = gpu_runtime_status()
        self._gpu_events = []

        # a plain Gtk.Stack: the Workspace rail is a Gtk.StackSidebar, which
        # binds to Gtk.Stack (Adw.ViewStack is not accepted here) and the
        # old Adw switcher bars are gone anyway.
        # Widgets that must STACK when the window is narrow, and the rail's
        # own text, both collected during the builds below and turned into
        # breakpoints once the shell is assembled. Collecting them as they are
        # created is what keeps this from needing a second pass over the
        # builders: a new hero or a new side-by-side pair registers itself by
        # being built through _reflow_box, and cannot be forgotten.
        self._reflow = []
        self._reflow_pairs = []
        self._nav_labels = []

        self._stack = Gtk.Stack()
        self._build_lighting()
        self._build_display()
        self._build_power()
        self._build_gpu()
        self._build_diag()

        # WORKSPACE SHELL: navigation docked in a left rail, live telemetry
        # pinned at the rail's foot, pages scrolling on the right.
        rail = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        rail.add_css_class("rcc-rail")
        self._rail = rail

        # Device identity at the head of the rail, above the nav.
        brand = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=1)
        brand.add_css_class("rail-brand")
        b1 = Gtk.Label(label="Razer Blade 16")
        b1.set_xalign(0.0)
        b1.add_css_class("rail-brand-title")
        b2 = Gtk.Label(label="2024 · openrazer")
        b2.set_xalign(0.0)
        b2.add_css_class("rail-brand-sub")
        brand.append(b1)
        brand.append(b2)
        rail.append(brand)

        rail.append(self._nav_label("Device"))

        # The nav is a hand-built Gtk.ListBox, not a Gtk.StackSidebar.
        # The sidebar could only ever produce "icon + label" rows: no
        # per-item value on the trailing edge (the 84% next to Power, the
        # mode next to GPU), no group headings, and a selected-row style
        # owned by libadwaita's stylesheet rather than by this app's. Every
        # one of those is in the design, so the rows are built here -- the
        # pages still register themselves in the Gtk.Stack, so there is
        # still exactly one source of truth for what the pages are.
        self._nav_list = Gtk.ListBox()
        self._nav_list.set_selection_mode(Gtk.SelectionMode.SINGLE)
        self._nav_list.add_css_class("rcc-nav")
        self._nav_status = {}
        self._nav_rows = []
        child = self._stack.get_first_child()
        while child is not None:
            page = self._stack.get_page(child)
            name = page.get_name()
            row = Gtk.ListBoxRow()
            row.set_name(name)
            row.add_css_class("nav-row")
            box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
            box.set_margin_start(11)
            box.set_margin_end(11)
            box.set_margin_top(9)
            box.set_margin_bottom(9)
            icon = Gtk.Image.new_from_icon_name(page.get_icon_name())
            icon.add_css_class("nav-icon")
            label = Gtk.Label(label=page.get_title())
            label.set_xalign(0.0)
            label.set_hexpand(True)
            label.add_css_class("nav-label")
            self._nav_labels.append(label)
            val = Gtk.Label(label="")
            val.add_css_class("nav-value")
            # The rail drops its labels on a narrow window, and an icon on
            # its own does not say which page it is. The row's tooltip is
            # what carries the name in that mode (and it is free).
            row.set_tooltip_text(page.get_title())
            box.append(icon)
            box.append(label)
            box.append(val)
            row.set_child(box)
            self._nav_list.append(row)
            self._nav_rows.append(row)
            self._nav_status[name] = val
            child = child.get_next_sibling()
        self._nav_list.connect(
            "row-selected",
            lambda _l, row: (self._stack.set_visible_child_name(
                row.get_name()) if row is not None else None))
        if self._nav_rows:
            # Gtk.ListBox.select_row, not set_selected_row -- the latter is
            # not a ListBox method in GTK4.
            self._nav_list.select_row(self._nav_rows[0])
        sidebar = self._nav_list
        sidebar.set_vexpand(True)
        rail.append(sidebar)

        self._rail_stats = Gtk.Label(label="…")
        self._rail_stats.set_use_markup(True)
        self._rail_stats.set_halign(Gtk.Align.START)
        self._rail_stats.set_xalign(0.0)
        self._rail_stats.add_css_class("rail-stats")
        rail.append(self._rail_stats)

        content = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
        rail.set_size_request(RAIL_W, -1)
        content.append(rail)

        # Content column: the stack spans the rest of the window, and the
        # per-page Adw.Clamp inside each scroller caps and centres the
        # actual content. The margins below are the ONLY outer air; the
        # column itself is never wider than CONTENT_MAX_W however wide the
        # window gets. The mockup this was drawn from had 16px here and
        # 30px inside the column, which is why the first implementation
        # looked tighter than the design it was copied from.
        self._stack.set_margin_start(16)
        self._stack.set_margin_end(16)
        self._stack.set_margin_top(8)
        self._stack.set_margin_bottom(16)
        scroll = Gtk.ScrolledWindow()
        scroll.set_child(self._stack)
        scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        scroll.set_vexpand(True)
        content.append(scroll)
        toolbar.set_content(content)

        self._install_breakpoints(rail, brand)

        self.refresh()
        # The 5 s refresh only runs while the window is actually up. It reads
        # battery, power profile, the chroma daemon, GPU state, panel
        # brightness, fan mode, CPU temp and more -- roughly fifteen process
        # spawns per tick. None of that is visible with the window hidden, and
        # this app is meant to sit in the background for the whole session, so
        # a hidden window does no polling at all. `_tick` re-arms nothing: the
        # timer stays registered and simply does nothing, which keeps show and
        # hide free of add/remove bookkeeping (and of a missed first tick).
        GLib.timeout_add_seconds(5, self._tick)
        # The one-shot restores (saved lighting, panel brightness, fan mode)
        # and the 2-minute daylight-cap tick are the APP's job now, not the
        # window's, so they still happen when the window is never opened --
        # and they run in exactly one place, so the cap is never applied twice
        # per interval. See RazerControlCenter._enforce() / _cap_tick().
        app._enforce()

    def _install_breakpoints(self, rail, brand):
        """Make the window adapt instead of merely shrinking.

        The window already had a minimum size, a maximized default and a
        Clamp on the content column, so it degraded gracefully in one
        direction (very wide) and badly in the other (narrow). What was
        missing was any reaction to width at all: side-by-side panels stayed
        side by side at 520px, and the rail kept its 232px of labels and live
        values while the page it was supposed to frame had 256px to work
        with. Worse, the window's own content had a ~790px floor, so the
        compositor clamped every request to about that and the minimum size
        the window advertised was simply unreachable.

        The fix is one pass that finds the rows which genuinely cannot fit and
        makes them one column, plus a rail that gives up its text. Both are
        driven by breakpoints rather than a size-changed handler, so each
        reverts itself: the breakpoint owns the state while it applies, and
        there is no "remember what it was" to get wrong and no way to end up
        stuck in the narrow layout.

        Neither threshold is anywhere near a maximized window (1600 logical px
        on this panel), so the ordinary case is untouched -- all of this only
        engages when the window is deliberately made small.
        """
        narrow_bp = Adw.Breakpoint()
        narrow_bp.set_condition(Adw.BreakpointCondition.parse(
            f"max-width: {BP_STACK_W}px"))
        narrow_bp.connect("apply", lambda *_a: self._reflow_pass(True))
        narrow_bp.connect("unapply", lambda *_a: self._reflow_pass(False))
        self.add_breakpoint(narrow_bp)

        # Narrower still: the rail drops to icons. A separate threshold
        # because losing the rail's text is a bigger loss than stacking a
        # row, and it should not happen until stacking is not enough.
        # Handled in apply/unapply because two of the three things it does
        # are not properties: the rail's own size request, and the CSS class
        # that tightens the padding around the bare icons.
        rail_bp = Adw.Breakpoint()
        rail_bp.set_condition(Adw.BreakpointCondition.parse(
            f"max-width: {BP_RAIL_W}px"))
        rail_bp.connect("apply", lambda *_a: self._set_rail_compact(True))
        rail_bp.connect("unapply", lambda *_a: self._set_rail_compact(False))
        self.add_breakpoint(rail_bp)

        # Short: the rail's furniture (the brand block and the telemetry
        # footer) goes first on a short window, because the page is what
        # needs the height. Every value it showed is also on the page it
        # points at.
        short_bp = Adw.Breakpoint()
        short_bp.set_condition(Adw.BreakpointCondition.parse(
            "max-height: 560px"))
        short_bp.add_setter(brand, "visible", False)
        short_bp.add_setter(self._rail_stats, "visible", False)
        self.add_breakpoint(short_bp)

    # ── reflow ───────────────────────────────────────────────────────────
    def _page_boxes(self):
        """Every Gtk.Box on every page, however deeply nested."""
        out = []

        def rec(w):
            c = w.get_first_child()
            while c is not None:
                if isinstance(c, Gtk.Box):
                    out.append(c)
                rec(c)
                c = c.get_next_sibling()

        child = self._stack.get_first_child()
        while child is not None:
            rec(child)
            child = child.get_next_sibling()
        return out

    def _reflow_limit(self):
        """Width a row must want before it is considered unable to fit.

        Measured from the window, not hardcoded, so it tracks the rail going
        compact and the window's own margins without a second constant to
        keep in sync.
        """
        rail = self._rail.get_width() or RAIL_W
        return max(240, (self.get_width() or 1100) - rail - 72) * 0.72

    def _reflow_pass(self, narrow):
        """Stack every row that cannot fit; restore exactly those on the way
        back out.

        The test is deliberately narrow in what it will touch. A row is only
        stacked when ALL of these hold:

          * it is horizontal,
          * it has two or more children (a lone child has nothing to stack),
          * it is either declared reflowable, or its own minimum width is
            wider than 72% of the space the page actually has.

        That last test is what separates a real multi-column composition from
        an ordinary "label, then a pill" row. A label row's minimum is about
        as wide as its label -- a couple of hundred pixels -- and never
        approaches the limit, so it is left alone. Stacking one would put the
        pill under its own label, which is worse than the cramped row it was
        meant to fix.

        The declared list still matters: a hero that happens to measure under
        the limit at 860px is stacked anyway, because at that width it is
        already too tight to read.
        """
        if not narrow:
            for box, homogeneous in reversed(getattr(self, "_flipped", [])):
                box.set_orientation(Gtk.Orientation.HORIZONTAL)
                if homogeneous is not None:
                    box.set_homogeneous(homogeneous)
            self._flipped = []
            return

        if getattr(self, "_flipped", None) is None:
            self._flipped = []
        limit = self._reflow_limit()
        declared = set(id(b) for b in self._reflow)
        for box in self._page_boxes():
            if box.get_orientation() != Gtk.Orientation.HORIZONTAL:
                continue
            n = 0
            c = box.get_first_child()
            while c is not None:
                n += 1
                c = c.get_next_sibling()
            if n < 2:
                continue
            if id(box) not in declared:
                if box.measure(Gtk.Orientation.HORIZONTAL, -1)[0] < limit:
                    continue
            was_homogeneous = None
            if hasattr(box, "get_homogeneous") and box.get_homogeneous():
                # Only means anything while sharing a row; stacked, forcing
                # the two halves to equal heights just opens a gap under the
                # shorter one.
                was_homogeneous = True
                box.set_homogeneous(False)
            box.set_orientation(Gtk.Orientation.VERTICAL)
            self._flipped.append((box, was_homogeneous))

    def _set_rail_compact(self, on):
        """Icon-only rail. See the RAIL_W_NARROW comment for why this goes."""
        if on:
            self._rail.add_css_class("rcc-rail-compact")
            for label in self._nav_labels:
                label.set_visible(False)
            for val in self._nav_status.values():
                val.set_visible(False)
            self._rail.set_size_request(RAIL_W_NARROW, -1)
            # The rail just gave back ~170px, which may be enough for a row
            # that was too wide a moment ago. Re-run the pass against the
            # space there is now, not the space there was when it applied.
            self._reflow_pass(True)
        else:
            self._reflow_pass(False)
            self._rail.remove_css_class("rcc-rail-compact")
            for label in self._nav_labels:
                label.set_visible(True)
            for val in self._nav_status.values():
                val.set_visible(True)
            self._rail.set_size_request(RAIL_W, -1)

    def _autodim_tick(self):
        # Read the bar's value on the GTK thread — worker threads never
        # touch widgets.
        v = int(self._kbd_slider.get_value())

        def job():
            was = getattr(self, "_capWasActive", None)
            active = day_cap_active()
            applied = autodim_tick()
            # Window ended while the app was open: the cap releases its
            # level and the brightness bar's own value is applied again.
            if was and not active:
                kbd_set_brightness("main", v)
                return v
            self._capWasActive = bool(active)
            return applied
        bg(job, lambda r: None)
        return GLib.SOURCE_CONTINUE

    # ── small builders ───────────────────────────────────────────────────
    def _mark(self, page, key, widget):
        """Append a block and remember what it IS.

        Pages used to be ordered by the order the builder code happened to
        run in, which is why the keyboard editor -- the thing the Lighting
        page exists for -- sat third, behind the daemon row and the profile
        chips. Reordering the code blocks would work but makes every future
        edit a merge hazard, so instead each block is tagged with a
        MEANINGFUL key as it is built and _finish_page sorts the finished
        page by those keys.
        """
        self._order.append((key, widget))
        page.append(widget)
        return widget

    def _finish_page(self, page, keys):
        """Sort the page's blocks into the order given by `keys`.

        Anything not named keeps its build order and lands at the end, so a
        new block is never silently dropped off the page.
        """
        blocks = self._order
        self._order = []
        rank = {k: i for i, k in enumerate(keys)}
        blocks.sort(key=lambda kv: rank.get(kv[0], len(keys)))
        for _k, w in blocks:
            page.remove(w)
        for _k, w in blocks:
            page.append(w)

    def _set_nav_value(self, page, text):
        lbl = self._nav_status.get(page)
        if lbl is not None and lbl.get_text() != text:
            lbl.set_text(text)

    @staticmethod
    def _nav_brightness(res):
        v = res.get("screen")
        try:
            return f"{int(v)}%" if v is not None else "—"
        except (TypeError, ValueError):
            return "—"

    @staticmethod
    def _nav_label(text):
        l = Gtk.Label(label=text.upper())
        l.set_xalign(0.0)
        l.add_css_class("nav-heading")
        return l

    def _page(self, name, title, icon):
        # Composed pages: a plain vertical Gtk.Box (any child allowed)
        # inside a scroller. Adw.PreferencesPage was dropped on purpose —
        # it clamps content to ~600px internally with no property to stop
        # it, and its add() only accepts groups, which made composed
        # two-column bands impossible. The Adw.PreferencesGroups themselves
        # (boxed lists, titles, descriptions) render identically anywhere,
        # so the look is unchanged; the page is now free to compose.
        page = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=24)
        # Inner air of the column, matching the design's 30px page padding.
        page.set_margin_start(14)
        page.set_margin_end(14)
        page.set_margin_top(12)
        page.set_margin_bottom(20)

        def add(w):
            page.append(w)
        page.add = add  # GTK3-style alias: builders keep calling page.add()

        scroll = Gtk.ScrolledWindow()
        # LAYOUT A: a capped, centred content column.
        #
        # The page used to be the scroller's child directly, so every group
        # stretched to the full width of the pane. At the window size this
        # app actually runs (791 logical px, 2560x1600 @1.6) that made the
        # whole UI read as stretched: rows touching both edges, the 516px
        # keyboard frame jammed against the pane edges, and a very long thin
        # scroll. Adw.Clamp is the one widget that can impose a maximum width
        # (GTK's CSS has min-width but no max-width, and set_size_request is
        # a MINIMUM, so neither can express this). Below the tightening
        # threshold it stops padding and simply follows the pane, so a narrow
        # window still works -- it just does not add air of its own.
        clamp = Adw.Clamp()
        clamp.set_maximum_size(CONTENT_MAX_W)
        clamp.set_tightening_threshold(CONTENT_TIGHT_W)
        clamp.set_child(page)
        scroll.set_child(clamp)
        # Horizontal AUTOMATIC, not NEVER. The Clamp normally sizes the
        # content to the pane, so this costs nothing and adds no scrollbar --
        # but when something genuinely cannot compress below the pane (a
        # hardware row whose title and suffix button together need more width
        # than there is), NEVER means the overflow is silently clipped and
        # there is no way to reach it. AUTOMATIC turns that same case into a
        # scrollbar, which is strictly better than losing the control.
        scroll.set_policy(Gtk.PolicyType.AUTOMATIC, Gtk.PolicyType.AUTOMATIC)
        scroll.set_vexpand(True)
        self._stack.add_titled(scroll, name, title)
        self._stack.get_page(scroll).set_icon_name(icon)
        return page

    def _add_section(self, page, text, key=None):
        """A CATEGORY header: 16px, and always above a set of panels.

        The empty titled group is the only way to put a standalone heading
        on a composed page. It carries the .section-head class so the
        stylesheet can set it apart from a panel title -- a section says
        what KIND of thing follows, a panel says WHICH thing.
        """
        g = Adw.PreferencesGroup(title=text)
        g.add_css_class("section-head")
        if key is not None:
            self._mark(page, key, g)
        else:
            page.append(g)
        return g

    def _panel(self, page, key, title=None, description=None):
        """A panel inside a section. Left untitled when the section header
        already names it -- a heading repeated two lines below is noise."""
        g = Adw.PreferencesGroup(title=title, description=description)
        return self._mark(page, key, g)

    def _two_col(self, page, left, right, key=None):
        """Compose two groups SIDE BY SIDE across the page's full width.

        The full-width pages made single-column stacks READ as stretched:
        every row ran wall to wall. Real app design composes — a hero band,
        then paired panels of related controls. This keeps the
        PreferencesGroup look (the boxed list, headers, description) while
        letting two related groups share one row; each half keeps its own
        natural width instead of a row stretching to 1300px.
        """
        pair = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=14)
        pair.set_hexpand(True)
        # Homogeneous only while they are side by side. Stacked, the two
        # panels have their own heights and forcing them equal would just
        # leave a gap under the shorter one.
        pair.set_homogeneous(True)
        self._reflow.append(pair)
        self._reflow_pairs.append(pair)
        pair.append(left)
        pair.append(right)
        if key is not None:
            self._mark(page, key, pair)
        else:
            page.add(pair)

    def _reflow_box(self, box):
        """Register a horizontal box that must stack when the window is narrow.

        Only for real multi-column compositions -- a hero band, a pair of
        panels. A row of "label, then a pill" is not one of these: stacking it
        would put the pill under its own label and make it worse, not better.
        """
        self._reflow.append(box)
        return box

    def _big_slider(self, value, cb):
        s = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0, 100, 1)
        s.set_draw_value(False)
        s.set_value(value)
        s.set_hexpand(True)
        s.add_css_class("razer-big-slider")
        s.connect("value-changed", cb)
        return s

    def _pill(self):
        lbl = Gtk.Label(label="…")
        lbl.add_css_class("pill")
        return lbl

    @staticmethod
    def _set_pill(lbl, text, kind):
        for k in ("pill-good", "pill-warn", "pill-bad"):
            lbl.remove_css_class(k)
        lbl.add_css_class({"good": "pill-good", "warn": "pill-warn",
                           "bad": "pill-bad"}[kind])
        lbl.set_text(text)

    def _icon_button(self, icon, tooltip, cb):
        b = Gtk.Button(icon_name=icon, valign=Gtk.Align.CENTER)
        b.set_tooltip_text(tooltip)
        b.connect("clicked", cb)
        return b

    def _tool_button(self, label, tool, cb):
        b = Gtk.ToggleButton(label=label)
        b.add_css_class("tool-btn")
        b.connect("toggled", lambda btn: cb(btn, tool))
        return b

    # ── Lighting ─────────────────────────────────────────────────────────
    def _build_lighting(self):
        page = self._page("lighting", "Lighting",
                          "keyboard-brightness-symbolic")

        # ── 1. the per-key editor (the reason this page exists) ──
        self._add_section(page, "Per-key lighting", key="sec-editor")
        # Untitled: the section header already says what this is. The board
        # panel below carries the how-to description.
        g = self._panel(page, "editor")
        row = Adw.ActionRow(title="Chroma daemon")
        self._pill_daemon = self._pill()
        self._set_pill(self._pill_daemon, "…", "warn")
        row.add_suffix(self._pill_daemon)
        # The three controls get real spacing (a shared 8px gap) so the
        # cluster reads as deliberate, not crammed against the pill.
        self._pill_daemon.set_margin_end(6)
        b_start = self._icon_button(
            "media-playback-start-symbolic", "Start daemon",
            self._on_daemon_start)
        b_start.add_css_class("row-icon-btn")
        b_restart = self._icon_button(
            "view-refresh-symbolic", "Restart daemon",
            self._on_daemon_restart)
        b_restart.add_css_class("row-icon-btn")
        b_stop = self._icon_button(
            "media-playback-stop-symbolic", "Stop daemon",
            self._on_daemon_stop)
        b_stop.add_css_class("row-icon-btn")
        row.add_suffix(b_start)
        row.add_suffix(b_restart)
        row.add_suffix(b_stop)
        # The daemon row IS the editor panel's content. It was created but
        # never appended (dropped in a reorder), so the panel rendered as an
        # empty rounded bar under the board -- the mystery pill.
        g.add(row)

        # ── 2. brightness ──
        self._add_section(page, "Brightness", key="sec-bright")
        g2 = self._panel(page, "brightness")
        self._kbd_slider = self._big_slider(30, self._on_kbd_slider)
        row = Adw.ActionRow(title="Keyboard brightness")
        row.add_suffix(self._kbd_slider)
        self._row_kbd = row
        g2.add(row)

        # ── 3. profiles (iCUE-style) ──
        self._add_section(page, "Profiles", key="sec-profiles")
        g = self._panel(page, "profiles")
        chipbox = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL,
                          spacing=6, homogeneous=False)
        chipbox.set_hexpand(True)
        self._chipbox = chipbox
        # The add chip: a dashed "+" at the end of the row — the iCUE way.
        # It creates AND switches, so painting starts immediately.
        b_add = Gtk.Button(label="＋ New")
        b_add.add_css_class("profile-add")
        b_add.set_tooltip_text("Create a new profile and start editing it")
        b_add.connect("clicked", self._on_profile_new)
        chipbox.append(b_add)
        g.add(chipbox)

        row = Adw.ActionRow(title="Manage")
        b_new = Gtk.Button(label="New", valign=Gtk.Align.CENTER)
        b_new.add_css_class("tool-btn")
        b_new.connect("clicked", self._on_profile_new)
        b_dup = Gtk.Button(label="Duplicate", valign=Gtk.Align.CENTER)
        b_dup.add_css_class("tool-btn")
        b_dup.connect("clicked", self._on_profile_duplicate)
        b_del = Gtk.Button(label="Delete", valign=Gtk.Align.CENTER)
        b_del.add_css_class("tool-btn")
        b_del.connect("clicked", self._on_profile_delete)
        b_apply = Gtk.Button(label="Apply to keyboard",
                             valign=Gtk.Align.CENTER)
        b_apply.add_css_class("suggested-action")
        b_apply.connect("clicked", self._on_profile_apply)
        for b in (b_new, b_dup, b_del, b_apply):
            row.add_suffix(b)
        g.add(row)

        sw_auto = Gtk.Switch(valign=Gtk.Align.CENTER)
        row = Adw.ActionRow(
            title="Apply the active profile at every login")
        row.add_suffix(sw_auto)
        row.set_activatable_widget(sw_auto)
        sw_auto.set_active(autostart_enabled())
        sw_auto.connect("notify::active", self._on_lighting_autostart)
        self._sw_light_autostart = sw_auto
        g.add(row)

        # daylight auto-dim (no ambient sensor on this model — time-based)
        self._add_section(page, "Daylight dimming", key="sec-dim")
        g = self._panel(page, "dim")
        sw_dim = Gtk.Switch(valign=Gtk.Align.CENTER)
        row = Adw.ActionRow(title="Cap keyboard brightness during the day")
        row.add_suffix(sw_dim)
        row.set_activatable_widget(sw_dim)
        sw_dim.connect("notify::active", self._on_autodim_toggled)
        self._sw_autodim = sw_dim
        g.add(row)

        self._spin_dim_pct = Adw.SpinRow.new_with_range(0, 100, 5)
        self._spin_dim_pct.set_title("Day level (%)")
        self._spin_dim_pct.connect("notify::value", self._on_autodim_changed)
        g.add(self._spin_dim_pct)

        box_hours = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL,
                            spacing=10)
        self._spin_day_start = Adw.SpinRow.new_with_range(0, 23, 1)
        self._spin_day_start.set_title("From (hour)")
        self._spin_day_start.connect("notify::value",
                                     self._on_autodim_changed)
        self._spin_day_end = Adw.SpinRow.new_with_range(1, 24, 1)
        self._spin_day_end.set_title("Until (hour)")
        self._spin_day_end.connect("notify::value", self._on_autodim_changed)
        box_hours.append(self._spin_day_start)
        box_hours.append(self._spin_day_end)
        row = Adw.ActionRow(title="Daylight window")
        row.add_suffix(box_hours)
        g.add(row)
        # No page.add(g) here: g came from self._panel() above, and _panel
        # appends through _mark. Appending it again asked GTK to reparent a
        # widget that already had a parent, which it refuses -- so the call
        # did nothing except print
        #     assertion 'gtk_widget_get_parent (child) == NULL' failed
        # on every single window open, for a page that was already correct.
        # The two time spinners are also a row that cannot compress: two
        # SpinRows side by side are ~540px of minimum, which on a narrow
        # window made the whole Lighting page that wide no matter what the
        # rest of the layout did. Stacked, they are one column.
        self._reflow.append(box_hours)

        self._refresh_autodim_ui()

        # ── the replica (marked "replica": _finish_page sorts it directly
        # under the section header, whatever order the code runs in) ──
        g = Adw.PreferencesGroup()
        frame = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        frame.add_css_class("kb-frame")
        self._board = KbdBoard(self)
        frame.append(self._board)
        g.add(frame)

        # tools row — Apply to keyboard lives HERE: the natural place after
        # painting, next to the brush/eraser, instead of only inside the
        # profiles group where it was easy to miss.
        trow = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        trow.set_margin_top(10)
        self._btn_brush = self._tool_button("Brush", "brush",
                                            self._on_tool)
        self._btn_eraser = self._tool_button("Eraser", "eraser",
                                             self._on_tool)
        self._btn_brush.set_active(True)
        b_fill = Gtk.Button(label="Fill all")
        b_fill.add_css_class("tool-btn")
        b_fill.connect("clicked", self._on_fill_all)
        b_clear = Gtk.Button(label="Clear all")
        b_clear.add_css_class("tool-btn")
        b_clear.connect("clicked", self._on_clear_all)
        b_send = Gtk.Button(label="Apply to keyboard")
        b_send.add_css_class("suggested-action")
        b_send.set_tooltip_text("Send the painted frame to the keyboard")
        b_send.connect("clicked", self._on_profile_apply)
        self._lbl_sel = Gtk.Label(label="")
        self._lbl_sel.add_css_class("dimmed")
        self._lbl_sel.set_halign(Gtk.Align.END)
        self._lbl_sel.set_hexpand(True)
        for wdg in (self._btn_brush, self._btn_eraser, b_fill, b_clear,
                    b_send, self._lbl_sel):
            trow.append(wdg)
        g.add(trow)

        # colors row: custom color = full picker OR exact hex entry
        crow = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        crow.set_margin_top(10)
        crow.append(Gtk.Label(label="Custom color:"))
        # Custom swatch → press opens a wheel-palette popover with a
        # format-agnostic colour entry; inline hex field stays for speed.
        self._col1 = Gtk.MenuButton(valign=Gtk.Align.CENTER)
        self._col1.set_has_frame(False)
        self._col1.set_always_show_arrow(False)
        self._col1.add_css_class("color-swatch-btn")
        self._col1.set_tooltip_text("Pick any colour — wheel palette, "
                                    "hex, rgb/rgba, hsl")
        swatch = Gtk.Box()
        swatch.set_size_request(26, 26)
        swatch.add_css_class("color-swatch")
        self._swatch = swatch
        self._col1.set_child(swatch)
        self._col1.set_popover(self._build_color_popover(swatch))
        self._sync_swatch()
        crow.append(self._col1)

        self._ent_hex = Gtk.Entry()
        self._ent_hex.set_placeholder_text("hex / rgb / rgba")
        self._ent_hex.set_max_width_chars(14)
        self._ent_hex.connect("activate", self._on_hex_entry)
        self._ent_hex.connect("changed", self._on_hex_live)
        crow.append(self._ent_hex)

        crow.append(Gtk.Label(label="Recent:"))
        self._recent_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL,
                                   spacing=6)
        self._rebuild_recent()
        crow.append(self._recent_box)
        g.add(crow)
        self._mark(page, "replica", g)

        # ── hardware quick effects ──
        self._add_section(page, "Quick effects", key="sec-effects")
        g = Adw.PreferencesGroup()
        # 8 per line: with the full-width layout the eight effect tiles form
        # one even row that USES the window, instead of four fat tiles and a
        # dead half-row.
        self._flow = Gtk.FlowBox(selection_mode=Gtk.SelectionMode.SINGLE,
                                 max_children_per_line=8,
                                 min_children_per_line=4,
                                 column_spacing=14, row_spacing=14,
                                 hexpand=True)
        for name, icon, _p, _c in KBD_EFFECTS:
            tile = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
            tile.add_css_class("effect-tile")
            img = Gtk.Image.new_from_icon_name(icon)
            img.set_pixel_size(28)
            img.set_halign(Gtk.Align.CENTER)
            lbl = Gtk.Label(label=name)
            lbl.set_halign(Gtk.Align.CENTER)
            tile.append(img)
            tile.append(lbl)
            self._flow.append(tile)
        self._flow.select_child(self._flow.get_child_at_index(0))
        self._flow.connect("child-activated",
                           lambda *_: self._on_kbd_apply())
        g.add(self._flow)

        self._ent_param = Adw.EntryRow(title="Parameter — empty = default")
        g.add(self._ent_param)

        prow = Adw.ActionRow(title="Apply effect")
        abox = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        b1 = Gtk.Button(label="Apply", valign=Gtk.Align.CENTER)
        b1.add_css_class("suggested-action")
        b1.connect("clicked", self._on_kbd_apply)
        b2 = Gtk.Button(label="Static dark (battery)",
                        valign=Gtk.Align.CENTER)
        b2.connect("clicked", self._on_kbd_static)
        abox.append(b1)
        abox.append(b2)
        prow.add_suffix(abox)
        g.add(prow)
        self._mark(page, "effects", g)

        self._rebuild_profile_chips()

        # Order by MEANING, not by the order the code happens to run in:
        # paint first (the board, then the daemon row that backs it), then
        # brightness, hardware effects, profiles, automation last.
        self._finish_page(page, (
            "sec-editor", "replica", "editor",
            "sec-bright", "brightness",
            "sec-effects", "effects",
            "sec-profiles", "profiles",
            "sec-dim", "dim",
        ))

    # ── per-key editor logic ─────────────────────────────────────────────
    def current_key_colors(self):
        _idx, prof = active_profile(self._lighting)
        out = {}
        for k, v in prof.get("keys", {}).items():
            r, c = k.split(",")
            out[(int(r), int(c))] = v
        return out

    def _save_and_refresh(self):
        save_lighting(self._lighting)
        self._board.queue_draw()

    def on_key_clicked(self, r, c):
        # a single-key click supersedes any previous marquee selection
        self._sel_range = None
        _idx, prof = active_profile(self._lighting)
        keys = prof.setdefault("keys", {})
        if self._tool == "eraser":
            keys.pop(f"{r},{c}", None)
            self._lbl_sel.set_text(f"erased {r},{c}")
        else:
            keys[f"{r},{c}"] = self._brush_color
            self._lbl_sel.set_text(f"painted {r},{c} "
                                   f"{self._brush_color}")
        self._save_and_refresh()

    def on_keys_region(self, r0, c0, r1, c1):
        """Marquee release: apply the active tool to every key in the box.
        The range stays 'selected': changing the color afterwards re-paints
        the whole region (iCUE-style region editing)."""
        self._sel_range = (r0, c0, r1, c1)
        _idx, prof = active_profile(self._lighting)
        keys = prof.setdefault("keys", {})
        n = 0
        for r in range(r0, r1 + 1):
            for c in range(c0, c1 + 1):
                if self._tool == "eraser":
                    keys.pop(f"{r},{c}", None)
                else:
                    keys[f"{r},{c}"] = self._brush_color
                n += 1
        self._lbl_sel.set_text(
            f"{'erased' if self._tool == 'eraser' else 'painted'} {n} keys "
            f"(rows {r0}–{r1}, cols {c0}–{c1})")
        self._toast(f"{n} keys {'erased' if self._tool == 'eraser' else "painted " + self._brush_color} — Apply to keyboard to send it")
        self._save_and_refresh()

    def _on_tool(self, btn, tool):
        if btn.get_active():
            self._tool = tool
            for other in (self._btn_brush, self._btn_eraser):
                if other is not btn:
                    other.set_active(False)

    def _after_color_set(self):
        """Shared hook after the brush colour changes (wheel, dialog,
        hex entry, recent chip)."""
        if self._brush_color not in self._recent:
            self._recent.insert(0, self._brush_color)
            self._recent = self._recent[:6]
            self._rebuild_recent()
        # keep the hex field in sync without re-triggering it
        self._ent_hex.handler_block_by_func(self._on_hex_live)
        self._ent_hex.set_text(self._brush_color.lstrip("#"))
        self._ent_hex.handler_unblock_by_func(self._on_hex_live)
        self._sync_swatch()
        self._sync_popover_swatch()
        # live-apply to the whole selection if one exists
        if getattr(self, "_sel_range", None):
            r0, c0, r1, c1 = self._sel_range
            self.on_keys_region(r0, c0, r1, c1)

    # ── custom colour popover: wheel palette + format-agnostic entry ──
    def _build_color_popover(self, swatch):
        pop = Gtk.Popover()
        pop.add_css_class("color-pop")
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        box.set_margin_top(12)
        box.set_margin_bottom(12)
        box.set_margin_start(12)
        box.set_margin_end(12)

        self._pop_swatch = swatch
        title = Gtk.Label(label="CUSTOM COLOUR")
        title.set_halign(Gtk.Align.START)
        title.add_css_class("color-pop-title")
        box.append(title)

        wheel = Gtk.FlowBox()
        wheel.set_min_children_per_line(10)
        wheel.set_max_children_per_line(10)
        wheel.set_selection_mode(Gtk.SelectionMode.NONE)
        wheel.set_homogeneous(True)
        for hx in WHEEL_COLORS:
            b = Gtk.Button()
            b.set_size_request(24, 24)
            b.add_css_class("color-cell-btn")
            cell = Gtk.Box()
            cell.set_size_request(18, 18)
            cell.set_halign(Gtk.Align.CENTER)
            cell.set_valign(Gtk.Align.CENTER)
            cell.add_css_class("color-cell")
            cell.add_css_class("kbd-color-" + hx.lstrip("#"))
            b.set_child(cell)
            b.set_tooltip_text(hx)
            b.connect("clicked", self._wheel_pick, hx)
            wheel.append(b)
        box.append(wheel)
        # Wheel cells need their colour classes registered even before any
        # recent colour happens to match.
        prov = Gtk.CssProvider()
        prov.load_from_data(
            "\n".join(".kbd-color-%s { background: %s; }"
                      % (hx.lstrip("#"), hx) for hx in WHEEL_COLORS), -1)
        Gtk.StyleContext.add_provider_for_display(
            Gdk.Display.get_default(), prov,
            Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

        row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        more = Gtk.Button(label="More colors…")
        more.add_css_class("tool-btn")
        more.connect("clicked", self._open_color_dialog)
        row.append(more)
        box.append(row)

        self._pop_entry = Gtk.Entry()
        self._pop_entry.set_placeholder_text("hex · rgb() · rgba() · hsl()")
        self._pop_entry.set_width_chars(22)
        self._pop_entry.add_css_class("color-pop-entry")
        self._pop_entry.connect("changed", self._popover_entry_changed)
        self._pop_entry.connect("activate", self._popover_entry_activated)
        box.append(self._pop_entry)

        pop.set_child(box)
        return pop

    def _wheel_pick(self, _btn, hexv):
        self._brush_color = hexv
        self._after_color_set()

    def _open_color_dialog(self, _btn):
        dlg = Gtk.ColorDialog()
        dlg.set_title("Custom colour")
        dlg.set_with_alpha(False)

        def done(_d, res):
            try:
                c = dlg.choose_finish(res)
            except Exception:
                return
            self._brush_color = "#%02x%02x%02x" % (round(c.red * 255),
                                                   round(c.green * 255),
                                                   round(c.blue * 255))
            self._after_color_set()
        dlg.choose(self.get_root(), None, done)

    def _popover_entry_changed(self, entry):
        v = parse_color(entry.get_text())
        entry.remove_css_class("color-entry-ok")
        entry.remove_css_class("color-entry-bad")
        if v:
            entry.add_css_class("color-entry-ok")
            self._brush_color = v
            self._sync_swatch()
            self._sync_popover_swatch()
        elif entry.get_text().strip():
            entry.add_css_class("color-entry-bad")

    def _popover_entry_activated(self, entry):
        v = parse_color(entry.get_text())
        if v:
            self._apply_hex(v, from_live=True)

    def _sync_swatch(self):
        sw = getattr(self, "_swatch", None)
        if sw is None:
            return
        if getattr(self, "_swatch_prov", None) is None:
            self._swatch_prov = Gtk.CssProvider()
            sw.get_style_context().add_provider(
                self._swatch_prov,
                Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        self._swatch_prov.load_from_data(
            ".color-swatch { background: %s; }" % self._brush_color, -1)

    def _sync_popover_swatch(self):
        sw = getattr(self, "_pop_swatch", None)
        if sw is None:
            return
        if getattr(self, "_pop_swatch_prov", None) is None:
            self._pop_swatch_prov = Gtk.CssProvider()
            sw.get_style_context().add_provider(
                self._pop_swatch_prov,
                Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        self._pop_swatch_prov.load_from_data(
            ".color-swatch { background: %s; }" % self._brush_color, -1)

    def _on_hex_entry(self, entry):
        self._apply_hex(entry.get_text())

    def _on_hex_live(self, entry):
        if parse_color(entry.get_text()):
            self._apply_hex(entry.get_text(), from_live=True)

    def _apply_hex(self, text, from_live=False):
        hexv = parse_color(text)
        if not hexv:
            return
        self._brush_color = hexv
        self._sync_swatch()
        self._sync_popover_swatch()
        if hexv not in self._recent:
            self._recent.insert(0, hexv)
            self._recent = self._recent[:6]
            self._rebuild_recent()
        self._lbl_sel.set_text(f"custom color {hexv}"
                               + (" — painting keys" if from_live else ""))
        # a live hex edit re-paints an existing marquee selection instantly
        if getattr(self, "_sel_range", None):
            r0, c0, r1, c1 = self._sel_range
            self.on_keys_region(r0, c0, r1, c1)

    def _rebuild_recent(self):
        child = self._recent_box.get_first_child()
        while child:
            nxt = child.get_next_sibling()
            self._recent_box.remove(child)
            child = nxt
        for hx in self._recent:
            b = Gtk.Button()
            b.set_size_request(28, 28)
            b.add_css_class("tool-btn")
            b.set_tooltip_text(hx)
            b.connect("clicked",
                      lambda _b, hexv=hx: self._pick_recent(hexv))
            # color the button via a small swatch inside
            sw = Gtk.Box()
            sw.set_size_request(18, 18)
            sw.set_halign(Gtk.Align.CENTER)
            sw.set_valign(Gtk.Align.CENTER)
            sw.add_css_class("kbd-color-" + hx.lstrip("#"))
            b.set_child(sw)
            self._recent_box.append(b)
        provider = Gtk.CssProvider()
        css = "\n".join(
            f".kbd-color-{hx.lstrip('#')} {{ background: {hx}; "
            f"border-radius: 6px; }}"
            for hx in self._recent)
        provider.load_from_data(css, -1)
        Gtk.StyleContext.add_provider_for_display(
            Gdk.Display.get_default(), provider,
            Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

    def _pick_recent(self, hexv):
        self._brush_color = hexv
        self._after_color_set()

    def _on_fill_all(self, *_):
        _idx, prof = active_profile(self._lighting)
        prof["keys"] = {f"{r},{c}": self._brush_color
                        for r in range(ROWS) for c in range(COLS)}
        self._save_and_refresh()
        self._toast("Filled all keys — Apply to keyboard to send it")

    def _on_clear_all(self, *_):
        _idx, prof = active_profile(self._lighting)
        prof["keys"] = {}
        self._save_and_refresh()
        self._toast("Cleared — Apply to keyboard to send it")

    # profiles ---------------------------------------------------------------
    def _rebuild_profile_chips(self):
        child = self._chipbox.get_first_child()
        while child:
            nxt = child.get_next_sibling()
            self._chipbox.remove(child)
            child = nxt
        self._chip_group = None
        idx_active, _prof = active_profile(self._lighting)
        for i, prof in enumerate(self._lighting["profiles"]):
            b = Gtk.ToggleButton(label=prof["name"])
            b.add_css_class("profile-chip")
            if self._chip_group:
                b.set_group(self._chip_group)
            else:
                self._chip_group = b
            if i == idx_active:
                b.set_active(True)
            b.connect("toggled",
                      lambda btn, idx=i: self._on_profile_chip(btn, idx))
            self._chipbox.append(b)
        # The rebuild used to wipe the "＋ New" chip along with the profile
        # chips — after one creation the add control was gone and there was
        # no way to create a second profile from the chip row. Re-create it
        # every time so creation always stays available.
        b_add = Gtk.Button(label="＋ New")
        b_add.add_css_class("profile-add")
        b_add.set_tooltip_text("Create a new profile and start editing it")
        b_add.connect("clicked", self._on_profile_new)
        self._chipbox.append(b_add)

    def _on_profile_chip(self, btn, idx):
        if btn.get_active():
            self._lighting["active"] = idx
            save_lighting(self._lighting)
            self._board.queue_draw()

    def _on_profile_new(self, *_):
        # iCUE-style: the new profile starts as a copy of the current one
        # (a dark keyboard is a worse starting point than your current
        # look), switches to it, and opens the name editor inline.
        import copy
        idx, prof = active_profile(self._lighting)
        dup = {"name": f"Profile {len(self._lighting['profiles']) + 1}",
               "keys": copy.deepcopy(prof.get("keys", {}))}
        self._lighting["profiles"].append(dup)
        self._lighting["active"] = len(self._lighting["profiles"]) - 1
        self._rebuild_profile_chips()
        self._save_and_refresh()
        self._toast(f"{dup['name']} created from '{prof['name']}' — paint it")

    def _on_profile_duplicate(self, *_):
        import copy
        idx, prof = active_profile(self._lighting)
        dup = {"name": prof["name"] + " copy",
               "keys": copy.deepcopy(prof.get("keys", {}))}
        self._lighting["profiles"].insert(idx + 1, dup)
        self._lighting["active"] = idx + 1
        self._rebuild_profile_chips()
        self._save_and_refresh()
        self._toast("Duplicated")

    def _on_profile_delete(self, *_):
        if len(self._lighting["profiles"]) <= 1:
            self._toast("Keep at least one profile")
            return
        idx, _prof = active_profile(self._lighting)
        self._lighting["profiles"].pop(idx)
        self._lighting["active"] = max(0, idx - 1)
        self._rebuild_profile_chips()
        self._save_and_refresh()
        self._toast("Deleted")

    def _on_profile_apply(self, *_):
        idx, prof = active_profile(self._lighting)
        colors = {}
        for k, v in prof.get("keys", {}).items():
            r, c = k.split(",")
            colors[(int(r), int(c))] = v.lstrip("#")
        self._toast(f"Applying '{prof['name']}'…")

        def job():
            return kbd_push_matrix(colors)

        bg(job, lambda r: (self._toast(f"'{prof['name']}' on the keyboard"
                                       if r[0] else f"apply failed: {r[1]}"),))

    def _on_lighting_autostart(self, sw, _pspec):
        set_autostart_enabled(sw.get_active())
        self._toast("Login re-apply " + ("on" if sw.get_active()
                                         else "off"))

    # ── daylight auto-dim ────────────────────────────────────────────────
    def _refresh_autodim_ui(self):
        en, db, ds, de = kbd_autodim_state()
        self._updating = True
        self._sw_autodim.set_active(en)
        self._spin_dim_pct.set_value(db)
        self._spin_day_start.set_value(ds)
        self._spin_day_end.set_value(de)
        self._updating = False

    def _on_autodim_toggled(self, sw, _pspec):
        if self._updating:
            return
        set_kbd_autodim(enabled=sw.get_active())
        self._toast("Daylight cap " + ("on" if sw.get_active()
                                       else "off"))

        v = int(self._kbd_slider.get_value())

        def job():
            if sw.get_active():
                # Cap switched ON inside the window: apply the configured
                # day level right away — the tick keeps it there after.
                return autodim_tick()
            # Cap OFF (or now outside the window): hand the keyboard back
            # to the brightness bar's own value.
            clear_kbd_lock()
            ok, _ = kbd_set_brightness("main", v)
            return v if ok else None

        bg(job, lambda r: self.refresh())

    # notify::value delivers (obj, pspec); obj is the spin row.
    def _on_autodim_changed(self, obj, _pspec=None):
        if self._updating:
            return
        set_kbd_autodim(
            day_brightness=int(self._spin_dim_pct.get_value()),
            day_start=int(self._spin_day_start.get_value()),
            day_end=int(self._spin_day_end.get_value()))
        autodim_tick()

    # ── fan control ──────────────────────────────────────────────────────
    def _on_fan_mode(self, btn):
        if self._updating:
            return
        if not btn.get_active():
            return
        mode = getattr(btn, "fan_mode", "default")
        set_fan_mode_state(mode=mode)
        label = {"quiet": "Quiet", "default": "Auto",
                 "noisy": "Noisy", "battery": "Battery saver"}.get(mode, mode)
        # Say what actually took effect, not just which pill got pressed.
        pol = FAN_POWER_POLICY.get(mode)
        if pol is not None:
            self._toast(f"Fan: {label} — CPU capped to {pol[0]} W")
        else:
            self._toast(f"Fan: {label} — vendor power limits")
        bg(lambda: fan_apply_mode(), lambda r: (self.refresh(),))

    def _on_fan_manual(self, btn):
        """Custom: the level slider owns the fan."""
        if self._updating:
            return
        if not btn.get_active():
            return
        # One write path. The old handler called fan_level_set() directly,
        # so it never recorded fanAppliedLevel and never re-checked that
        # the stored level matched the slider -- switch away and back and
        # the slider came back stale. Going through fan_apply_mode() means
        # the Custom level is written, recorded and restored identically to
        # every other mode.
        lvl = int(self._fan_slider.get_value())
        set_fan_mode_state(mode="manual", level=lvl)
        self._toast(f"Fan: custom — level {lvl}/{FAN_LEVEL_MAX}")
        bg(lambda: fan_apply_mode(), lambda r: (self.refresh(),))

    def _set_fan_level_label(self, level):
        """The REQUESTED level, marked as a request.

        This used to read "≈3200 RPM" as if it were a measurement. It is not:
        the embedded controller ignores the level, so the previous wording
        stated as fact a speed the hardware never ran at.
        """
        rpm = fan_rpm_for(level)
        txt = f"{int(level)} / {FAN_LEVEL_MAX} requested"
        if rpm is not None:
            txt += f" ({rpm} RPM if honoured)"
        self._fb_level_value.set_text(txt)

    def _on_fan_slider(self, scale):
        if self._updating:
            return
        lvl = int(scale.get_value())
        self._set_fan_level_label(lvl)
        self._fan_slider_last = time.time()

        def job():
            # settle: only the last drag position gets written
            time.sleep(0.35)
            if time.time() - self._fan_slider_last < 0.3:
                return None
            set_fan_mode_state(mode="manual", level=lvl)
            return fan_apply_mode()

        bg(job, lambda r: (None if r is None else self.refresh(),))

    # ── Display ──────────────────────────────────────────────────────────
    def _build_display(self):
        page = self._page("display", "Display",
                          "display-brightness-symbolic")

        # Hero band: the slider gets the whole row, undivided.
        self._add_section(page, "Screen")
        g = Adw.PreferencesGroup(title="Screen brightness")
        self._scr_slider = self._big_slider(40, self._on_screen_slider)
        row = Adw.ActionRow()
        row.add_suffix(self._scr_slider)
        row.set_activatable_widget(self._scr_slider)
        g.add(row)
        page.add(g)

        # Two composed panels instead of two stretched single-column
        # sections: step-away behavior (left), idle screen (right).
        self._add_section(page, "When you step away")
        gl = Adw.PreferencesGroup(title="Long idle")
        sw = Gtk.Switch(valign=Gtk.Align.CENTER)
        row = Adw.ActionRow(title="Panel off when idle this long")
        row.add_suffix(sw)
        row.set_activatable_widget(sw)
        sw.connect("notify::active", self._on_long_idle_toggled)
        self._sw_long_idle = sw
        gl.add(row)

        spin = Adw.SpinRow.new_with_range(1, 120, 1)
        spin.set_title("Minutes of stillness")
        spin.connect("notify::value", self._on_long_idle_delay)
        self._spin_long_idle = spin
        gl.add(spin)

        sw2 = Gtk.Switch(valign=Gtk.Align.CENTER)
        row = Adw.ActionRow(title="Suspend to RAM afterwards")
        row.add_suffix(sw2)
        row.set_activatable_widget(sw2)
        sw2.connect("notify::active", self._on_suspend_toggled)
        self._sw_suspend = sw2
        gl.add(row)

        gr = Adw.PreferencesGroup(title="Idle screen")
        row = Adw.ActionRow(title="Preview / restore")
        box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        b1 = Gtk.Button(label="Preview 3 s", valign=Gtk.Align.CENTER)
        b1.connect("clicked", self._on_idle_preview)
        b2 = Gtk.Button(label="Restore now", valign=Gtk.Align.CENTER)
        b2.add_css_class("suggested-action")
        b2.connect("clicked", self._on_idle_restore)
        box.append(b1)
        box.append(b2)
        row.add_suffix(box)
        gr.add(row)
        self._two_col(page, gl, gr)

    # ── Power ────────────────────────────────────────────────────────────
    def _build_power(self):
        page = self._page("power", "Power", "battery-full-charging-symbolic")

        self._add_section(page, "Power mode")
        g = Adw.PreferencesGroup()
        devname = device_name()
        row = Adw.ActionRow(title=devname,
                            subtitle="fan and power control")
        self._row_devname = row
        g.add(row)
        hero = self._reflow_box(
            Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=24))
        hero.set_margin_top(6)
        self._gauge_batt = Gauge(100, "% battery", "…")
        hero.append(self._gauge_batt)

        self._flow_profiles = Gtk.FlowBox(
            selection_mode=Gtk.SelectionMode.SINGLE, max_children_per_line=3,
            min_children_per_line=3, column_spacing=16, row_spacing=16,
            hexpand=True, valign=Gtk.Align.CENTER)
        for value, name, desc, icon in PROFILES:
            card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
            card.add_css_class("pcard")
            img = Gtk.Image.new_from_icon_name(icon)
            img.set_pixel_size(26)
            img.set_halign(Gtk.Align.CENTER)
            t = Gtk.Label(label=name)
            t.set_halign(Gtk.Align.CENTER)
            t.add_css_class("heading")
            d = Gtk.Label(label=desc)
            d.set_halign(Gtk.Align.CENTER)
            d.add_css_class("dimmed")
            d.add_css_class("caption")
            card.append(img)
            card.append(t)
            card.append(d)
            self._flow_profiles.append(card)
        self._flow_profiles.connect("selected-children-changed",
                                    self._on_profile_card)
        hero.append(self._flow_profiles)
        g.add(hero)
        page.add(g)

        self._add_section(page, "Cooling")
        gl = Adw.PreferencesGroup()
        row = Adw.ActionRow(title="Fan mode")
        # What a "fan mode" can and cannot do on this machine, said where the
        # choice is made rather than buried: the firmware owns the fan, so
        # these modes set the power the CPU may draw, which is what the
        # firmware's temperature curve actually reacts to.
        row.set_subtitle("Sets the CPU power ceiling the fan curve reacts to")
        fb_quiet = Gtk.ToggleButton(label="Quiet")
        fb_quiet.add_css_class("tool-btn")
        # "Auto", not "Automatic": the five pills have to share one line at
        # the default window width, and the long form pushed the row over it.
        fb_default = Gtk.ToggleButton(label="Auto")
        fb_default.add_css_class("tool-btn")
        fb_noisy = Gtk.ToggleButton(label="Noisy")
        fb_noisy.add_css_class("tool-btn")
        fb_battery = Gtk.ToggleButton(label="Battery saver")
        fb_battery.add_css_class("tool-btn")
        fb_manual = Gtk.ToggleButton(label="Custom")
        fb_manual.add_css_class("tool-btn")
        fb_quiet.set_group(fb_default)
        fb_noisy.set_group(fb_default)
        fb_battery.set_group(fb_default)
        fb_manual.set_group(fb_default)
        fb_quiet.fan_mode = "quiet"
        fb_default.fan_mode = "default"
        fb_noisy.fan_mode = "noisy"
        fb_battery.fan_mode = "battery"
        self._fan_slider_last = 0.0
        fb_quiet.connect("toggled", self._on_fan_mode)
        fb_default.connect("toggled", self._on_fan_mode)
        fb_noisy.connect("toggled", self._on_fan_mode)
        fb_battery.connect("toggled", self._on_fan_mode)
        fb_manual.connect("toggled", self._on_fan_manual)
        self._fb_quiet, self._fb_default = fb_quiet, fb_default
        self._fb_noisy, self._fb_manual = fb_noisy, fb_manual
        self._fb_battery = fb_battery
        gl.add(row)

        # The pills live on their own line rather than as row suffixes.
        #
        # As suffixes they were measured at 863 px wide against a 791 px
        # window -- five of them simply do not fit where four did, and the
        # fifth would have been clipped rather than wrapped. A FlowBox gets
        # the full content width and wraps onto a second line when it needs
        # to, so the row stays correct in a narrower window too instead of
        # depending on the default window size.
        fbox = Gtk.FlowBox()
        fbox.set_selection_mode(Gtk.SelectionMode.NONE)
        fbox.set_max_children_per_line(6)
        fbox.set_column_spacing(6)
        fbox.set_row_spacing(6)
        fbox.set_margin_start(12)
        fbox.set_margin_end(12)
        fbox.set_margin_bottom(10)
        for b in (fb_quiet, fb_default, fb_noisy, fb_battery, fb_manual):
            fbox.append(b)
        gl.add(fbox)

        # The level slider. It appears the moment Custom is selected and
        # carries its own value readout, so the level being written is
        # visible while you drag it rather than only after a refresh.
        srow = Adw.ActionRow(title="Fan level (request)")
        srow.set_subtitle("Asked of the embedded controller, which sets its "
                          "own speed")
        self._fan_slider = Gtk.Scale.new_with_range(
            Gtk.Orientation.HORIZONTAL, 0, FAN_LEVEL_MAX, 1)
        self._fan_slider.set_draw_value(False)
        self._fan_slider.set_hexpand(True)
        self._fan_slider.add_css_class("razer-big-slider")
        self._fan_slider.connect("value-changed", self._on_fan_slider)
        self._fb_level_value = Gtk.Label(label="— / 50")
        self._fb_level_value.add_css_class("dim-label")
        self._fb_level_value.set_valign(Gtk.Align.CENTER)
        srow.add_suffix(self._fb_level_value)
        srow.add_suffix(self._fan_slider)
        srow.set_visible(False)
        self._fb_slider_row = srow
        gl.add(srow)

        # The number that is actually in force. The fan level cannot honestly
        # be reported as fact -- the firmware does not honour it -- so the
        # power ceiling is what the UI shows, because it is what changes how
        # loud the machine is.
        prow = Adw.ActionRow(title="Power ceiling")
        prow.set_subtitle("Enforced in silicon; the fan follows this")
        self._lbl_pwr = Gtk.Label(label="…")
        self._lbl_pwr.add_css_class("dim-label")
        self._lbl_pwr.set_valign(Gtk.Align.CENTER)
        prow.add_suffix(self._lbl_pwr)
        gl.add(prow)

        row = Adw.ActionRow(title="CPU temperature")
        self._lbl_fan_temp = Gtk.Label(label="…")
        row.add_suffix(self._lbl_fan_temp)
        gl.add(row)

        # Right panel: battery detail + startup. Untitled — the category
        # header above already says it.
        sw = Gtk.Switch(valign=Gtk.Align.CENTER)
        gr = Adw.PreferencesGroup()
        row = Adw.ActionRow(title="Battery detail")
        self._lbl_battery = Gtk.Label(label="…")
        row.add_suffix(self._lbl_battery)
        gr.add(row)
        row = Adw.ActionRow(title="Start at login",
                            subtitle="XDG autostart")
        row.add_suffix(sw)
        row.set_activatable_widget(sw)
        sw.connect("notify::active", self._on_autostart_toggled)
        self._sw_autostart = sw
        gr.add(row)

        # Battery is NOT cooling: its own category instead of being parked
        # beside the fan controls.
        page.add(gl)
        self._add_section(page, "Battery and startup")
        page.add(gr)

    # ── GPU ──────────────────────────────────────────────────────────────
    def _build_gpu(self):
        page = self._page("gpu", "GPU", "video-display-symbolic")

        self._add_section(page, "Live state")
        g = Adw.PreferencesGroup()
        hero = self._reflow_box(
            Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=24))
        hero.set_margin_top(6)
        # Utilisation, not watts. A watt gauge on a fixed scale reads as a
        # mystery number: the 4070 idles around 8 W and peaks near 80, so a
        # hard 40% load looked like a quarter-full dial and a busy one looked
        # nearly empty, and neither could be read as "how busy is the GPU".
        # Load is the number people actually mean by "is the GPU working".
        self._gauge_draw = Gauge(100, "%", "GPU load", size=(200, 140))
        self._gauge_draw.set_tooltip_text(
            "GPU load. The card is only sampled while it is awake, so a "
            "sleeping dGPU correctly reads zero.")
        hero.append(self._gauge_draw)

        right = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14,
                        valign=Gtk.Align.CENTER, hexpand=True)
        srow = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        srow.append(Gtk.Label(label="State"))
        self._pill_gpu = self._pill()
        srow.append(self._pill_gpu)
        right.append(srow)

        drow = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        drow.append(Gtk.Label(label="Decode"))
        self._pill_decode = self._pill()
        drow.append(self._pill_decode)
        self._btn_decode = Gtk.Button(label="Move to iGPU",
                                      valign=Gtk.Align.CENTER)
        self._btn_decode.add_css_class("suggested-action")
        self._btn_decode.connect("clicked", self._on_decode_fix)
        drow.append(self._btn_decode)
        right.append(drow)

        # The detail line. The gauge answers "how busy"; this answers "busy
        # doing what, at what wattage, how hot, and how much VRAM" -- the
        # numbers the single big figure has to leave out.
        lrow = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        lrow.append(Gtk.Label(label="Load"))
        self._lbl_load = Gtk.Label(label="…")
        self._lbl_load.set_xalign(0.0)
        self._lbl_load.set_hexpand(True)
        # Ellipsis, not wrap. A wrapping label's *minimum* width is still the
        # width of its longest unbreakable run, so wrapping bought nothing
        # here and cost the whole GPU page 120px of minimum width: the hero
        # sits in a side-by-side pair, and a hero that cannot get narrower
        # than its own caption is a page that cannot be made narrow at all.
        # Ellipsizing makes the minimum small, so the pair can stack, and the
        # full string is one hover away.
        self._lbl_load.set_ellipsize(Pango.EllipsizeMode.END)
        lrow.append(self._lbl_load)
        # An icon button, like the re-scan button below it: .row-icon-btn
        # zeroes the padding and pins a 34px box, which is right for an icon
        # and would crush a text label.
        b_sample = self._icon_button(
            "preferences-system-time-symbolic",
            "Take one reading now. This wakes the dGPU, so it is the one "
            "action on this page that will not let the card fall back "
            "asleep immediately.", self._on_gpu_sample)
        b_sample.add_css_class("row-icon-btn")
        b_sample.set_valign(Gtk.Align.CENTER)
        lrow.append(b_sample)
        right.append(lrow)

        prow = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        prow.append(Gtk.Label(label="Apps on GPU"))
        self._lbl_procs = Gtk.Label(label="…")
        prow.append(self._lbl_procs)
        hero.append(right)
        g.add(hero)
        page.add(g)

        # Two panels under one category: the live hero on the left, the
        # sleep mechanics (documentation) on the right. The hero group was
        # already added above, so compose around it: the pair replaces it
        # on the page (remove + reinsert), because PreferencesGroup is
        # single-parent.
        gr = Adw.PreferencesGroup(title="Sleep")
        row = Adw.ActionRow(title="Event log")
        self._row_gpulog = row
        gr.add(row)

        row = Adw.ActionRow(title="Apps holding it open")
        self._row_holders = row
        b_hold = Gtk.Button(icon_name="view-refresh-symbolic",
                            valign=Gtk.Align.CENTER)
        b_hold.add_css_class("row-icon-btn")
        b_hold.set_tooltip_text("Re-scan who holds the GPU open")
        b_hold.connect("clicked", self._on_gpu_holders)
        self._row_holders.add_suffix(b_hold)
        gr.add(row)

        # One row per holder, each with its own Terminate button. The
        # summary above is a comma-joined string, which reads fine but
        # cannot be acted on -- and getting the card back to sleep is the
        # entire point of this row.
        self._holders_box = Gtk.ListBox(selection_mode=Gtk.SelectionMode.NONE)
        self._holders_box.add_css_class("boxed-list")
        self._holders_sig = None
        gr.add(self._holders_box)

        page.remove(g)      # take the hero group back off the plain box
        self._two_col(page, g, gr)

        self._add_section(page, "Driver settings")
        gd = Adw.PreferencesGroup()
        dpm_now = nvidia_param("DynamicPowerManagement") or "3"
        self._cbo_dpm = Adw.ComboRow(title="When idle")
        model = Gtk.StringList()
        for _, name, desc in DPM_LABELS:
            model.append(f"{name} — {desc}")
        self._cbo_dpm.set_model(model)
        for i, (val, _, _) in enumerate(DPM_LABELS):
            if val == dpm_now:
                self._cbo_dpm.set_selected(i)
        gd.add(self._cbo_dpm)

        self._sw_s0ix = Adw.SwitchRow(
            title="Deeper suspend (S0ix)",
            subtitle="GPU stays down while suspended")
        self._sw_s0ix.set_active(nvidia_param("EnableS0ixPowerManagement")
                                 == "1")
        gd.add(self._sw_s0ix)

        row = Adw.ActionRow(title="Saved on disk")
        self._row_nvpersist = row
        gd.add(row)

        row = Adw.ActionRow(title="Apply")
        b = Gtk.Button(label="Apply & save", valign=Gtk.Align.CENTER)
        b.add_css_class("suggested-action")
        b.connect("clicked", self._on_dpm_apply)
        row.add_suffix(b)
        gd.add(row)
        page.add(gd)

    # ── Diagnostics ──────────────────────────────────────────────────────
    def _build_diag(self):
        page = self._page("diag", "Diagnostics", "emblem-system-symbolic")

        self._add_section(page, "Appearance")
        ga = Adw.PreferencesGroup()
        row = Adw.ActionRow(
            title="Theme",
            subtitle="Follows the desktop on \"system\"; light and dark "
                     "pin it")
        # One selected-button, three choices. Saving is instant on click:
        # no apply button, the scheme change is visible immediately and the
        # choice survives restarts via the II config.
        self._theme_btns = Gtk.Box(spacing=6)
        self._theme_sel = {}   # value -> button
        for value, label in (("light", "Light"), ("system", "System"),
                            ("dark", "Dark")):
            b = Gtk.ToggleButton(label=label)
            b.add_css_class("pill")
            b.connect("toggled", self._on_theme_toggled, value)
            self._theme_btns.append(b)
            self._theme_sel[value] = b
        box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        box.append(self._theme_btns)
        row.add_suffix(box)
        ga.add(row)

        # Light shade: which white the light theme uses. Only meaningful
        # when the resolved theme is light, so the row hides itself in dark
        # mode instead of offering a control that would do nothing visible.
        self._shade_row = Adw.ActionRow(
            title="Light shade",
            subtitle="Which white the light theme uses")
        self._shade_btns = Gtk.Box(spacing=6)
        self._shade_sel = {}
        for value, label in SHADE_LABELS:
            b = Gtk.ToggleButton(label=label)
            b.add_css_class("pill")
            b.connect("toggled", self._on_shade_toggled, value)
            self._shade_btns.append(b)
            self._shade_sel[value] = b
        sbox = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        sbox.append(self._shade_btns)
        self._shade_row.add_suffix(sbox)
        ga.add(self._shade_row)
        page.add(ga)
        self._sync_theme_buttons(read_theme())
        self._sync_shade_buttons(read_theme_shade())

        self._add_section(page, "Input")
        gl = Adw.PreferencesGroup(title="Hotkeys")
        row = Adw.ActionRow(title="Last capture", subtitle="not run yet")
        self._row_hotkeys = row
        gl.add(row)
        row = Adw.ActionRow(title="Test")
        b = Gtk.Button(label="Start 8 s test", valign=Gtk.Align.CENTER)
        b.add_css_class("suggested-action")
        b.connect("clicked", self._on_hotkey_test)
        row.add_suffix(b)
        gl.add(row)

        page.add(gl)

        self._add_section(page, "Services")
        gr = Adw.PreferencesGroup()
        row = Adw.ActionRow(title="power-profiles-daemon")
        self._pill_ppd = self._pill()
        row.add_suffix(self._pill_ppd)
        gr.add(row)
        page.add(gr)

    # ── appearance ───────────────────────────────────────────────────────
    def _on_theme_toggled(self, btn, value):
        """A theme pill was clicked.

        ``toggled`` fires for BOTH the button being selected and the one
        being deselected, so the handler must ignore the deselecting one:
        the newly active button wins and its value is what gets applied and
        saved. Guarded against re-entry because set_active below re-fires
        toggled while syncing.
        """
        if not btn.get_active():
            return                      # the button losing selection
        if getattr(self, "_theme_syncing", False):
            return                      # programmatic change, not a click
        write_theme(value)
        apply_theme(value)
        self._sync_theme_buttons(value)
        self._toast(f"Theme: {value}")

    def _sync_theme_buttons(self, value):
        """Make exactly one pill active, without re-triggering saves."""
        self._theme_syncing = True
        for v, b in self._theme_sel.items():
            b.set_active(v == value)
        self._theme_syncing = False
        # The shade row only exists for a light-resolved theme.
        self._shade_row.set_visible(
            value == "light"
            or (value == "system" and not _system_prefers_dark()))

    def _on_shade_toggled(self, btn, value):
        """A light-shade pill was clicked (same double-fire rules as theme)."""
        if not btn.get_active():
            return
        if getattr(self, "_theme_syncing", False):
            return
        write_theme_shade(value)
        apply_theme(read_theme())
        self._sync_shade_buttons(value)
        self._toast("Shade: " + dict(SHADE_LABELS)[value])

    def _sync_shade_buttons(self, value):
        self._theme_syncing = True
        for v, b in self._shade_sel.items():
            b.set_active(v == value)
        self._theme_syncing = False

    # ── refresh ──────────────────────────────────────────────────────────
    def _tick(self):
        # Hidden means nobody is looking: skip the whole refresh, and with it
        # the ~15 subprocesses it spawns. The window is built lazily and is
        # hidden for the entire background phase of the session.
        if not UI_VISIBLE:
            return GLib.SOURCE_CONTINUE
        self.refresh()
        return GLib.SOURCE_CONTINUE

    def _on_visible(self, *_):
        """Keep UI_VISIBLE in step with the window.

        Closing the window only hides it (see the close-request handler), so
        this is the switch that decides whether the periodic refresh does any
        work at all.

        Note there is deliberately no re-pump of the keyboard widget here.
        `_pump` belongs to KbdPreview, the animated effect preview, and that
        class is not instantiated anywhere -- the interactive board is
        KbdBoard, which has no timer of its own and redraws only on demand.
        Calling it anyway raised AttributeError on every show and hide.
        """
        global UI_VISIBLE
        UI_VISIBLE = bool(self.get_visible())
        if UI_VISIBLE:
            # A hidden window's polling was stopped, so bring every value up
            # to date the moment it comes back rather than showing stale
            # numbers until the next tick.
            self.refresh()

    def refresh(self):
        if self._refreshing:
            return False
        self._refreshing = True

        def job():
            # GPU reads must NEVER wake a sleeping card: runtime_status is
            # plain sysfs and safe; nvidia-smi opens the device and would
            # wake it — so it only runs while the card is already awake.
            status = gpu_runtime_status()
            awake = status == "active"
            en, mins, susp = long_idle_state()
            return {
                "battery": (battery_pct(), battery_info()),
                "ppd": ppd_state(),
                "daemon": daemon_active(),
                "sleep": status,
                "metrics": gpu_metrics() if awake else None,
                "holders": gpu_holders() if awake else None,
                "decode": decode_state(),
                "screen": screen_brightness_pct(),
                "scr_recent": time.time() - self._scr_last < 5,
                "kbd": None if time.time() - self._kbd_last < 5
                else kbd_get_brightness("main"),
                "long_idle": (en, mins, susp),
                "autostart": autostart_enabled(),
                "ppd_active": run("systemctl", "is-active", "--quiet",
                                  "power-profiles-daemon")[0],
                "nvpersist": nvidia_persisted(),
                "fan": fan_state(),
                "fan_mode": fan_mode_state(),
                "fan_applied": fan_level_read(),
                "pwr": pwr_state(),
                "daycap": day_cap_active(),
                "temp": cpu_temp(),
                "devname": device_name(),
            }

        def done(res):
            self._refreshing = False
            if not isinstance(res, dict):
                return
            self._updating = True

            pct, info = res["battery"]
            self._gauge_batt.set_value(pct)
            self._gauge_batt.set_sub(info.split("·")[-1].strip())
            self._lbl_battery.set_text(info)

            st = res["ppd"]
            active_idx = 1
            for i, (value, _, _, _) in enumerate(PROFILES):
                if st.get("active") == value:
                    active_idx = i
            self._flow_profiles.select_child(
                self._flow_profiles.get_child_at_index(active_idx))

            self._set_pill(self._pill_daemon,
                           "RUNNING" if res["daemon"] else "STOPPED",
                           "good" if res["daemon"] else "bad")
            self._set_pill(self._pill_ppd, "RUNNING" if res["ppd_active"]
                           else "OFF",
                           "good" if res["ppd_active"] else "warn")

            status = res["sleep"]
            self._set_pill(self._pill_gpu,
                           {"suspended": "ASLEEP", "active": "AWAKE",
                            "suspending": "SLEEPING",
                            "resuming": "WAKING"}.get(status, status),
                           "good" if status == "suspended"
                           else "bad" if status == "active" else "warn")
            # transition tracking → event log
            if status != self._gpu_state:
                now = time.strftime("%H:%M:%S")
                if status == "suspended":
                    self._gpu_events.append(f"{now}  went to SLEEP")
                elif status == "active":
                    self._gpu_events.append(f"{now}  WOKE UP")
                self._gpu_state = status
            if self._gpu_events:
                self._row_gpulog.set_subtitle(
                    "\n".join(self._gpu_events[-4:]))
            # Gauge shows real load, sampled only while the card is awake.
            # A sleeping dGPU is genuinely doing nothing, so zero is the
            # truthful reading -- but it must SAY it is asleep, or a correct
            # zero looks like a broken gauge. That ambiguity is the whole
            # reason this page read as permanently stuck at 0%.
            m = res.get("metrics")
            if m is not None:
                self._gauge_draw.set_value(m["util"])
                self._gauge_draw.set_sub(
                    f"{m['watts']:.0f} W · {m['pstate']}")
            else:
                self._gauge_draw.set_value(0.0)
                self._gauge_draw.set_sub("asleep")
            load_text = gpu_load_text(m)
            self._lbl_load.set_text(load_text)
            self._lbl_load.set_tooltip_text(load_text)

            ok, why = res["decode"]
            self._set_pill(self._pill_decode, why, "good" if ok else "bad")
            self._btn_decode.set_visible(not ok)
            self._show_holders(res["holders"] is not None,
                               res["holders"] or [])

            exists, dpm, s0ix = res["nvpersist"]
            self._row_nvpersist.set_subtitle(
                f"60-nvidia-pm.conf: RTD3={dpm}, S0ix={s0ix}" if exists
                else "nothing saved yet — defaults this boot")

            if res["screen"] is not None and not res["scr_recent"]:
                self._scr_slider.set_value(res["screen"])
            self._row_kbd.set_subtitle(
                "Locked by the day cap — changes are not applied"
                if res.get("daycap") else "")
            # While the cap holds the level, refresh must not snap the
            # user's slider back to the hardware value either.
            if res["kbd"] is not None and not res.get("daycap"):
                self._kbd_slider.set_value(res["kbd"])

            en, mins, susp = res["long_idle"]
            self._sw_long_idle.set_active(en)
            self._spin_long_idle.set_value(mins)
            self._sw_suspend.set_active(susp)
            self._sw_autostart.set_active(res["autostart"])
            self._sw_light_autostart.set_active(res["autostart"])

            fmode, flvl = res["fan_mode"]
            self._updating = True
            self._fb_quiet.set_active(fmode == "quiet")
            self._fb_default.set_active(fmode == "default")
            self._fb_noisy.set_active(fmode == "noisy")
            self._fb_battery.set_active(fmode == "battery")
            self._fb_manual.set_active(fmode == "manual")
            self._fb_slider_row.set_visible(fmode == "manual")
            # The live power ceiling, which is what the mode really controls.
            p1, p2, tb = res.get("pwr") or (None, None, None)
            if p1 is None:
                self._lbl_pwr.set_text("—")
            else:
                extra = "" if tb is None else (", turbo on" if tb
                                              else ", turbo off")
                self._lbl_pwr.set_text(f"{p1} W / {p2} W{extra}")
            # Show the level that is actually pinned, not just the stored
            # preference: in Automatic nothing is pinned, so the readout
            # says so instead of showing a stale number.
            applied = res.get("fan_applied")
            if fmode == "manual":
                self._fan_slider.set_value(flvl)
                self._set_fan_level_label(flvl)
            elif fmode == "default":
                self._fb_level_value.set_text("firmware curve")
            elif applied is not None:
                self._set_fan_level_label(applied)
            else:
                self._fb_level_value.set_text("—")
            self._updating = False
            self._lbl_fan_temp.set_text(
                f"{res['temp']} °C" if res["temp"] is not None else "—")
            self._row_devname.set_title(res["devname"])

            # Workspace rail telemetry — the numbers live in the nav rail.
            mode_name = PROFILES[active_idx][1]
            # The values are painted in the sheet's rail_ink, not a
            # literal: this label used to hardcode #e8eaed, which is the
            # near-white of the dark sheet and therefore black-on-dark the
            # moment the app was in a light theme.
            ink = token_color("rail_ink", "#e8e8e8")
            self._rail_stats.set_markup(
                f"CPU  <span foreground='{ink}'>"
                f"{res['temp'] if res['temp'] is not None else '—'} °C</span>\n"
                f"BATTERY  <span foreground='{ink}'>{pct:.0f}%</span>\n"
                f"FAN  <span foreground='{ink}'>{fmode}</span>\n"
                f"MODE  <span foreground='{ink}'>{mode_name}</span>")
            # Per-item values on the rail's trailing edge, so the nav
            # answers "what is it doing right now" without opening a page.
            self._set_nav_value("power", f"{pct:.0f}%")
            self._set_nav_value("display", self._nav_brightness(res))
            # The rail value leads with live load when there is a reading,
            # because "awake" on its own says nothing about whether the GPU
            # is working -- an awake-but-idle card and a card pegged at 100%
            # are the same word.
            gpu_m = res.get("metrics")
            if gpu_m is not None:
                self._set_nav_value("gpu", f"{gpu_m['util']:.0f}%")
            else:
                self._set_nav_value("gpu", GPU_STATE_LABELS.get(
                    res.get("sleep"), "—"))
            self._set_nav_value("diag", "RUNNING"
                                if res.get("daemon") else "STOPPED")

            self._updating = False

        bg(job, done)
        return False

    # ── lighting callbacks (daemon / quick effects / slider) ────────────
    def _toast(self, text):
        self._toasts.add_toast(Adw.Toast(title=text, timeout=3))

    def _on_daemon_start(self, *_):
        self._toast("Starting daemon…")
        bg(lambda: daemon_ctl("start"),
           lambda r: (self._toast("Daemon started" if r[0] else "failed"),
                      self.refresh()))

    def _on_daemon_restart(self, *_):
        self._toast("Restarting daemon…")
        bg(lambda: daemon_ctl("restart"),
           lambda r: (self._toast("Restarted" if r[0] else "failed"),
                      self.refresh()))

    def _on_daemon_stop(self, *_):
        bg(lambda: daemon_ctl("stop"),
           lambda r: (self._toast("Daemon stopped"), self.refresh()))

    def _on_kbd_slider(self, scale):
        if self._updating:
            return
        self._kbd_last = time.time()
        v = int(scale.get_value())
        if day_cap_active():
            # Day cap active: the slider stays movable, but the change is
            # NOT applied — the locked level is re-asserted by the tick.
            return
        if self._kbd_timer:
            GLib.source_remove(self._kbd_timer)
        self._kbd_timer = GLib.timeout_add(
            300, lambda: (bg(lambda: kbd_set_brightness("main", v),
                             lambda r: None), GLib.SOURCE_REMOVE)[1])

    def _on_kbd_apply(self, *_):
        idx = self._flow.get_selected_children()[0].get_index() \
            if self._flow.get_selected_children() else 0
        name, _icon, dparam, needs_colors = \
            KBD_EFFECTS[idx] if 0 <= idx < len(KBD_EFFECTS) else \
            KBD_EFFECTS[0]
        param = self._ent_param.get_text().strip() or dparam
        hexc = self._brush_color
        self._toast(f"Applying {name}…")
        bg(lambda: kbd_apply("main", name, param,
                             [hexc] if needs_colors else None),
           lambda r: (self._toast(f"{name} applied" if r[0]
                                  else "apply failed"),))

    def _on_kbd_static(self, *_):
        self._toast("Applying static dark…")

        def job():
            a = kbd_apply("main", "static", "", ["#101010"])
            b = kbd_set_brightness("main", 25)
            return a[0] and b[0]

        bg(job, lambda ok: (self._toast("Static dark applied" if ok
                                        else "apply failed"),))

    # ── display / power / gpu / diag callbacks (unchanged) ───────────────
    def _on_screen_slider(self, scale):
        if self._updating:
            return
        self._scr_last = time.time()
        v = int(scale.get_value())
        if self._scr_timer:
            GLib.source_remove(self._scr_timer)
        self._scr_timer = GLib.timeout_add(
            250, lambda: (bg(lambda: set_screen_brightness(v),
                             lambda r: None), GLib.SOURCE_REMOVE)[1])

    def _on_long_idle_toggled(self, sw, _pspec):
        if self._updating:
            return
        set_long_idle_state(enabled=sw.get_active())
        self._toast("Saved: long idle " + ("on" if sw.get_active()
                                           else "off"))

    def _on_long_idle_delay(self, obj, _pspec):
        if self._updating:
            return
        set_long_idle_state(minutes=int(obj.get_value()))

    def _on_suspend_toggled(self, sw, _pspec):
        if self._updating:
            return
        set_long_idle_state(suspend=sw.get_active())
        self._toast("Saved")

    def _run_screensaver(self, arg):
        def job():
            env = dict(os.environ,
                       WAYLAND_DISPLAY=os.environ.get("WAYLAND_DISPLAY",
                                                      "wayland-1"))
            subprocess.run(
                ["bash", "-c",
                 f"{HOME}/.config/hypr/custom/scripts/screensaver.sh {arg}"],
                env=env, capture_output=True)
            return True
        bg(job, lambda r: None)

    def _on_idle_preview(self, *_):
        self._run_screensaver("--test")
        self._toast("Previewing…")

    def _on_idle_restore(self, *_):
        self._run_screensaver("--restore")
        self._toast("Restored")

    def _on_profile_card(self, flow):
        if self._updating:
            return
        sel = flow.get_selected_children()
        idx = sel[0].get_index() if sel else 1
        value = PROFILES[idx][0]
        # switching power modes re-applies the saved fan mode (a manual
        # slider level simply stays; a mode re-pins its level)
        fmode, _flvl = fan_mode_state()
        self._updating = True
        self._fb_quiet.set_active(fmode == "quiet")
        self._fb_default.set_active(fmode == "default")
        self._fb_noisy.set_active(fmode == "noisy")
        self._fb_battery.set_active(fmode == "battery")
        self._fb_manual.set_active(fmode == "manual")
        self._fb_slider_row.set_visible(fmode == "manual")
        self._updating = False
        bg(lambda: ppd_set(value),
           lambda r: (self._toast("Mode: " + value if r[0]
                                  else (r[1] or "failed")),
                      bg(lambda: fan_apply_mode(), lambda x: self.refresh())))

    def _on_autostart_toggled(self, sw, _pspec):
        if self._updating:
            return
        set_autostart_enabled(sw.get_active())
        self._toast("Autostart " + ("on" if sw.get_active() else "off"))

    def _on_dpm_apply(self, *_):
        dpm = DPM_LABELS[self._cbo_dpm.get_selected()][0]
        s0 = "1" if self._sw_s0ix.get_active() else "0"
        self._toast("Applying & saving (password may be asked)…")
        bg(lambda: nvidia_apply(dpm, s0),
           lambda r: (self._toast("Applied & saved for every boot" if r[0]
                                  else (r[1] or "failed")), self.refresh()))

    def _on_decode_fix(self, *_):
        self._toast("Moving decode to the iGPU…")
        bg(decode_fix,
           lambda r: (self._toast("Done — re-login to finish" if r[0]
                                  else (r[1] or "failed")), self.refresh()))

    def _show_holders(self, awake, holders):
        """Shared renderer for the holders row, the per-process list and
        the hero label — used by the 5s refresh loop and the manual
        re-scan button."""
        if holders:
            shown = ", ".join(holders[:6])
            if len(holders) > 6:
                shown += f" +{len(holders) - 6} more"
            self._row_holders.set_subtitle(shown)
            hero = ", ".join(holders[:4])
            if len(holders) > 4:
                hero += f" +{len(holders) - 4}"
            self._lbl_procs.set_text(hero)
        else:
            self._row_holders.set_subtitle(
                "none — the card is asleep" if not awake
                else "none readable — it may sleep within seconds")
            self._lbl_procs.set_text("—" if not awake else "0")
        self._refresh_holder_rows()

    def _refresh_holder_rows(self):
        """Rebuild the per-process rows, but only when the set actually
        changed. The refresh loop runs every 5s; rebuilding unconditionally
        would pull the Terminate button out from under a click, and GTK
        buttons do not reliably fire 'clicked' on a button that is destroyed
        mid-press."""
        def job():
            return gpu_holder_pids()

        def done(pids):
            if not isinstance(pids, list):
                return
            sig = tuple(pids)
            if sig == self._holders_sig:
                return
            self._holders_sig = sig
            self._fill_holder_rows(pids)
        bg(job, done)

    def _fill_holder_rows(self, pids):
        child = self._holders_box.get_first_child()
        while child is not None:
            nxt = child.get_next_sibling()
            self._holders_box.remove(child)
            child = nxt
        for pid, name in pids:
            row = Adw.ActionRow(title=name or f"pid {pid}",
                                subtitle=f"pid {pid}")
            btn = Gtk.Button(label="Terminate", valign=Gtk.Align.CENTER)
            btn.add_css_class("destructive-action")
            if _is_protected(pid, name):
                # Visible but inert, with the reason stated: the compositor
                # really is holding /dev/nvidia0, and silently omitting it
                # would be more confusing than saying why it stays.
                btn.set_sensitive(False)
                btn.set_tooltip_text(
                    "Protected — this one keeps the session alive")
            else:
                btn.connect("clicked", self._on_gpu_terminate, pid, name)
            row.add_suffix(btn)
            self._holders_box.append(row)

    def _on_gpu_terminate(self, _btn, pid, name):
        """Terminate one holder, then re-scan: the whole point is to get
        the card back to sleep, so the list has to reflect the result."""
        def job():
            return gpu_terminate(pid)

        def done(res):
            ok, msg = res if isinstance(res, tuple) else (False, "failed")
            self._toast(msg)
            self._holders_sig = None      # force the list to rebuild
            self._on_gpu_holders()
        bg(job, done)

    def _on_gpu_sample(self, *_):
        """One reading, taken now, waking the card if it was asleep.

        The background poll deliberately never wakes a sleeping dGPU, which
        means that on an idle laptop the gauge is almost always going to read
        zero -- correctly, but it leaves no way to see the card doing
        something without first going and making it do something. This is
        that escape hatch, and it says so out loud rather than hiding the
        wake.
        """
        was = gpu_runtime_status()

        def job():
            return was, gpu_metrics()

        def done(r):
            if not isinstance(r, tuple):
                return
            was, m = r
            if m is None:
                self._toast("Could not read the GPU")
                return
            self._gauge_draw.set_value(m["util"])
            self._gauge_draw.set_sub(f"{m['watts']:.0f} W · {m['pstate']}")
            load_text = gpu_load_text(m)
            self._lbl_load.set_text(load_text)
            self._lbl_load.set_tooltip_text(load_text)
            self._set_nav_value("gpu", f"{m['util']:.0f}%")
            if was != "active":
                self._toast(f"{m['util']:.0f}% load, {m['watts']:.0f} W "
                            f"— woke the GPU to read it")

        bg(job, done)

    def _on_gpu_holders(self, *_):
        """Show which processes hold the GPU open (only meaningful awake)."""
        def job():
            return gpu_runtime_status(), gpu_holders()

        def done(res):
            if not isinstance(res, tuple):
                return
            status, holders = res
            self._show_holders(status == "active", holders)
            self._toast("Holders refreshed")
        bg(job, done)

    def _on_hotkey_test(self, *_):
        self._row_hotkeys.set_subtitle("listening… press the keys NOW")
        self._toast("Press the hotkeys — 8 seconds")

        def job():
            time.sleep(0.3)
            return hotkey_capture(8)

        def done(found):
            if not found:
                self._row_hotkeys.set_subtitle(
                    "NOTHING captured — dead at kernel level")
            else:
                self._row_hotkeys.set_subtitle("captured: " + ", ".join(
                    found))
            self._toast("Capture finished")
        bg(job, done)


# ── application ──────────────────────────────────────────────────────────────

class RazerControlCenter(Adw.Application):
    """The control center, kept resident for the whole session.

    Two jobs, and keeping them apart is what makes the background version
    cheap:

      * ENFORCEMENT, which must happen whether or not anyone ever opens the
        window -- re-apply the saved lighting, panel brightness and fan mode
        after boot (the firmware resets all three), and keep re-asserting the
        daylight brightness cap. This is the whole reason the app runs at all.
      * THE WINDOW, which is just a view. It is built lazily, on the first
        time it is actually asked for, and never shown unless asked.

    A resident app that has been opened once and then left hidden must not
    keep paying for what it was displaying, so everything the window owned
    that is only needed for display -- the 5 s refresh, the 20 Hz keyboard
    animation -- is switched off with `UI_VISIBLE` rather than left running.
    """

    def __init__(self):
        super().__init__(
            application_id=APP_ID,
            # A second run of the binary (the launcher, a keybind) must reach
            # the instance that is already resident instead of starting a
            # rival copy that fights over the same hardware.
            flags=Gio.ApplicationFlags.HANDLES_COMMAND_LINE,
        )
        self._win = None
        self._enforced = False
        self._cap_src = None

    def _enforce(self):
        """Startup restores + the daylight cap. Runs once per process.

        Safe to call from the window as well as from `--background`: the
        guard makes the second caller a no-op, so opening the window does
        not re-apply anything.
        """
        if self._enforced:
            return
        self._enforced = True
        # Same three restores the window used to schedule, headless and
        # one-shot, and each independent so one failure cannot stop the rest.
        bg(restore_all_headless, lambda r: self._refresh_if_shown())
        # Re-assert the cap every 2 minutes. It has to be a timer rather than
        # a one-shot: the cap is time-of-day based, so it has to notice the
        # clock crossing into (or out of) the capped window on its own, with
        # no UI interaction to prompt it.
        self._cap_src = GLib.timeout_add_seconds(120, self._cap_tick)

        # Publish power/GPU state for the shell's System tab, from here
        # rather than from the window's own 5 s tick. The window is built
        # lazily and in the normal case is NEVER built -- the app spends the
        # whole session as a headless resident -- so a publisher hung off the
        # window would simply never run, and the panel's numbers would be
        # whatever the last login left behind. This is the same reasoning that
        # puts the daylight cap here instead of in the view.
        publish_power_json()
        GLib.timeout_add_seconds(5, self._power_tick)

    def _power_tick(self):
        """Republish the snapshot. On a worker: it may shell out to
        nvidia-smi, but only when the window is open or a real app holds
        the card (see tick_power_snapshot) -- an unwatched poll must not
        keep an idle dGPU from suspending. Still on a worker either way:
        the GTK main loop must not wait on any subprocess.
        """
        bg(tick_power_snapshot, lambda r: None)
        return GLib.SOURCE_CONTINUE

    def _cap_tick(self):
        """Re-assert the daylight cap, and the fan mode's power ceiling.

        Two jobs, one timer, because both are the same shape: something that
        must not be allowed to drift out from under the app. With a window
        open the daylight half delegates to the window's version, which knows
        about the keyboard-brightness slider and re-applies its value when the
        cap releases; without one it enforces the cap on its own. Exactly one
        of the two runs per interval -- the window no longer schedules its own
        2-minute timer, so this cannot double-apply.
        """
        # The power ceiling first: it is what the fan mode is worth, and it is
        # a no-op read of two sysfs files unless something moved them.
        bg(pwr_enforce, lambda r: None)
        if self._win is not None:
            self._win._autodim_tick()
        else:
            # Runs on the GTK thread; the reads and writes go to a worker.
            # Enforced unconditionally, not only on a transition: something
            # else (the shell's quick panel, a keybind) can move the panel
            # brightness between ticks, and the cap has to win that back.
            bg(autodim_tick, lambda r: None)
        return GLib.SOURCE_CONTINUE

    _cap_was_active = False

    def _refresh_if_shown(self):
        if self._win is not None and UI_VISIBLE:
            self._win.refresh()

    def _present(self):
        """Build the window on first use, then show it."""
        if self._win is None:
            self._win = RcWindow(self)
            # Close = hide, not quit: the control center is supervised by a
            # systemd user service and is meant to stay available. Hiding
            # keeps its state; if the process ever dies anyway, the service
            # restarts it.
            self._win.connect("close-request",
                              lambda w: (w.hide(), True)[1])
            self._win.connect("notify::visible", self._win._on_visible)
        self._enforce()
        self._win.present()

    def do_command_line(self, cmdline):
        """Every invocation lands here, the first one included.

        `--background` is what the service passes: stay resident and enforce
        the saved settings, but never put a window on screen. Anything else
        (the launcher, a keybind, a second `hyprctl` style call) is a request
        to actually show the window -- which is also what makes the resident
        background instance reachable as a normal app.
        """
        args = cmdline.get_arguments()[1:]
        self._enforce()
        if "--background" in args:
            # A GApplication's main loop is kept alive by its windows, and in
            # background mode there are none -- so without an explicit hold it
            # returns from run() immediately. That is not a crash, and systemd
            # reports it as `0/SUCCESS`, so the service looks healthy while the
            # app is in fact already gone and nothing is being enforced. The
            # hold is what makes "resident, never closes" true rather than
            # aspirational; it is taken once and never released, which is
            # exactly the requested lifetime.
            if not self._held:
                self._held = True
                self.hold()
            return 0
        self._present()
        return 0

    _held = False

    def do_activate(self):
        # Reached only if something activates the app without a command line.
        self._present()


def apply_lighting_headless(retries=6, delay=2.0):
    """--apply-lighting: push the active profile at login. Quiet success.

    The openrazer daemon is a SEPARATE user service, and at login this runs
    from an XDG autostart entry that races it. A first attempt against a
    daemon that is not listening yet fails and the keyboard silently keeps
    the firmware's default colours for the whole session, so retry with a
    short backoff instead of giving up on the first error.
    """
    import time
    for attempt in range(max(1, retries)):
        try:
            data = load_lighting()
            _idx, prof = active_profile(data)
            colors = {}
            for k, v in prof.get("keys", {}).items():
                r, c = k.split(",")
                colors[(int(r), int(c))] = v.lstrip("#")
            if not colors:
                return 0
            ok, _err = kbd_push_matrix(colors)
            if ok:
                return 0
        except Exception:
            pass
        if attempt < retries - 1:
            time.sleep(delay)
    return 1


def restore_all_headless():
    """--restore-all: re-apply every persisted setting at login.

    Runs the same three restores the window does on startup, but headless
    and one-shot, so it is safe to call from a systemd unit that may start
    before the graphical app. Each step is independent: one failing must
    not stop the others.
    """
    results = {}
    # 1. keyboard lighting (the active per-key profile)
    results["lighting"] = apply_lighting_headless() == 0
    # 2. panel brightness (brightnessctl's own state file)
    results["screen"] = restore_screen_brightness()
    # 3. fan mode (the TFN1 device resets to the firmware curve on reboot)
    try:
        fan_apply_mode()
        results["fan"] = True
    except Exception:
        results["fan"] = False
    # 4. keyboard brightness cap for the current time of day
    try:
        autodim_tick()
        results["autodim"] = True
    except Exception:
        results["autodim"] = False
    for k, v in results.items():
        print(f"restore {k}: {'ok' if v else 'FAILED'}")
    return 0 if all(results.values()) else 1


def main(argv):
    # headless: one JSON blob of power + GPU + hardware facts. The shell's
    # System tab normally reads the published file instead of calling this
    # (see publish_power_json for why), but the flag stays: it is the same
    # code path, so it is the honest way to check what the panel is showing,
    # and it works with the app not running at all.
    if len(argv) >= 2 and argv[1] == "--power-json":
        print(json.dumps(power_snapshot()))
        return 0
    # headless: enforce the daylight cap (shell timers / cron can call this)
    if len(argv) >= 2 and argv[1] == "--autodim":
        applied = autodim_tick()
        return 0
    # headless: report download progress to the bar's status line.
    # Usage: --download-progress "Discord" 42   (pct 0-100)
    if len(argv) >= 4 and argv[1] == "--download-progress":
        try:
            pct = float(argv[3])
        except ValueError:
            return 2
        download_progress(argv[2], pct)
        return 0
    # headless: keyboard light + brightness for the shell's quick panel
    if len(argv) >= 3 and argv[1] == "--kbd-brightness":
        try:
            v = int(argv[2])
        except ValueError:
            return 2
        if day_cap_active():
            # Day cap: report success but apply nothing — the locked level
            # stays (the next tick would re-assert it anyway).
            return 0
        ok, err = kbd_set_brightness("main", v)
        return 0 if ok else 1
    if len(argv) >= 3 and argv[1] == "--kbd-light":
        ok, _ = kbd_set_brightness("logo" if argv[2] == "logo"
                                   else "main", 100 if argv[2] == "on"
                                   else 0)
        return 0 if ok else 1
    # headless: switch saved color profile by index (the shell's Lighting
    # tab calls this) — sets active, saves, pushes the matrix.
    if len(argv) >= 3 and argv[1] == "--use-profile":
        try:
            idx = int(argv[2])
        except ValueError:
            return 2
        data = load_lighting()
        if not (0 <= idx < len(data["profiles"])):
            return 2
        data["active"] = idx
        save_lighting(data)
        _i, prof = active_profile(data)
        colors = {}
        for k, v in prof.get("keys", {}).items():
            r, c = k.split(",")
            colors[(int(r), int(c))] = v.lstrip("#")
        if colors:
            kbd_push_matrix(colors)
            return 0
        # an unpainted profile falls back to its name's static color hint
        kbd_apply("main", "static", "", ["#3fb950"])
        return 0
    # headless: set power profile AND keyboard lighting from one call —
    # this is what the shell's quick-switcher invokes.
    if len(argv) >= 2 and argv[1] == "--set-profile":
        name = argv[2] if len(argv) > 2 else "balanced"
        ok, err = ppd_set(name)
        if not ok:
            print(err, file=sys.stderr)
            return 1
        # one-glance color presets per mode (used unless the user painted
        # per-key colors: those live in lighting.json and win at login)
        preset = {"performance": "#e5534b", "balanced": "#3fb950",
                  "power-saver": "#3f8cfe"}.get(name, "#3fb950")
        kbd_apply("main", "static", "", [preset])
        return 0
    if len(argv) >= 2 and argv[1] == "--apply-lighting":
        return apply_lighting_headless()
    # headless: re-apply every persisted setting (lighting, panel
    # brightness, fan mode, daylight cap) in one shot at login.
    if len(argv) >= 2 and argv[1] == "--restore-all":
        return restore_all_headless()
    if len(argv) >= 2 and argv[1] == "--toggle":
        name = argv[2] if len(argv) > 2 else ""
        if name not in [v for v, _, _, _ in PROFILES]:
            print("expected performance|balanced|power-saver",
                  file=sys.stderr)
            return 2
        ok, err = ppd_set(name)
        if not ok:
            print(err, file=sys.stderr)
        return 0 if ok else 1

    Adw.init()
    app = RazerControlCenter()
    return app.run(argv)


if __name__ == "__main__":
    sys.exit(main(sys.argv))
