#!/usr/bin/env python3
"""ii Music — the desktop app for the shell's music system.

The headless mpv daemon (ii-music-mpd.service, JSON IPC at
$XDG_RUNTIME_DIR/ii-music-ipc) is the single source of truth for playback;
this app is just another client of the same socket, like the left sidebar's
Music tab and the MPRIS bridge. Start a song here, the sidebar follows; start
one there, this app follows. State cannot drift, because there is one player.

LIBRARY  ~/Music/Spotify/<playlist>/*.mp3, "Artist - Title.mp3" naming — the
exact scan the sidebar uses (services/MusicPlayer.qml).

ONLINE
------
The same search field also queries a real online catalogue (Audius), so one
box covers "everything I own" and "everything anyone has published". Local
matches come first, online rows underneath, clearly labelled, each with the
two things you can do with a result you have found but do not own yet: save
it offline on its own, or save it straight into one of your playlists.

Paging is deliberate: the endpoint returns 10 rows with no parameters at all
and honours limit/offset, so results ACCUMULATE across pages behind a "Load
more" row instead of being cut at whatever the first page held.

Both this app and the shell's Music tab read the same saved settings out of
~/.local/state/quickshell/states.json, so they search under the same
app_name (one shared rate-limit budget, not two competing ones) and save into
the same folder.

CLOSING THE WINDOW DOES NOT QUIT
--------------------------------
Playback lives in the daemon, not here, so this app has no reason to die when
its window closes. The window is a FACE of the daemon, and the shell's
background-apps tray is the app's home: closing the window just hides it, the
process stays, the song keeps playing, and the tray entry brings the window
back. Quitting is a separate, explicit act (the Quit button, or the tray).

That is why the app is a Gio.Application with a stable application_id: the
session bus makes it single-instance, so launching it again while the window
is hidden re-presents the existing window instead of starting a rival second
copy that would fight over the same socket.

WHILE THE WINDOW IS HIDDEN
--------------------------
It still registers itself with the shell's background-apps registry
(quickshell-bgapp-music in XDG_RUNTIME_DIR) and still mirrors what it knows
onto the MPRIS bridge, so the top bar keeps showing the track no matter which
surface started it.

UI
--
Material 3 on libadwaita, on a NEUTRAL dark-grey surface ramp (no green tint,
no warm cast in the greys — the greys are the same family every other app on
the system sits on) with a single muted amber accent for the things that are
actually actionable: the play button, the seek bar, the selected playlist and
the row that is playing right now. Everything else is grey.

Layout, top to bottom: a window header with the title and the explicit quit;
a now-playing card (cover, title/artist, transport, seek); one settings strip
(shuffle, repeat, output device, volume — the config the sidebar has no room
for); then the library as two columns, the playlists on the left and the
tracks on the right, with a search field above them. Search filters across
EVERY playlist at once, the same predicate the sidebar's Music tab uses, and
while it is active the right column shows matches with their playlist named.

Keyboard: Space, arrows, n/p, Ctrl+F (search), Escape (leave search).
"""

import hashlib
import json
import math
import os
import queue
import re
import socket
import subprocess
import sys
import threading
import time
import urllib.error
import urllib.parse
import urllib.request

import gi
gi.require_version("Gtk", "4.0")
gi.require_version("Adw", "1")
gi.require_version("Gio", "2.0")
gi.require_version("GdkPixbuf", "2.0")   # ffmpeg writes the art; GTK loads it
os.environ.setdefault("GSK_RENDERER", "cairo")
from gi.repository import Adw, Gdk, Gio, GLib, GObject, Gtk  # noqa: E402

APP_ID = "io.github.matrix.IiMusic"
HOME = os.path.expanduser("~")
MUSIC_DIR = os.path.join(HOME, "Music", "Spotify")
RUNTIME = os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")
SOCK = os.path.join(RUNTIME, "ii-music-ipc")
# The shell's background-apps registry entry (see services/BackgroundApps.qml).
PRESENCE = os.path.join(RUNTIME, "quickshell-bgapp-music")
CONFIG_DIR = os.path.join(
    os.environ.get("XDG_CONFIG_HOME", os.path.join(HOME, ".config")),
    "ii-music")
CONFIG_FILE = os.path.join(CONFIG_DIR, "config.json")

# ── palette ────────────────────────────────────────────────────────────────
# A Material 3 dark surface ramp, neutral: R=G=B in the greys, so the app
# sits in the same family as every other window on the system instead of
# reading as its own tinted thing. Only the accent carries colour, and it is
# a muted amber — the Music tab's accent, desaturated and pulled down a stop
# so it marks the actionable things without shouting over the greys.
BG = "#141414"          # window / surface
LAYER1 = "#1c1c1c"      # card, container low
LAYER2 = "#232323"      # container, hover
LAYER3 = "#2c2c2c"      # container high
OUTLINE = "#313131"     # hairline
OUTLINE2 = "#444444"    # hairline, hovered
TEXT = "#e6e4e3"        # on-surface
SUB = "#a3a0a0"         # on-surface-variant
ACCENT = "#c9a25c"      # muted amber: play, seek, selection, now playing
ACCENT_HOVER = "#d6b06b"
ACCENT_DIM = "#6d5a34"  # accent used as a border, not as a fill
ON_ACCENT = "#201a10"   # text on an amber fill
PLACEHOLDER = "#3a3a3a"

# ── the hero's sizes ───────────────────────────────────────────────────────
# The card uses 64px of cover and a 34px disc. Both are dialled UP here, on
# request: that card is 920x580 and mostly list, so its hero is one narrow
# band, whereas in this window the hero is the whole "now playing" statement
# and 64px read as a thumbnail pressed against the title. The list below still
# gets every pixel that is left, which is what the card's own comment is
# about -- the hero gets spacious, the list gets the rest.
#
# 96. The card this is copied from uses 64, and 64 read as a thumbnail
# pressed against the title rather than as the cover of the thing you are
# listening to. The earlier 72 was chosen to buy title width, but it bought
# it the wrong way: shrinking the cover made the whole hero read as a
# compact strip, and the title was never actually the constraint (the row
# has ~590px to give and the longest real title needs ~200 of it). So the
# cover is sized for how it reads, and the window's minimum width is sized
# to keep the words whole -- see `MusicWindow.__init__`.
HERO_COVER = 96
# There is no HERO_DISC any more. The play mark is the bar's own 25px, like
# every other transport mark: `Mark` draws them, and a mark that is bigger
# than its neighbours is not a bigger play button, it is a different design.
# The panel's 34px existed because that transport was 28/32/28 and play had to
# win; against 25/25/25 it does not.
# ONE gap for the whole hero row. It had three different values (14 to the
# text, 10 between the transport buttons, and whatever the flex left over),
# which is why the row did not read as a single object. 18, because the row
# is now big enough that 16 read as the cover and the title being one object.
HERO_GAP = 18
# ONE number for the hero's vertical air: same value above the row, between
# the row and the bar, and below the bar. It used to be 22 (14 + a nested 8),
# 18 (a 12 spacing plus the bar's own 6) and 10 -- three rhythms for one
# block, which is why the hero read as a stack of unrelated pieces rather
# than as a single "now playing" statement. 16, not 12: at 12 the hero was
# one tight band against the list, and the point of a hero is air.
HERO_AIR = 16




def clock(s):
    """M:SS. The panel's own clock(), and the only time format on the card."""
    t = max(0, int(s or 0))
    return f"{t // 60}:{t % 60:02d}"


def rgba(hex_colour, alpha=1.0):
    """#rrggbb (or #rgb) -> Cairo's float quadruple."""
    h = hex_colour.lstrip("#")
    if len(h) == 3:
        h = "".join(c * 2 for c in h)
    return (int(h[0:2], 16) / 255.0, int(h[2:4], 16) / 255.0,
            int(h[4:6], 16) / 255.0, alpha)


def kids(widget):
    """Every child of a box, in order.

    Gtk.Box has no `get_children()` in this binding (and no `get_child()`
    either, on a Box): the only portable way is to walk the sibling chain.
    """
    out, c = [], widget.get_first_child()
    while c is not None:
        out.append(c)
        c = c.get_next_sibling()
    return out


def run(*cmd):
    try:
        p = subprocess.run(cmd, capture_output=True, timeout=10)
        return p.stdout
    except Exception:
        return b""


# ── settings: the "more config" the sidebar has no room for ────────────────
#
# Persisted next to the shell's own config rather than in the app, so the
# values survive a reinstall of the app and the daemon can be told about them
# at startup. Only options mpv can actually honour are here — a setting that
# silently does nothing is worse than no setting at all.

DEFAULTS = {
    "volume": 80,
    "shuffle": False,
    "repeat": False,      # loop the playlist
    "outputDevice": "",   # empty = mpv's default sink
    "restoreOnLaunch": True,
}


def load_config():
    cfg = dict(DEFAULTS)
    try:
        with open(CONFIG_FILE) as fh:
            cfg.update(json.load(fh))
    except (OSError, ValueError):
        pass
    return cfg


def save_config(cfg):
    try:
        os.makedirs(CONFIG_DIR, exist_ok=True)
        with open(CONFIG_FILE, "w") as fh:
            json.dump(cfg, fh, indent=2)
    except OSError:
        pass


# ── library scan: the sidebar's exact rule ─────────────────────────────────

def scan_library():
    groups = {}
    root_len = len(MUSIC_DIR) + 1
    for dirpath, _dirs, files in os.walk(MUSIC_DIR):
        for f in sorted(files):
            if not f.lower().endswith(".mp3"):
                continue
            p = os.path.join(dirpath, f)
            rel = p[root_len:]
            slash = rel.find("/")
            folder = "Music" if slash == -1 else rel[:slash]
            base = rel[slash + 1:-4] if slash != -1 else rel[:-4]
            dash = base.find(" - ")
            groups.setdefault(folder, []).append({
                "path": p,
                "title": base[dash + 3:] if dash != -1 else base,
                "artist": base[:dash] if dash != -1 else "",
            })
    return [{"name": k, "tracks": groups[k]} for k in sorted(groups)]


def matches(track, playlist, query):
    """The sidebar's predicate: every word must appear somewhere in the row.

    Searching is over title, artist AND playlist name, so one query can find
    a track without remembering which playlist it was filed under — and so a
    query like "phonk" returns the PHONK playlist's contents by name too.
    """
    hay = f"{track['title']} {track['artist']} {playlist}".lower()
    return all(word in hay for word in query.split())


# ── the online catalogue ────────────────────────────────────────────────────
#
# Audius is artist-owned: the people making the music decide whether a track
# is streamable and whether it may be downloaded, and the API exposes both.
# The honest limitation is that it is an independent catalogue, not the
# mainstream one, so expect community uploads and remixes rather than label
# masters. What it is good for is exactly what the library cannot do: hearing
# about a song you do not have.
#
# Why the settings come out of the SHELL's state file: the two surfaces are
# one feature split across two programs, and two different download folders or
# two different app_names (which is the rate-limit identity) would be a bug
# wearing a disguise. The shell is the one that owns those settings.

STATES_FILE = os.path.join(
    os.environ.get("XDG_STATE_HOME", os.path.join(HOME, ".local", "state")),
    "quickshell", "states.json")
AUDIUS_API = "https://discoveryprovider.audius.co/v1"
AUDIUS_PAGE = 50
FALLBACK_DOWNLOAD_DIR = "Music/Spotify/Audius"
FALLBACK_APP_NAME = "hyprland-music"


def shell_music_settings():
    """The shell's persisted music settings, or the shell's own defaults.

    Read on every call rather than cached at import: the shell may write the
    file after this process started, and a stale download folder would put
    saves somewhere the user cannot see them.
    """
    out = {"downloadFolder": FALLBACK_DOWNLOAD_DIR,
           "onlineAppName": FALLBACK_APP_NAME,
           "rescanAfterDownload": True}
    try:
        with open(STATES_FILE) as fh:
            music = json.load(fh).get("music") or {}
        for k in out:
            if k in music:
                out[k] = music[k]
    except (OSError, ValueError, AttributeError):
        pass  # no shell state yet: the defaults are the shell's defaults
    return out


def sanitize_filename(s):
    """Filesystem-safe text. The library's naming rule is Artist - Title."""
    return re.sub(r"\s+", " ", re.sub(r'[/\\?%*:|"<>]', "-", str(s or ""))).strip()


def target_dir(folder=""):
    """Where a save lands.

    An empty folder is the STANDALONE bucket: saved offline, deliberately in
    none of the user's playlists. The library is folder-per-playlist, so a
    file has to live somewhere, and this is the somewhere that means "just
    keep it". A name is a playlist, created by the download itself.
    """
    name = sanitize_filename(folder)
    if not name:
        return os.path.join(HOME, shell_music_settings()["downloadFolder"])
    return os.path.join(MUSIC_DIR, name)


def http_error_text(exc):
    """A message worth showing a person, for the three failures that happen."""
    if isinstance(exc, urllib.error.HTTPError):
        if exc.code == 429:
            return "Audius is rate-limiting us — try again in a moment"
        if exc.code == 403:
            return "Audius refused the request (403)"
        return f"Audius returned HTTP {exc.code}"
    if isinstance(exc, urllib.error.URLError):
        return "No network — the online catalogue needs a connection"
    return str(exc) or "The online search failed"


class Audius:
    """Search the online catalogue, off the GTK thread, across pages.

    Nothing here touches a widget. A search runs on its own thread and calls
    back through GLib.idle_add, because widgets may only be touched from the
    main loop and a 20-second HTTP call on that loop freezes the window solid.

    `generation` exists so a slow response for an old query cannot overwrite a
    newer one: type "ph", then "phonk" quickly, and the "ph" answer lands
    last and would otherwise repopulate the list with the wrong tracks.
    """

    def __init__(self, app_name=None, api=AUDIUS_API):
        self.api = api
        self._app_name = app_name
        self.lock = threading.Lock()
        self.results = []
        self.offset = 0
        self.has_more = False
        self.busy = False
        self.error = ""
        self.query = ""
        self.generation = 0

    @property
    def app_name(self):
        return self._app_name or shell_music_settings()["onlineAppName"]

    def url(self, query, offset):
        return (f"{self.api}/tracks/search"
                f"?query={urllib.parse.quote(query)}"
                f"&limit={AUDIUS_PAGE}&offset={offset}"
                f"&app_name={urllib.parse.quote(self.app_name)}")

    def clear(self, cb=None):
        with self.lock:
            self.generation += 1
            self.results = []
            self.offset = 0
            self.has_more = False
            self.busy = False
            self.error = ""
            self.query = ""
        if cb:
            GLib.idle_add(cb)

    def search(self, query, append=False, cb=None):
        """(Re)search, or add the next page. cb() runs on the GTK thread."""
        q = (query or "").strip()
        with self.lock:
            if len(q) < 2:
                # Reset inline rather than by calling clear(): that would
                # re-enter this very lock, and threading.Lock is not
                # reentrant, so the window would hang on its own search.
                self.generation += 1
                self.results = []
                self.offset = 0
                self.has_more = False
                self.busy = False
                self.error = ""
                self.query = ""
                if cb:
                    GLib.idle_add(cb)
                return
            if not append:
                self.results = []
                self.offset = 0
                self.generation += 1
            self.query = q
            self.busy = True
            self.error = ""
            gen = self.generation
            offset = self.offset if append else 0
        threading.Thread(target=self._work, args=(q, offset, gen, cb),
                         daemon=True).start()

    def load_more(self, cb=None):
        """Next page of the current query, if there is one."""
        with self.lock:
            if self.busy or not self.has_more or len(self.query) < 2:
                return
            gen = self.generation
            q = self.query
            offset = self.offset
        threading.Thread(target=self._work, args=(q, offset, gen, cb),
                         daemon=True).start()

    def _work(self, query, offset, gen, cb):
        try:
            req = urllib.request.Request(
                self.url(query, offset),
                headers={"User-Agent": "ii-music-app/1.0",
                         "Accept": "application/json"})
            with urllib.request.urlopen(req, timeout=25) as resp:
                data = json.load(resp).get("data") or []
        except Exception as exc:                    # noqa: BLE001 - reported
            with self.lock:
                if gen != self.generation:           # a newer search won
                    return
                self.busy = False
                self.has_more = False
                self.error = http_error_text(exc)
            if cb:
                GLib.idle_add(cb)
            return

        rows = [self._map(t, self.app_name) for t in data]
        rows = [r for r in rows if r["id"]]
        with self.lock:
            if gen != self.generation:               # a newer search won
                return
            seen = {r["id"] for r in self.results}
            # Two pages of a shifting index can overlap; the same row twice is
            # worse than one row missing.
            self.results.extend([r for r in rows if r["id"] not in seen])
            self.offset += len(data)
            # A short page is the last page: the endpoint simply stops
            # returning rows, so "fewer than we asked for" is the only
            # end-of-results signal there is.
            self.has_more = len(data) >= AUDIUS_PAGE
            self.busy = False
            self.error = ""
        if cb:
            GLib.idle_add(cb)

    @staticmethod
    def _map(t, app_name):
        """One API track -> the same shape the library rows use, so the row
        builder and the play queue do not need a second code path.

        `path` is the STREAM url, not a file: mpv streams it directly, which
        is why playing an online row needs no download at all. Audius leaves
        `stream_url` null in search results, so it is always built from the id.
        """
        art = t.get("artwork") or {}
        user = t.get("user") or {}
        access = t.get("access") or {}
        tid = t.get("id") or ""
        return {
            "id": tid,
            "online": True,
            "path": (f"{AUDIUS_API}/tracks/{tid}/stream"
                     f"?app_name={urllib.parse.quote(app_name)}") if tid else "",
            "title": t.get("title") or "Unknown",
            "artist": user.get("name") or "Unknown artist",
            "art": art.get("480x480") or art.get("150x150") or "",
            # The artist decides whether a track may be saved. Showing the
            # save button anyway would be offering something that cannot work.
            "downloadable": access.get("download") is True,
            "duration": t.get("duration") or 0,
            "plays": t.get("favorite_count") or 0,
        }


AUDIUS = Audius()


def download_track(track, path):
    """Fetch one online track to `path`. Returns "" or a reason it failed.

    curl because the stream endpoint 302s to the CDN and nothing else in the
    box follows that redirect by default. --fail so an HTML error page is
    never written out as a song, and --remove-on-error so a failure leaves no
    empty mp3 behind for the library scan to pick up.
    """
    try:
        os.makedirs(os.path.dirname(path), exist_ok=True)
    except OSError as exc:
        return str(exc)
    try:
        p = subprocess.run(
            ["curl", "-L", "--fail", "--remove-on-error", "--silent",
             "--show-error", "--max-time", "300",
             "-A", "ii-music-app/1.0", "-o", path, track["path"]],
            capture_output=True, timeout=320)
    except subprocess.TimeoutExpired:
        return "The download timed out"
    except OSError as exc:
        return str(exc)
    if p.returncode != 0:
        err = p.stderr.decode(errors="ignore").strip().split("\n")[-1]
        # Not a bug in the URL: Audius indexes a handful of tracks whose file
        # no longer resolves ("track not found"). Say that in words.
        if "404" in err:
            return "This track can no longer be downloaded"
        return err or "The download failed"
    return ""


def read_duration(path):
    """Running time in seconds, or 0.0 when it cannot be read.

    ffprobe rather than mutagen because there is nothing to install here and
    ffmpeg is already a dependency of the artwork path.
    """
    out = run("ffprobe", "-v", "error", "-show_entries", "format=duration",
              "-of", "default=nw=1:nk=1", path)
    try:
        return float(out.decode().strip())
    except (ValueError, AttributeError):
        return 0.0


def cover_for(path):
    """Extract embedded cover art (APIC frame) as PNG bytes, or None."""
    if not path or not os.path.isfile(path):
        return None
    out = run("ffmpeg", "-loglevel", "error", "-i", path,
              "-an", "-vf", "scale=320:-1", "-frames:v", "1",
              "-f", "image2pipe", "-vcodec", "png", "-")
    if out and out.startswith(b"\x89PNG"):
        return out
    return None


# ── artwork ────────────────────────────────────────────────────────────────
#
# Every image in this app comes out of the mp3s themselves: the library has
# no jpegs in it, only APIC frames. That is a slow way to get a picture --
# one ffmpeg process per track, ~125 of them -- and it cannot happen on the
# GTK thread or the window would freeze solid while the playlist draws. So:
#
#   * each file is extracted ONCE into ~/.cache/ii-music/covers/, keyed by
#     path + mtime + size, so a re-downloaded track gets fresh art and a
#     rename of the library costs nothing;
#   * extraction happens on a small worker pool, and the result is handed
#     back through GLib.idle_add, because widgets may only be touched from
#     the main loop;
#   * a row never waits. It shows a placeholder and swaps in the art when it
#     lands, so the UI is complete and usable before a single decode.
#
# The queue is FIFO on purpose: rows are built top to bottom, and the track
# list starts scrolled to the top, so what the user is looking at is what is
# being decoded first.
COVER_CACHE = os.path.join(
    os.environ.get("XDG_CACHE_HOME", os.path.join(HOME, ".cache")),
    "ii-music", "covers")


class Covers:
    """Embedded art, extracted once, cached on disk, delivered off-thread."""

    def __init__(self, workers=4):
        self.workers = workers
        self.queue = queue.Queue()
        self.mem = {}
        self.lock = threading.Lock()
        for i in range(workers):
            threading.Thread(target=self._run, daemon=True).start()

    @staticmethod
    def key(path):
        """Cache filename for a track: its identity includes mtime and size,
        so replacing a file replaces its art instead of showing the old one."""
        try:
            st = os.stat(path)
        except OSError:
            return None
        h = hashlib.sha1(
            f"{path}|{st.st_mtime_ns}|{st.st_size}".encode()
        ).hexdigest()[:20]
        return os.path.join(COVER_CACHE, h + ".png")

    def peek(self, path):
        """Cache file for a track's art if it is already extracted, else None.

        Never extracts. Returns a PATH, not bytes: the widget loads the file
        itself, so a 320px cover never becomes a decoded pixbuf held by Python.
        """
        if not path:
            return None
        with self.lock:
            if path in self.mem:
                return self.mem[path] or None
        k = self.key(path)
        if not k or not os.path.exists(k):
            return None
        with self.lock:
            self.mem[path] = k
        return k

    def store(self, path, data):
        """Write art bytes to the cache. Returns the file, or None."""
        k = self.key(path)
        with self.lock:
            self.mem[path] = k if data else ""
        if not k or not data:
            return None
        try:
            os.makedirs(COVER_CACHE, exist_ok=True)
            tmp = f"{k}.{os.getpid()}.tmp"
            with open(tmp, "wb") as fh:
                fh.write(data)
            os.replace(tmp, k)          # atomic: never a half-written png
        except OSError:
            return None
        return k

    def request(self, path, cb):
        """Ask for a track's art. cb(cache_path_or_None) on the GTK thread."""
        cached = self.peek(path)
        if cached is not None:
            GLib.idle_add(cb, cached)
            return
        self.queue.put((path, cb))

    # ── online artwork ────────────────────────────────────────────────
    #
    # Same cache, same contract (the widget gets a FILE), different source:
    # an online row's cover is a URL, not an mp3 with an APIC frame. Keyed by
    # the URL alone, because a remote image has no mtime or size to hash --
    # and that is the one honest difference from the local rule, not a second
    # cache directory to keep in step with the first.
    @staticmethod
    def url_key(url):
        if not url:
            return None
        h = hashlib.sha1(f"url|{url}".encode()).hexdigest()[:20]
        return os.path.join(COVER_CACHE, h + ".png")

    def peek_url(self, url):
        k = self.url_key(url)
        return k if k and os.path.exists(k) else None

    def store_url(self, url, data):
        k = self.url_key(url)
        if not k or not data:
            return None
        try:
            os.makedirs(COVER_CACHE, exist_ok=True)
            tmp = f"{k}.{os.getpid()}.tmp"
            with open(tmp, "wb") as fh:
                fh.write(data)
            os.replace(tmp, k)          # atomic, as above
        except OSError:
            return None
        return k

    def request_url(self, url, cb):
        """Ask for a remote cover. cb(cache_path_or_None) on the GTK thread."""
        if not url:
            GLib.idle_add(cb, None)
            return
        cached = self.peek_url(url)
        if cached:
            GLib.idle_add(cb, cached)
            return
        self.queue.put((("url", url), cb))

    def _run(self):
        while True:
            item, cb = self.queue.get()
            if isinstance(item, tuple):          # remote cover
                _kind, url = item
                try:
                    req = urllib.request.Request(
                        url, headers={"User-Agent": "ii-music-app/1.0"})
                    with urllib.request.urlopen(req, timeout=20) as resp:
                        data = resp.read(2 << 20)   # a cover is never huge
                except Exception:                  # noqa: BLE001 - no art
                    data = b""
                GLib.idle_add(cb, self.store_url(url, data))
            else:
                k = self.store(item, cover_for(item))
                GLib.idle_add(cb, k)


COVERS = Covers()


def set_cover_image(img, fallback, art_path):
    """Show a cover file, or the placeholder when there is none.

    By FILE, not by pixbuf or texture: Gtk.Image.set_from_pixbuf and
    Gdk.Texture.new_for_pixbuf are both deprecated since GTK 4.10, while
    set_from_file is current and lets GTK stream the image instead of holding
    a decoded copy on the Python side.

    The Gtk.Picture branch is kept for any caller that still wants cover-fit
    cropping; it is not on the hero's path any more, because a Picture's
    natural size is the artwork's own pixel size and a size request only sets
    a minimum (see the hero cover's comment).
    """
    if isinstance(img, Gtk.Picture):
        # Gtk.Picture's setter is `set_paintable`; a NULL path clears it.
        img.set_paintable(
            Gdk.Texture.new_from_filename(art_path) if art_path else None)
    else:
        img.set_from_file(art_path)      # a NULL path clears the image
    if fallback is not None:
        fallback.set_visible(not art_path)
    return bool(art_path)


# ── the sound bar: one object that is the spectrum, the seek bar, the clock
#    and the volume ──────────────────────────────────────────────────────────
#
# This is a port of the shell's SpectrumSeekBar (modules/common/widgets/
# SpectrumSeekBar.qml), used by the middle island's Music view. The geometry
# below is that component's, deliberately and number for number, because the
# whole point of this window is to BE that card:
#
#   * one pill per ~12px, 3px between them, minimum 3px wide
#   * the pills STAND ON the seek line, not float above it: the line is 4px
#     tall at the very bottom of the bars zone and the pills' feet are its top
#     edge. Rounding their tops only -- a dome turns a row of bars into a row
#     of lozenges, which is a different object.
#   * a pill is LIT up to the playhead and dim ahead of it. That split IS the
#     progress; there is no second line that could disagree with it.
#   * VOLUME is the ceiling on a pill's height, so at half volume the bars
#     cannot reach the top. One line, two readings, no legend.
#   * elapsed left, total right, total dimmer, below the bars.
#
# The only thing that is genuinely different is the source of the bands: the
# shell has a service holding them in memory and this app cannot read that,
# so it runs its own cava against the SAME config file.

CAVA_CONFIG = os.path.join(HOME, ".config", "quickshell", "ii",
                           "scripts", "cava", "raw_output_config.txt")


class Spectrum:
    """cava's band list, kept off the GTK thread.

    Restarting matters more than it looks: cava dies with a sink that goes
    away, and a dead visualiser that stays dead is worse than none, because
    the bar is supposed to be an instrument.
    """

    def __init__(self, config=CAVA_CONFIG):
        self.config = config
        self.lock = threading.Lock()
        self.points = []
        self.alive = False
        self._stop = False
        threading.Thread(target=self._run, daemon=True).start()

    def _run(self):
        while not self._stop:
            proc = None
            try:
                proc = subprocess.Popen(
                    ["cava", "-p", self.config], stdout=subprocess.PIPE,
                    stderr=subprocess.DEVNULL, bufsize=0)
                with self.lock:
                    self.alive = True
                # readline() in a loop, NOT `for line in proc.stdout`.
                # Iterating a pipe's file object uses an internal read-ahead
                # that does not hand back the first line until its buffer
                # fills or the pipe closes -- so the reader sits there
                # "connected", cava is streaming real bands into a full pipe,
                # and the app shows a flat spectrum with no error anywhere.
                # readline() returns each line the moment it is written.
                while not self._stop:
                    raw = proc.stdout.readline()
                    if not raw:
                        break
                    # cava's raw format is `;`-separated ascii, one line per
                    # frame -- the same string the shell splits in two.
                    #
                    # Parsed FIELD BY FIELD, and never as one big list
                    # comprehension. A single stray character anywhere in the
                    # frame (a sign, a blank, a locale decimal mark) made the
                    # whole frame raise, the whole frame was skipped, and the
                    # bar sat flat with no error anywhere -- the visible
                    # symptom of a parser that is all-or-nothing where it
                    # should be per field.
                    vals = []
                    for chunk in raw.decode("ascii", "ignore").split(";"):
                        chunk = chunk.strip()
                        if not chunk:
                            continue
                        try:
                            vals.append(float(chunk))
                        except ValueError:
                            continue
                    if vals:
                        with self.lock:
                            self.points = vals
            except Exception:                     # noqa: BLE001 - keep going
                pass
            finally:
                if proc is not None:
                    try:
                        proc.kill()
                        proc.wait(timeout=2)
                    except Exception:             # noqa: BLE001
                        pass
            with self.lock:
                self.alive = False
                self.points = []
            if not self._stop:
                time.sleep(1.0)

    def snapshot(self):
        with self.lock:
            return list(self.points)

    def stop(self):
        self._stop = True


SPECTRUM = Spectrum()


def band_shape(points, i, count):
    """The shell's scaling: raw band -> 0..1, so both instruments agree."""
    if not points or len(points) < 3 or count < 2:
        return 0.0
    idx = int(round(i / (count - 1) * (len(points) - 1)))
    idx = max(0, min(len(points) - 1, idx))
    return min(1.0, points[idx] / 700.0) ** 0.7


def cairo_round_rect(cr, x, y, w, h, r):
    """rounded_rectangle(), which pycairo does not have."""
    r = max(0.0, min(r, w / 2.0, h / 2.0))
    cr.new_sub_path()
    cr.arc(x + w - r, y + r, r, -math.pi / 2, 0)
    cr.arc(x + w - r, y + h - r, r, 0, math.pi / 2)
    cr.arc(x + r, y + h - r, r, math.pi / 2, math.pi)
    cr.arc(x + r, y + r, r, math.pi, 3 * math.pi / 2)
    cr.close_path()


def cairo_round_top(cr, x, y, w, h, r):
    """`border-radius: 2px 2px 0 0` -- square feet, eased top corners."""
    r = max(0.0, min(r, w / 2.0, h))
    cr.new_sub_path()
    cr.arc(x + w - r, y + r, r, -math.pi / 2, 0)
    cr.line_to(x + w, y + h)
    cr.line_to(x, y + h)
    cr.line_to(x, y + r)
    cr.arc(x + r, y + r, r, math.pi, 3 * math.pi / 2)
    cr.close_path()


class Mark(Gtk.DrawingArea):
    """The island's TransportMark, drawn.

    A port of `modules/common/widgets/TransportMark.qml`, because the buttons
    the owner kept pointing at were the top bar's, and GTK's stock
    `media-playback-pause-symbolic` is not them:

      * 25x25 for EVERY mark. The app had 32px skips and a 36px play disc,
        which is the old NowBarPanel transport (28/32/28), and the reason the
        app's row read heavier than the bar's.
      * The skips carry NO pad -- the bar's arrows are bare marks. A padded
        arrow "reads heavier than the song title they flanks".
      * Pause is TWO ROUNDED BARS, drawn, not a font glyph. The bar's own
        comment says the font's pause is the wrong shape, and it is: the
        symbolic icon is two hard rectangles. At 5x13 with a 2.5 radius and a
        1.7 border it is the bar's mark.
      * Hover is a 1px accent RING and nothing else. No growth (a control that
        grows moves the thing you were reaching for) and no fill swell.
      * Play/pause additionally carries the bar's faint 0.32 wash, because it
        is the control people press first.

    The drawing area is explicitly 25x25: a bare `Gtk.DrawingArea` measures to
    ZERO, which is the same trap that made the sound bar draw nothing.
    """

    BOX = 25
    RADIUS = 6               # the shell's `rounding.small`
    BAR_W = 5
    BAR_H = 13
    BAR_R = 2.5
    STROKE = 1.7

    # Gtk.DrawingArea has NO signals of its own -- `signal_list_names` on it
    # returns an empty tuple -- so a custom one has to be registered before it
    # can be connected or emitted. The alternative, making Mark a Gtk.Button
    # with a DrawingArea inside, would bring back the button's padding,
    # min-height and background that made the app's transport read heavy.
    __gsignals__ = {"clicked": (GObject.SignalFlags.RUN_FIRST, None, ())}

    # Shuffle/repeat draw their OWN glyphs (crossed arrows / loop arrows) so
    # they read as modes rather than as transport actions, and keep the same
    # 25px box, ring hover and outline-at-rest grammar as the transport.
    def __init__(self, kind, tip, playing=False):
        """kind: "prev" | "play" | "next" | "shuffle" | "repeat"."""
        super().__init__()
        self.kind = kind
        self.playing = playing
        self.mode_on = False   # lit-while-engaged, for "shuffle"/"repeat"
        self._hover = False
        self._down = False
        self.set_size_request(self.BOX, self.BOX)
        self.set_tooltip_text(tip)
        self.add_css_class("mark")
        self.set_draw_func(self._on_draw)
        self.add_controller(self._click())
        self.add_controller(self._hover_ctl())
        # The bar's marks are all pointing hands. This has to be done on the
        # widget: GTK4's css parser has no `cursor` property at all.
        self.set_cursor(Gdk.Cursor.new_from_name("pointer", None))
        if kind != "play":
            self.add_css_class("markskip")

    def set_playing(self, playing):
        if bool(playing) != bool(self.playing):
            self.playing = bool(playing)
            self.queue_draw()

    def set_mode(self, on):
        """Lit state for shuffle/repeat marks."""
        if bool(on) != bool(self.mode_on):
            self.mode_on = bool(on)
            self.queue_draw()

    def _click(self):
        g = Gtk.GestureClick()
        g.set_button(1)
        g.connect("pressed", lambda *_: setattr(self, "_down", True) or
                  self.queue_draw())
        g.connect("released", self._on_release)
        return g

    def _hover_ctl(self):
        g = Gtk.EventControllerMotion()

        def on_motion(_ctl, x, y):
            inside = 0 <= x <= self.BOX and 0 <= y <= self.BOX
            if inside != self._hover:
                self._hover = inside
                self.queue_draw()

        g.connect("motion", on_motion)
        g.connect("leave", lambda *_: (setattr(self, "_hover", False),
                                       self.queue_draw()))
        return g

    def _on_release(self, _g, n_press, x, y):
        was = self._down
        self._down = False
        self.queue_draw()
        if was and 0 <= x <= self.BOX and 0 <= y <= self.BOX:
            self.emit("clicked")

    # ── the drawing ──────────────────────────────────────────────────
    def _on_draw(self, _area, cr, w, h):
        solid = self._hover or self._down
        cx, cy = w / 2.0, h / 2.0

        # the faint pad, play/pause only
        if self.kind == "play":
            cairo_round_rect(cr, 0.5, 0.5, w - 1, h - 1, self.RADIUS)
            cr.set_source_rgba(*rgba(LAYER3, 0.32 if not self._down else 1.0))
            cr.fill()

        # the ring is the ONLY hover tell -- and for the mode marks, the
        # ring is ON while the mode is engaged: that is the Spotify-style
        # "lit dot" in the same 1px language as the hover tells.
        ring_op = 0.0 if self.kind != "play" else 0.28
        if self.mode_on:
            ring_op = 0.9
        if self._down:
            ring_op = 0.8
        elif self._hover:
            ring_op = 0.7 if self.kind == "play" else 0.55
        if ring_op > 0:
            cairo_round_rect(cr, 0.5, 0.5, w - 1, h - 1, self.RADIUS)
            cr.set_source_rgba(*rgba(ACCENT, ring_op))
            cr.set_line_width(1.0)
            cr.stroke()

        col = rgba(ACCENT if (solid or self.mode_on) else TEXT)

        if self.kind == "play":
            if self.playing:
                self._pause(cr, cx, cy, col, solid)
            else:
                self._triangle(cr, cx, cy, col, solid)
        elif self.kind == "shuffle":
            self._shuffle(cr, cx, cy, col, solid)
        elif self.kind == "repeat":
            self._repeat(cr, cx, cy, col, solid)
        else:
            self._skip(cr, cx, cy, col, solid)

    # -- mode marks ---------------------------------------------------
    def _shuffle(self, cr, cx, cy, col, solid):
        """Two crossed arrows: the universal shuffle glyph, drawn at the
        transport's ink height (13px) with the same outline-at-rest rule."""
        h = 6.5
        s = self.STROKE

        def arrow_head(x, y, direction):
            # small arrowhead pointing `direction` (+x = right)
            cr.move_to(x, y - 2.6)
            cr.line_to(x + 3.4 * direction, y)
            cr.line_to(x, y + 2.6)

        # path 1: left-mid -> crossing -> right-top
        cr.move_to(cx - 9, cy + h)
        cr.line_to(cx - 4, cy)
        cr.line_to(cx + 6, cy - h)
        # path 2: left-top -> crossing -> right-mid (the mirror leg)
        cr.move_to(cx - 9, cy - h)
        cr.line_to(cx - 4, cy)
        cr.line_to(cx + 6, cy + h)
        cr.set_line_width(s)
        cr.set_line_join(0)
        if solid or self.mode_on:
            cr.stroke()
            arrow_head(cx + 6, cy - h, +1)
            cr.stroke()
            arrow_head(cx + 6, cy + h, +1)
            cr.fill() if False else cr.set_line_width(s)
            for y in (cy - h, cy + h):
                arrow_head(cx + 6, y, +1)
            cr.stroke()
        else:
            cr.stroke()
            for y in (cy - h, cy + h):
                arrow_head(cx + 6, y, +1)
            cr.stroke()

    def _repeat(self, cr, cx, cy, col, solid):
        """Two arrows chasing each other round a loop -- the repeat glyph.
        Same ink height (13px), outline at rest, solid when lit."""
        h = 5.2
        s = self.STROKE
        # a rounded rectangle *path* (stroke only) as the loop body
        rx, ry, rw, rh = cx - 8.5, cy - h, 17.0, h * 2
        cairo_round_rect(cr, rx, ry, rw, rh, 4.0)
        cr.set_source_rgba(*col)
        cr.set_line_width(s)
        if not (solid or self.mode_on):
            cr.set_line_width(s)
        cr.stroke()
        # gap the path on the right side where the arrowhead sits: paint a
        # small surface-coloured block over the arc, then draw the head.
        # Simpler and honest at this size: draw the head at the path's right
        # mid, pointing down, slightly larger than the stroke so it reads.
        cr.set_source_rgba(*col)
        cr.move_to(cx + 8.5, cy)
        cr.line_to(cx + 4.9, cy - 0.5)
        cr.line_to(cx + 8.6, cy - 3.6)
        cr.close_path()
        cr.fill()
        cr.move_to(cx + 8.5, cy)
        cr.line_to(cx + 4.9, cy + 0.5)
        cr.line_to(cx + 8.6, cy + 3.6)
        cr.close_path()
        cr.fill()

    def _triangle(self, cr, cx, cy, col, solid):
        """`play_arrow`: an OUTLINE triangle at rest, solid on hover."""
        h = 6.5
        w = 6.0
        x0, x1 = cx - w / 2.0, cx + w / 2.0
        cr.move_to(x0, cy - h)
        cr.line_to(x1, cy)
        cr.line_to(x0, cy + h)
        cr.close_path()
        cr.set_source_rgba(*col)
        if solid:
            cr.fill()
        else:
            # An outlined triangle is two edges plus a stem: the stock GTK
            # "media-playback-start-symbolic" glyph IS filled, and the
            # difference is the whole point of the bar's fill axis.
            cr.set_line_width(1.7)
            cr.set_line_join(0)          # cairo.LINE_JOIN_MITER
            cr.stroke()
            cr.rectangle(x0 - 1.7, cy - h, 1.7, h * 2)
            cr.fill()

    def _pause(self, cr, cx, cy, col, solid):
        """Two rounded bars: 5x13, radius 2.5, 1.7 border. Drawn, not a glyph."""
        bw, bh, br = self.BAR_W, self.BAR_H, self.BAR_R
        gap = 3.0
        total = bw * 2 + gap
        left = cx - total / 2.0
        for i in range(2):
            x = left + i * (bw + gap)
            y = cy - bh / 2.0
            cairo_round_rect(cr, x, y, bw, bh, br)
            if solid:
                cr.set_source_rgba(*col)
                cr.fill()
            else:
                cr.set_source_rgba(*rgba(TEXT, 0.0))
                cr.fill()
                cairo_round_rect(cr, x + self.STROKE / 2.0,
                                 y + self.STROKE / 2.0,
                                 bw - self.STROKE, bh - self.STROKE,
                                 max(0.0, br - self.STROKE / 2.0))
                cr.set_source_rgba(*col)
                cr.set_line_width(self.STROKE)
                cr.stroke()

    def _skip(self, cr, cx, cy, col, solid):
        """`skip_previous` / `skip_next` as the bar draws them: a stem and a
        triangle, mirrored, both outlined at rest.

        FILL is PINNED on these two: the ring is the hover tell, and a glyph
        that also filled on hover read as a weird transition rather than as a
        hover. The bar's glyph is one `skip_next`/`skip_previous` ligature
        rather than a bar with a triangle stuck on the front, because the
        two-piece version's bar is 9px against the triangle's 15px of ink and
        it reads as a lowercase k. Here both halves are drawn from the same
        height, which is the same correction.
        """
        h = 6.5          # half the mark's height: 13px of ink, as the bar's
        # The triangle is as WIDE as it is tall, not narrower. It was 6 wide
        # against 13 of height and read as a thorn rather than an arrowhead;
        # the bar's glyph is a squat triangle, which is what makes it a mark
        # rather than a spike.
        tri = 8.5
        stem = 1.8
        gap = 1.5
        total = stem + gap + tri
        left = cx - total / 2.0

        # "prev": stem on the left, triangle pointing LEFT at it.
        # "next": triangle on the left pointing RIGHT, stem on the right.
        if self.kind == "next":
            stem_x = left + tri + gap
            apex_x, base_x = stem_x, left
        else:
            stem_x = left
            apex_x, base_x = left + total, left + stem + gap

        cr.set_source_rgba(*col)
        cr.rectangle(stem_x, cy - h, stem, h * 2)
        cr.fill()

        cr.move_to(apex_x, cy - h)
        cr.line_to(base_x, cy)
        cr.line_to(apex_x, cy + h)
        cr.close_path()
        if solid:
            cr.fill()
        else:
            # Outlined at rest. The path is INSET by half the stroke so the
            # triangle's ink finishes at the same 13px the stem's does instead
            # of overshooting it by the stroke's own width -- and so the
            # centred stroke never eats the apex, which is what turned the
            # triangle into an invisible sliver at 1.7px.
            inset = self.STROKE / 2.0
            ih = h - inset
            iw = tri - inset
            cr.move_to(apex_x - (inset if self.kind == "next" else -inset), cy - ih)
            cr.line_to(base_x, cy)
            cr.line_to(apex_x - (inset if self.kind == "next" else -inset), cy + ih)
            cr.close_path()
            cr.set_line_width(self.STROKE)
            cr.set_line_join(0)      # cairo.LINE_JOIN_MITER
            cr.stroke()


class SoundBar(Gtk.Box):
    """The merged spectrum + seek + clock + volume, as one widget."""

    PAD = 4                # the panel passes pad: 4
    BARS_HEIGHT = 28
    GAP = 4                # bars -> times
    TIMES_HEIGHT = 13
    LINE_HEIGHT = 4
    BAR_STEP = 12          # one pill per ~12px
    BAR_GAP = 3
    MIN_PILL = 3

    @property
    def HEIGHT(self):
        """The widget's natural height, in one place.

        Drawing and hit-testing both read these, so a bar that measured 28px
        and a bar drawn for 28px could not drift apart.
        """
        return 2 * self.PAD + self.BARS_HEIGHT + self.GAP + self.TIMES_HEIGHT

    def __init__(self):
        super().__init__(orientation=Gtk.Orientation.VERTICAL)
        self.set_valign(Gtk.Align.CENTER)
        self.add_css_class("soundbar")

        # --- the drawing surface: the line and the pills -----------------
        self._area = Gtk.DrawingArea()
        self._area.set_hexpand(True)
        # The bar's height is EXPLICIT. A DrawingArea measures to nothing on
        # its own, so without this the whole widget laid out at 0px and drew
        # nothing at all -- no line, no pills, no spectrum, no error. The
        # number is the component's own: pad*2 + bars + gap + times.
        self._area.set_size_request(-1, self.HEIGHT)
        self._area.set_draw_func(self._draw)
        self._area.add_css_class("soundcanvas")

        # The hover bubble. A Gtk.Label rather than drawn text, so it picks up
        # the same font stack as every other label in the window.
        self._bubble = Gtk.Label(label="")
        self._bubble.add_css_class("bubble")
        self._bubble.set_visible(False)

        self._overlay = Gtk.Overlay()
        self._overlay.set_child(self._area)
        self._overlay.add_overlay(self._bubble)
        self.append(self._overlay)

        # --- the two stamps ----------------------------------------------
        times = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
        self._elapsed = Gtk.Label(label="0:00")
        self._elapsed.add_css_class("stamp")
        self._elapsed.set_halign(Gtk.Align.START)
        self._total = Gtk.Label(label="0:00")
        self._total.add_css_class("stamp")
        self._total.add_css_class("total")
        self._total.set_halign(Gtk.Align.END)
        # The spacer between the stamps HAS to expand. An empty Box does not:
        # it asks for zero width, so both stamps were packed against the left
        # edge and read as one number -- "1:211:28".
        spacer = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
        spacer.set_hexpand(True)
        times.append(self._elapsed)
        times.append(spacer)
        times.append(self._total)
        self.append(times)

        # --- state --------------------------------------------------------
        self.position = 0.0
        self.duration = 0.0
        self.volume = 1.0
        self.active = False          # can it be seeked at all
        self.show_spectrum = False   # only while something is playing
        self.spectrum = []
        self._hover_at = None
        self._scrubbing = False
        self._scrub_at = None
        self.on_seek = None          # cb(fraction)
        self.on_volume = None        # cb(level 0..100)

        self._install_gestures()

    # ── geometry ─────────────────────────────────────────────────────
    def _metrics(self, w, h):
        """Everything the drawing needs, in one place so the drawing cannot
        disagree with the hit-testing."""
        inner_w = w - 2 * self.PAD
        zone_h = self.BARS_HEIGHT
        times_y = zone_h + self.GAP
        line_y = zone_h - self.LINE_HEIGHT        # line sits at the BOTTOM
        bars_h = zone_h - self.LINE_HEIGHT        # pills stand on the line
        count = max(12, int(inner_w // self.BAR_STEP))
        pill_w = max(self.MIN_PILL,
                     (inner_w - self.BAR_GAP * (count - 1)) / count)
        return {
            "inner_w": inner_w, "zone_h": zone_h, "times_y": times_y,
            "line_y": line_y, "bars_h": bars_h, "count": count,
            "pill_w": pill_w, "h": h,
        }

    @property
    def fraction(self):
        return (self.position / self.duration) if self.duration > 0 else 0.0

    def _x_to_fraction(self, x, width):
        inner = width - 2 * self.PAD
        if inner <= 0:
            return 0.0
        return max(0.0, min(1.0, (x - self.PAD) / inner))

    def set_spectrum(self, points):
        self.spectrum = points
        self._area.queue_draw()

    def set_state(self, position=None, duration=None, volume=None,
                  active=None, show_spectrum=None):
        if position is not None:
            self.position = position
        if duration is not None:
            self.duration = duration
        if volume is not None:
            self.volume = max(0.0, min(1.0, volume / 100.0))
        if active is not None:
            self.active = active
        if show_spectrum is not None:
            self.show_spectrum = show_spectrum
        self._elapsed.set_text(clock(self.position))
        self._total.set_text(clock(self.duration))
        self._area.queue_draw()

    # ── drawing ──────────────────────────────────────────────────────
    def _draw(self, area, cr, w, h):
        m = self._metrics(w, h)
        frac = self.fraction

        # the line first, so the pills' feet land on top of it
        cr.set_source_rgba(*rgba(LAYER3))
        cairo_round_rect(cr, self.PAD, m["line_y"], m["inner_w"],
                         self.LINE_HEIGHT, self.LINE_HEIGHT / 2)
        cr.fill()
        if frac > 0:
            cr.set_source_rgba(*rgba(ACCENT))
            cairo_round_rect(cr, self.PAD, m["line_y"],
                             m["inner_w"] * min(1.0, frac),
                             self.LINE_HEIGHT, self.LINE_HEIGHT / 2)
            cr.fill()

        count, pill_w = m["count"], m["pill_w"]
        bars_h, line_y = m["bars_h"], m["line_y"]
        # PAUSED MUST STILL SHOW A BAR.
        #
        # This used to be `sink = 1.0 if show_spectrum else 0.0`, multiplied
        # into every pill's height. The intent was "hide the spectrum when
        # nothing is playing"; what it actually did was multiply the height to
        # ZERO, and the `hgt <= 0.4: continue` below then skipped every single
        # pill. So pausing replaced the whole instrument with a bare 4px line
        # -- which reads as "the audio bar is not shown", and it is exactly
        # what the user reported. Silence is not absence: a paused bar rests,
        # it does not vanish.
        #
        # So an idle spectrum is synthesised instead. It is a flat-ish row of
        # short pills with a gentle arc, which is what a visualiser looks like
        # between notes, and it keeps the widget's silhouette identical in
        # both states so nothing appears or disappears on pause.
        idle = None
        if not self.show_spectrum:
            idle = [0.30 + 0.16 * ((i % 7) / 6.0) for i in range(count)]
        for i in range(count):
            at = i / (count - 1) if count > 1 else 0.0
            # VOLUME is the ceiling on a real spectrum. The idle row is NOT
            # scaled by volume: it represents no sound, so it must not claim
            # to be a quiet one -- and a user who muted to zero should still
            # see the bar it belongs to.
            if idle is not None:
                hgt = idle[i] * bars_h
            else:
                hgt = max(2.0, band_shape(self.spectrum, i, count)
                          * self.volume * bars_h)
            if hgt <= 0.4:
                continue
            x = self.PAD + i * (pill_w + self.BAR_GAP)
            if idle is not None:
                # The idle row is drawn in the DIM accent: present, legible,
                # and visibly not live.
                cr.set_source_rgba(*rgba(ACCENT_DIM, 0.55))
            else:
                cr.set_source_rgba(*rgba(ACCENT if at <= frac else ACCENT_DIM,
                                         1.0 if at <= frac else 0.26))
            cairo_round_top(cr, x, line_y - hgt, pill_w, hgt, 2)
            cr.fill()

        # the hover mark: a thin rule down the bars, plus its time bubble
        hover = self._scrub_at if self._scrubbing else self._hover_at
        if hover is not None and self.active:
            x = self.PAD + hover * m["inner_w"]
            cr.set_source_rgba(*rgba(ACCENT, 0.9))
            cairo_round_rect(cr, x - 1, 0, 2, line_y + self.LINE_HEIGHT, 1)
            cr.fill()
            self._place_bubble(x, self._scrubbing)
        else:
            self._bubble.set_visible(False)

    def _place_bubble(self, x, filled):
        w = self._area.get_width() or 1
        self._bubble.set_text(clock(self._hover_seconds(x / w)))
        self._bubble.set_visible(True)
        bw = self._bubble.measure(Gtk.Orientation.HORIZONTAL, -1)[1] + 10
        # keep it inside the canvas rather than letting it hang off the end
        bx = max(0.0, min(x - bw / 2, w - bw))
        self._bubble.set_halign(Gtk.Align.START)
        self._bubble.set_margin_start(int(bx))
        self._bubble.set_margin_top(-26)

    def _hover_seconds(self, frac):
        return max(0.0, min(1.0, frac)) * self.duration

    # ── input ────────────────────────────────────────────────────────
    def _install_gestures(self):
        motion = Gtk.EventControllerMotion()
        motion.connect("enter", self._on_enter)
        motion.connect("leave", self._on_leave)
        motion.connect("motion", self._on_motion)
        self._area.add_controller(motion)

        click = Gtk.GestureClick()
        click.set_button(1)
        click.connect("pressed", self._on_press)
        click.connect("released", self._on_release)
        self._area.add_controller(click)

        drag = Gtk.GestureDrag()
        drag.connect("begin", self._on_drag_begin)
        drag.connect("update", self._on_drag_update)
        drag.connect("end", self._on_drag_end)
        self._area.add_controller(drag)

        scroll = Gtk.EventControllerScroll()
        scroll.set_flags(Gtk.EventControllerScrollFlags.DISCRETE)
        scroll.connect("scroll", self._on_scroll)
        self._area.add_controller(scroll)

    def _pos_to_frac(self, x):
        return self._x_to_fraction(x, self._area.get_width() or 1)

    def _on_enter(self, _c, x, _y):
        if self.active:
            self._hover_at = self._pos_to_frac(x)
            self._area.queue_draw()

    def _on_motion(self, _c, x, _y):
        if self.active:
            self._hover_at = self._pos_to_frac(x)
            self._area.queue_draw()
        if self._scrubbing:
            self._scrub_at = self._pos_to_frac(x)
            self._area.queue_draw()

    def _on_leave(self, *_):
        self._hover_at = None
        self._area.queue_draw()

    def _on_press(self, _c, n, x, _y):
        if not self.active or self.duration <= 0 or n != 1:
            return
        # Seek on release, not on press: a click is a gesture, and dragging
        # across the bar must not fire a seek per motion event.
        self._scrub_at = self._pos_to_frac(x)
        self._scrubbing = True
        self._area.queue_draw()

    def _on_release(self, _c, _n, _x, _y):
        # A plain click: the gesture never became a drag, so this is the only
        # place the seek for it gets sent. Without it a click scrubs the bar
        # and then silently puts it back.
        self._commit_scrub()

    def _on_drag_begin(self, _c, _x, _y):
        if not self.active or self.duration <= 0:
            return
        self._scrubbing = True

    def _on_drag_update(self, _c, dx, _y):
        if not self._scrubbing:
            return
        w = self._area.get_width() or 1
        self._hover_at = self._scrub_at = max(
            0.0, min(1.0, self._scrub_at + dx / w))
        self._area.queue_draw()

    def _on_drag_end(self, _c, _dx, _y):
        self._commit_scrub()

    def _commit_scrub(self):
        if not self._scrubbing:
            return
        f = self._scrub_at
        self._scrubbing = False
        self._scrub_at = None
        if self.on_seek and self.duration > 0:
            self.on_seek(f)
        self._area.queue_draw()

    def _on_scroll(self, _c, _dx, dy):
        # Volume, the same gesture the panel's bar takes.
        if not self.on_volume:
            return False
        step = -5 if dy > 0 else 5
        base = self.volume * 100
        self.on_volume(max(0, min(100, int(base) + step)))
        return True


# ── mpv IPC client (same socket as the sidebar) ──────────────────────────────

class Mpv:
    def __init__(self):
        self.sock = None
        self.lock = threading.Lock()
        self.pending = {}
        self.handlers = []
        self.daemon_up = False
        threading.Thread(target=self._loop, daemon=True).start()

    def _connect(self):
        try:
            s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
            s.settimeout(2)              # the timeout is for CONNECTING only
            s.connect(SOCK)
            # ...and is then removed, because the read timeout is the single
            # worst thing that can sit on this socket.
            #
            # `socket.timeout` IS an `OSError`, so a 2s read timeout means
            # every two seconds of silence -- i.e. whenever nothing on the
            # player is changing, which is most of the time -- raises
            # TimeoutError, lands in the `except OSError` below, tears the
            # socket down and tells every handler the daemon DIED. That is why
            # the window said "Daemon offline / starting ii-music-mpd..." while
            # the bar said it was playing the same track: both were right, one
            # was lying about the other, and it flapped forever.
            #
            # A read timeout cannot distinguish "nothing yet" from "gone"
            # anyway. Death is `recv` returning b"" or a real OSError, and both
            # are handled below.
            s.settimeout(None)          # block forever on recv
            self.sock = s
            self.daemon_up = True
            for cb in self.handlers:
                GLib.idle_add(cb, True)
            for name in ["pause", "time-pos", "duration",
                         "media-title", "metadata", "path", "volume",
                         "playlist-count", "playlist-pos",
                         "idle-active", "loop-file"]:
                self.send(["observe_property", name])
            return True
        except OSError:
            self.daemon_up = False
            return False

    def _loop(self):
        buf = b""
        while True:
            if self.sock is None:
                self._connect()
                time.sleep(2)
                continue
            try:
                chunk = self.sock.recv(65536)
                if not chunk:
                    raise OSError("closed")
                buf += chunk
                while b"\n" in buf:
                    line, buf = buf.split(b"\n", 1)
                    try:
                        d = json.loads(line)
                    except ValueError:
                        continue
                    rid = d.get("request_id")
                    if rid is not None and rid in self.pending:
                        cb = self.pending.pop(rid)
                        if d.get("error") == "success":
                            GLib.idle_add(cb, d.get("data"))
                    elif d.get("event") == "property-change":
                        for cb in list(self.handlers):
                            GLib.idle_add(cb, d)
            except socket.timeout:
                # Belt and braces: a timeout is NOT a disconnection, whatever
                # this socket's timeout happens to be set to.
                continue
            except OSError:
                self.sock = None
                self.daemon_up = False
                for cb in self.handlers:
                    GLib.idle_add(cb, False)
                time.sleep(2)

    def send(self, command, cb=None):
        if self.sock is None:
            if cb:
                GLib.idle_add(cb, None)
            return
        with self.lock:
            try:
                msg = {"command": command}
                if cb:
                    self._next_id = getattr(self, "_next_id", 0) + 1
                    msg["request_id"] = self._next_id
                    self.pending[self._next_id] = cb
                self.sock.sendall((json.dumps(msg) + "\n").encode())
            except OSError:
                self.sock = None
                self.daemon_up = False


# ── the window ───────────────────────────────────────────────────────────────

def publish_presence():
    """Tell the shell this app is alive, even with no window up.

    The shell's background-apps tray reads this file, so a hidden app is
    still listed and still clickable. Written at STARTUP rather than when a
    window appears, because the state the tray cares about is "the process
    exists", not "a window is mapped" -- and the whole point of the model is
    that the window can be closed while the app keeps running. Removed only
    on a real quit.
    """
    try:
        with open(PRESENCE, "w") as fh:
            fh.write(f"{os.getpid()}\n")
    except OSError:
        pass


def clear_presence():
    try:
        os.unlink(PRESENCE)
    except OSError:
        pass


class MusicWindow(Adw.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app)
        self.set_title("Music")
        self.set_default_size(1120, 780)
        # A minimum width, and it is a real one rather than a guess.
        #
        # Nothing set one, and a tiling compositor will happily hand a window
        # less than its content needs. Squeezed below the layout's own
        # minimum, GTK does not shrink the transport -- it CLIPS it, and the
        # next mark disappears off the right edge with no ellipsis and no
        # error. That is the "the buttons are not the same as the top bar's"
        # complaint reproduced at the wrong width.
        #
        # The sum it has to cover: 210 rail + 1 separator + 44 hero margins +
        # 96 cover + 2*18 of gaps + 91 transport + room for a long title.
        # `tmp/test-ii-music-ui.py` measures the real figure rather than
        # trusting this arithmetic, and asserts the window is wide enough.
        #
        # Height is left alone: the list below the hero is a scroller and
        # wants to be short.
        self.set_size_request(700, -1)
        self._sel_playlist = None
        self._sel_track = None
        self._seeking = False
        self._query = ""
        self._raw_query = ""
        # Online state. AUDIUS owns the results (it is the thing that knows
        # about paging); the window owns what the user has done with them.
        self._online_saved = {}     # track id -> file it was saved to
        self._downloading = ""      # id of the download in flight
        self._search_timer = None   # debounce handle
        self._status = ""
        self._visible = []          # [(track, playlist name)] as listed
        self._rows = []             # row widgets, index-aligned with _visible
        self._play_row = None
        self._state = {"paused": True, "title": "", "artist": "",
                       "album": "", "pos": 0.0, "dur": 0.0, "qpos": -1,
                       "volume": 0.0, "filename": "", "pos_at": 0.0,
                       "metadata": {}}
        self._cover_key = None
        self._last_seek_touch = 0.0
        self._daemon = False
        self._durations = {}
        self._last_playlist = None
        self._last_playing_path = ""
        self._measured_playlist = None
        self._spectrum = []
        self.cfg = load_config()

        self.mpv = Mpv()
        self.mpv.handlers.append(self._on_mpv)

        self.build()
        self._init_hide_on_close()
        self.apply_config()
        self.refresh_library()
        # The poll drives the bar, the spectrum and the row meter, so it runs
        # on a fraction of a second while something is playing rather than on
        # the five-second cadence that left the scrubber frozen.
        GLib.timeout_add(250, self._poll)
        # cava's bands, copied onto the GTK thread and handed to the bar.
        GLib.timeout_add(60, self._tick_spectrum)

    # ── close hides, it does not quit ─────────────────────────────────
    # The whole point of the background-app model: the window is a face of
    # the daemon, so closing it must not stop the music. The app stays in the
    # shell's tray and the window comes back from there. Quitting is a
    # deliberate action (Quit button / tray), and even then playback survives,
    # because the daemon is a separate service.
    #
    # Gtk.Window's own `hide-on-close` does exactly this, so it is used
    # rather than a close-request override: no vfunc to chain up, and the
    # window is merely unmapped instead of destroyed.
    def _init_hide_on_close(self):
        self.set_hide_on_close(True)

    def _publish_presence(self):
        publish_presence()

    # ── css ──────────────────────────────────────────────────────────────
    # One provider, one ramp. Every surface in the app is one of LAYER1..3,
    # every edge OUTLINE (OUTLINE2 when hovered), every secondary text SUB,
    # and ACCENT appears only where something is actionable or selected.
    def _css(self):
        prov = Gtk.CssProvider()
        prov.load_from_data(f"""
