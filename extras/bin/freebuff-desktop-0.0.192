#!/bin/bash
# Freebuff Desktop 0.0.192 — the last release before 0.0.194, the hybrid web
# interface and cloud runner that made 0.0.204 lag on this machine. It is as
# close to the rewritten build as the old interface goes, and it carries the
# session plumbing used for the countdown badge.
# It runs on a COPY of the live profile so every thread/session from the current
# build is already there, while the current build keeps writing to its own.
#
# Why a copy and not the same profile: the running build holds
# ~/.config/freebuff-desktop/state.json, its orchestrator lock and every
# desktop-v2.db open in WAL mode. Pointing a second app at them means two
# writers and, at best, a refused start (`code 75`) — so 0.0.192 gets
#     sessions: ~/.config/freebuff-desktop-0.0.192   (state.json + projects/*)
#     browser : ~/.config/Freebuff-0.0.192           (--user-data-dir)
# The copy was made with `sqlite3 .backup` per store, so it is a consistent
# snapshot taken while the app was running, not a torn file copy.
#
# ── Which profile the orchestrator uses ─────────────────────────────────
# NOT --user-data-dir. The orchestrator resolves its profile from
# FREEBUFF_DESKTOP_STATE_PATH, and the running build exports that variable to
# every shell it starts (this one included), already pointing at the live
# profile. Defaulting it would silently reuse the live path and hit its lock,
# so it is overwritten, never defaulted.
#
# ── Rendering ──────────────────────────────────────────────────────────
# Same backend the 0.0.184 launcher measured as the only stable one on this
# machine: XWayland + --disable-gpu. Native Wayland + GPU stops at the splash
# with GBM/SCANOUT and Intel execbuf ENOMEM here, and this build is the same
# Electron generation. FREEBUFF_0188_RENDER=wayland tries the other backend.
#
# To refresh the copy later (after working in the current build), close 0.0.192
# and run extras/bin/freebuff-0188-refresh-profile with FREEBUFF_0188_PROFILE set
# to this profile (installed in ~/.local/bin).
set -u

APP="$HOME/Applications/Freebuff-0.0.192-linux-x86_64.AppImage"
PROFILE="${FREEBUFF_0188_PROFILE:-$HOME/.config/freebuff-desktop-0.0.192}"
DATA="${FREEBUFF_0188_DATA:-$HOME/.config/Freebuff-0.0.192}"
SCALE="${FREEBUFF_0188_SCALE:-1.5}"

if [ ! -x "$APP" ]; then
    echo "freebuff-desktop-0.0.192: $APP is missing or not executable" >&2
    echo "  download: github.com/CodebuffAI/codebuff-community/releases/tag/freebuff-desktop-v0.0.192" >&2
    exit 1
fi
if [ ! -f "$PROFILE/state.json" ]; then
    echo "freebuff-desktop-0.0.192: $PROFILE/state.json is missing" >&2
    echo "  it holds the sign-in and the thread index; recreate it from the live profile first" >&2
    exit 1
fi

mkdir -p "$DATA" 2>/dev/null
log="$DATA/launch.log"

# ── Session countdown ──────────────────────────────────────────────────
# This build never shows how long the running session has left. The
# orchestrator serves its interface from FREEBUFF_UI_DIR when that is set, so a
# patched copy of the same interface (plus one badge script) is served instead.
# Only that copy is written; the profile, the databases and the AppImage are
# untouched. FREEBUFF_0188_SESSION_UI=0 launches the stock interface.
# The packaged app hard-codes its interface path inside the read-only AppImage,
# so the countdown needs a runnable tree: the helper extracts the image once,
# patches the interface, and prints <tree>/AppRun, which is what gets started.
run="$APP"
if [ "${FREEBUFF_0188_SESSION_UI:-1}" != "0" ]; then
    helper="$(dirname "$(readlink -f "$0")")/freebuff-0188-session-time-ui"
    tree="$DATA/app-0192"
    patched=""
    if [ -x "$helper" ]; then
        patched=$("$helper" "$APP" "$tree" 2>>"$log")
    fi
    if [ -n "$patched" ] && [ -x "$patched" ]; then
        # The extracted binary directly, not AppRun: AppRun re-derives APPDIR by
        # walking its own path against $1, which any leading flag breaks.
        run="$tree/freebuff"
        [ -x "$run" ] || run="$patched"
        export APPDIR="$tree"
    else
        echo "[launcher] session countdown unavailable; running the AppImage" >>"$log"
    fi
fi

export FREEBUFF_DISABLE_UPDATE_CHECK=1
export FREEBUFF_DESKTOP_STATE_PATH="$PROFILE/state.json"

export XCURSOR_THEME=Bibata-Modern-Ice
export XCURSOR_SIZE="${XCURSOR_SIZE:-24}"
export XCURSOR_PATH=~/.local/share/cursor-shims:~/.local/share/icons:~/.icons:/usr/share/icons:/usr/share/pixmaps

# A socket file is not proof of a server: this desk has a stale
# /tmp/.X11-unix/X0 that answers nothing.
x_display_answers() {
    [ -S "/tmp/.X11-unix/X${1#:}" ] || return 1
    DISPLAY="$1" timeout 2 xrandr --current >/dev/null 2>&1
}

find_x_display() {
    local n d
    if [ -n "${DISPLAY:-}" ] && x_display_answers "$DISPLAY"; then
        printf '%s' "$DISPLAY"; return 0
    fi
    for n in 0 1 2 3; do
        d=":$n"
        if x_display_answers "$d"; then printf '%s' "$d"; return 0; fi
    done
    return 1
}

if [ "${FREEBUFF_0188_RENDER:-x11}" = "wayland" ]; then
    # DISPLAY must NOT be set here, or Chromium can pick X11 even when told
    # wayland.
    unset DISPLAY ELECTRON_OZONE_PLATFORM_HINT
    exec "$run" \
        --user-data-dir="$DATA" \
        --ozone-platform=wayland \
        --force-device-scale-factor="$SCALE" \
        --disable-gpu --no-sandbox \
        "$@" >>"$log" 2>&1
fi

if ! xdisp=$(find_x_display); then
    echo "freebuff-desktop-0.0.192: no X display answered; start XWayland or run FREEBUFF_0188_RENDER=wayland $0" >&2
    exit 1
fi
export DISPLAY="$xdisp"
# An empty XAUTHORITY also means "look in ~/.Xauthority", so only set it when
# absent -- and this session does not export one.
if [ -z "${XAUTHORITY:-}" ] && [ -f "$HOME/.Xauthority" ]; then
    export XAUTHORITY="$HOME/.Xauthority"
fi
unset ELECTRON_OZONE_PLATFORM_HINT

exec "$run" \
    --user-data-dir="$DATA" \
    --ozone-platform=x11 \
    --force-device-scale-factor="$SCALE" \
    --disable-gpu --no-sandbox \
    "$@" >>"$log" 2>&1
