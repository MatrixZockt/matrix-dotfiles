# WhisperFlow on this machine (2026-11-17).
#
# ONE speech engine for the whole desktop. The shell's hold-SUPER dictation
# already runs a warm whisper.cpp server (dictate-server.service) with
# large-v3-turbo on the GPU, so WhisperFlow points at THAT server instead of
# starting a second copy: on 8 GB of VRAM a second model does not fit next to
# the local llama-server, and two servers holding the same weights would just
# halve the free memory for nothing.
#
# The trade-off is that WhisperFlow needs the shell's server up. It is a
# systemd unit enabled at login, and `dictate-server.sh start` brings it back
# if it was stopped, so in practice it always is.
WHISPER_FLOW_LOCAL_WHISPER_URL=http://127.0.0.1:8917
#
# That port is the shell's warm engine itself (dictate-server.service, 8917).
# There is no bridge in between any more: the Groq forwarder that used to sit
# on 8918 was removed on 2026-11-18 along with its API key, so this app and
# hold-SUPER dictation post to the same local whisper.cpp server and nothing
# leaves the machine.
WHISPER_FLOW_MANAGE_LOCAL_SERVER=false
WHISPER_FLOW_MODEL_NAME=ggml-large-v3-turbo-q5_0

#
# On 2026-11-17 this line was not in effect: the daemon came up on its default
# and bound BARE SUPER, so one hold recorded in both daemons and both pasted the
# same sentence. Keep transcribe on a key the shell does not use.
#
# MODELS: the app decides whether it can transcribe at all by looking for a
# model file in $XDG_CONFIG_HOME/whisper-flow/models. With none there it warned
# "No speech model installed" on every recording, although the URL above
# transcribes fine -- its own engine stays uninstalled on purpose, the shell's
# server holds the weights. The shell's model is therefore linked in under the
# name this file asks for, which silences the warning without handing the app a
# server binary to start:
#   mkdir -p ~/.config/whisper-flow/models
#   ln -sfn ~/.local/share/ii-dictate/models/ggml-large-v3-turbo-q5_0.bin \
#           ~/.config/whisper-flow/models/ggml-large-v3-turbo-q5_0.bin
# Hotkeys. Push-to-talk is NOT super+alt: SUPER alone is this desktop's
# hold-to-dictate, and holding SUPER+ALT would arm the shell's dictation and
# WhisperFlow's at the same time, typing everything twice.
WHISPER_FLOW_HOTKEY_TRANSCRIBE=ctrl+alt+d
WHISPER_FLOW_HOTKEY_AUTO_TRANSCRIBE=ctrl+alt+space
WHISPER_FLOW_HOTKEY_COMMAND=ctrl+super+alt

WHISPER_FLOW_LIVE_TRANSCRIPTION=true
