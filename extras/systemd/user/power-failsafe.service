[Unit]
Description=ii power failsafe - when the CPU is pegged (>=90% busy) AND lagging (PSI cpu >=20%, OR the fastest core below 80% of its base clock with >=8% PSI on top), raise Performance; this is the ONLY thing that switches the power mode on its own
# There is no graphical-session.target on this setup (it is inactive), so the
# anchor is default.target: the daemon is cheap while idle (one awk every 5s)
# and starting it early is harmless.
After=default.target

[Service]
Type=simple
# WHY THIS IS ON (2026-10-26, owner's rule): the CPU being pegged to 100%
# AND lagging is the one and only condition allowed to move the power mode
# by itself -- and it has to actually MOVE it. This daemon shipped in
# alarm-only mode, so with the machine sitting on the 20 W eco cap nothing
# ever lifted it: the watchdog logged the lag, notified about it, and left
# the machine to crawl. That is the "it is still lagging" report.
#
# The strictness lives in the ladder inside the script (2 consecutive
# samples at 2 s of peg AND stall, a 300 s cooldown, and a stand-down only
# after sustained calm), not in refusing to act. A merely busy machine at
# the clock its own cap allows is not a stall and does not escalate
# (2026-11-04: the clock line alone produced three false raises in one
# afternoon -- see the header of the script). Everything that is not the CPU being pegged
# -- memory, io, the GPU -- is still ignored outright, and a machine that is
# merely busy at full clock is still left alone.
Environment=FAILSAFE_ESCALATE=1
ExecStart=%h/.local/bin/power-failsafe
Restart=on-failure
RestartSec=10
# A watchdog that dies silently is worse than none: journal is the record.
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
