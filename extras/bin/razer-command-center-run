#!/usr/bin/env bash
# Launch the Razer control app against the LIVE graphical session.
#
# Why a wrapper instead of ExecStart=%h/.local/bin/razer-command-center
# ---------------------------------------------------------------------
# This unit is enabled at login, so it runs from the systemd *user manager*.
# That manager is started once per boot, not once per login, and its
# environment is a snapshot from that moment. WAYLAND_DISPLAY is allocated
# per login, so the snapshot goes stale: on this machine it advertises
# `wayland-2` (a socket left behind by a crashed Hyprland, connection
# refused) while the live session is `wayland-1`.
#
# GTK resolves its display from that variable before anything else runs, so
# the app died in 251 ms every time with:
#     RuntimeError: Gtk couldn't be initialized.
#     Use Gtk.init_check() if you want to handle this case.
# and systemd reported `status=0/SUCCESS` only because the Python process
# exited 0 on the unhandled path -- a silent, invisible failure.
#
# `systemctl --user import-environment` would patch this login but not the
# next one, so we do not read the manager's environment at all. session-env
# connect-probes /run/user/$UID/wayland-* and reports the compositor that is
# actually listening, then we hand the real app exactly that.
#
# If no compositor answers YET, that is the normal state at login, not an
# error: this unit is WantedBy=default.target, so it starts in the same
# transaction as the session and routinely wins the race -- on 2026-09-28 it
# ran 7 ms after the old compositor died and 3 s before the new one existed.
# The first version of this wrapper treated that as "nothing to do" and exited
# 0, so systemd recorded a SUCCESS, `Restart=on-failure` never fired, and the
# app simply never appeared for the whole session.
#
# So: WAIT for one. Polling, not Restart=, because systemd would otherwise
# either give up (exit 0) or restart-storm (exit non-zero) while the
# compositor is still coming up.
set -u

SESSION_ENV=""
for _ in $(seq 1 60); do
    if SESSION_ENV="$("$HOME/.local/bin/session-env")"; then
        break
    fi
    SESSION_ENV=""
    sleep 1
done

if [ -z "$SESSION_ENV" ]; then
    # A full minute with no compositor is a real failure, not a slow start.
    # Exit non-zero so the unit reports it instead of pretending to be fine.
    echo "razer-command-center: no compositor after 60s; giving up." >&2
    exit 1
fi

echo "razer-command-center: starting with $(echo "$SESSION_ENV" | tr '\n' ' ')" >&2

# GSK_RENDERER=cairo keeps GTK off the GL path. On this hybrid-GPU laptop
# that keeps the app from creating an EGL context, which is both a
# compatibility risk and -- because it is a client on the dGPU -- a reason for
# the 4070 to stay awake.
exec env $SESSION_ENV GSK_RENDERER=cairo "$HOME/.local/bin/razer-command-center" "$@"
