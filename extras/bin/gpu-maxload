#!/usr/bin/env bash
# gpu-maxload -- prove the dGPU ramps up under load and comes back down.
#
# WHY THIS EXISTS
# ---------------
# Every other GPU readout on this machine is a passive sample, and a passive
# sample cannot tell "correctly idle" from "stuck and lying about it". This
# creates real demand on the 4070 and measures both halves of the claim:
#
#   1. WAKE  -- does the card leave its idle P-state and climb?
#   2. IDLE  -- does it fall back to P8 on its own once the work stops,
#               and how long does that take?
#
# The workload is vkcubepp (a Vulkan demo shipped with the driver) pointed at
# the NVIDIA ICD with VK_ICD_FILENAMES. That variable is the whole trick:
# without it the demo runs on the Intel iGPU through Mesa and this script
# measures the wrong card entirely. Verified: vulkaninfo --summary shows two
# devices, and only with the NVIDIA ICD forced does the 4070 move.
#
# PRESENT MODE IS NOT OPTIONAL. vkcubepp defaults to FIFO (vsync), which
# paces it to the display refresh and holds the card at ~16 W / P3 no matter
# how long it runs -- measured, and it looks like a weak card when it is
# really just a throttled demo. IMMEDIATE removes the frame pacing and the
# card reaches P0.
#
# WHAT IT CANNOT DO
# -----------------
# It cannot saturate the silicon. This laptop's enforced power limit is 55 W
# (nvidia-smi: power.max_limit 140 W, enforced.power.limit 55 W), and a
# single vsync-free Vulkan demo does not draw that. Expect roughly 30-40%
# utilisation and ~20 W, not 100% and not 55 W. Reaching the real ceiling
# needs a real benchmark (glmark2, a game, or a CUDA workload). Treat the
# numbers below as proof of the POWER TRANSITION, which is what this machine
# can actually be asked to demonstrate.
set -u

DUR="${1:-5}"
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
export WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-wayland-1}"
ICD=/usr/share/vulkan/icd.d/nvidia_icd.json

if [ ! -e "$ICD" ]; then
    echo "FAIL: $ICD missing -- cannot force the workload onto the dGPU." >&2
    exit 1
fi
command -v vkcubepp >/dev/null || {
    echo "FAIL: vkcubepp not installed (package: vulkan-tools / mesa-demos)." >&2
    exit 1
}

smi() { nvidia-smi --query-gpu="$1" --format=csv,noheader,nounits -i 0; }

echo "=== idle, before ==="
echo "  $(smi pstate), $(smi utilization.gpu)% util, $(smi power.draw) W, $(smi clocks.gr) MHz, $(smi memory.used) MiB VRAM"
IDLE_PSTATE=$(smi pstate | tr -d ' ')
IDLE_W=$(smi power.draw)

VK_ICD_FILENAMES="$ICD" setsid vkcubepp \
    --c 100000000 --width 3840 --height 2160 --suppress_popups \
    --present_mode VK_PRESENT_MODE_IMMEDIATE_KHR \
    </dev/null >/dev/null 2>&1 &
LOAD=$!
sleep 2
if ! pgrep -x vkcubepp >/dev/null; then
    echo "FAIL: the workload did not start." >&2
    exit 1
fi

PEAK_UTIL=0; PEAK_W=0; PEAK_CLK=0; PEAK_TEMP=0; SAW_BUSY=0
END=$((SECONDS + DUR))
echo "=== under load, ${DUR}s ==="
while [ "$SECONDS" -lt "$END" ]; do
    u=$(smi utilization.gpu); w=$(smi power.draw)
    p=$(smi pstate | tr -d ' '); c=$(smi clocks.gr); t=$(smi temperature.gpu)
    printf "  %3s%%  %6s W  %-4s  %5s MHz  %2s C\n" "$u" "$w" "$p" "$c" "$t"
    # Compare as integers only. nvidia-smi answers "[N/A]" for a field it
    # cannot read, and a float compare against that silently fails, which
    # previously left PEAK reporting "0 W" next to a column of 25 W.
    u=${u%%\%*}; w=${w%%.*}; c=${c%%.*}; t=${t%%.*}
    case "$u" in ''|*[!0-9]*) u=0 ;; esac
    case "$w" in ''|*[!0-9]*) w=0 ;; esac
    case "$c" in ''|*[!0-9]*) c=0 ;; esac
    case "$t" in ''|*[!0-9]*) t=0 ;; esac
    [ "$u" -gt "$PEAK_UTIL" ] && PEAK_UTIL=$u
    [ "$w" -gt "$PEAK_W" ] && PEAK_W=$w
    [ "$c" -gt "$PEAK_CLK" ] && PEAK_CLK=$c
    [ "$t" -gt "$PEAK_TEMP" ] && PEAK_TEMP=$t
    # "Busy" means left the idle floor, not specifically P0. P3 at 2445 MHz
    # is unambiguously working -- checking only for P0/P1/P2 reported "NO,
    # demand did not reach it" while the card was visibly at 42% and 2.4 GHz,
    # which is the sort of confidently wrong verdict this script exists to
    # avoid. The same idle set the app uses (P7/P8) decides the negative.
    case "$p" in
        P0|P1|P2|P3|P4|P5|P6) SAW_BUSY=1 ;;
    esac
    sleep 0.5
done

pkill -x vkcubepp 2>/dev/null
T0=$(date +%s%N)
BACK=""
while [ $(( ($(date +%s%N) - T0) / 1000000000 )) -lt 20 ]; do
    p=$(smi pstate | tr -d ' ')
    if [ "$p" = "P8" ] || [ "$p" = "P7" ]; then BACK=$p; break; fi
    sleep 0.2
done
SETTLE_MS=$(( ($(date +%s%N) - T0) / 1000000 ))
echo "=== back to idle ==="
echo "  $(smi pstate), $(smi utilization.gpu)% util, $(smi power.draw) W, $(smi clocks.gr) MHz (the moment the P-state flipped)"
# Then wait for the wattage to actually settle. The P-state flips back long
# before the rails bleed down -- reporting that first figure alone made the
# card look like it was still drawing 21 W at idle, which it is not. Measured
# settle on this machine: back to ~4.6 W / 210 MHz within about 4 s.
T1=$(date +%s%N)
SETTLED=""
while [ $(( ($(date +%s%N) - T1) / 1000000000 )) -lt 15 ]; do
    w=$(smi power.draw); w=${w%%.*}
    case "$w" in ''|*[!0-9]*) w=999 ;; esac
    if [ "$w" -le 6 ] && [ "$(smi clocks.gr)" -le 400 ]; then SETTLED=$w; break; fi
    sleep 0.3
done
BLEED_MS=$(( ($(date +%s%N) - T1) / 1000000 ))
echo "  $(smi pstate), $(smi utilization.gpu)% util, $(smi power.draw) W, $(smi clocks.gr) MHz (fully settled)"
echo
echo "=== verdict ==="
[ "$SAW_BUSY" = 1 ] \
    && echo "  WAKE:  yes -- the card left its idle P-state under load" \
    || echo "  WAKE:  NO -- it never left $IDLE_PSTATE; demand did not reach it"
[ -n "$BACK" ] \
    && echo "  IDLE:  yes -- back to $BACK in ${SETTLE_MS} ms" \
    || echo "  IDLE:  NO -- still not at an idle P-state after 20 s"
echo "  PEAK:  ${PEAK_UTIL}% util, ${PEAK_W} W, ${PEAK_CLK} MHz, ${PEAK_TEMP} C"
echo "  IDLE:  ${IDLE_PSTATE} at ${IDLE_W} W before, $(smi power.draw | cut -d. -f1) W after"
[ -n "$SETTLED" ] \
    && echo "  BLEED: wattage settled to ${SETTLED} W in ${BLEED_MS} ms after the P-state flipped" \
    || echo "  BLEED: wattage had NOT settled within 15 s of the P-state flip"
echo
echo "  Note: the enforced power limit here is $(nvidia-smi --query-gpu=enforced.power.limit --format=csv,noheader -i 0),"
echo "  so these numbers show the power TRANSITION, not the card's ceiling."